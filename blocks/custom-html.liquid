<div class="block-content block-custom-html" data-ui-component="Block Custom HTML" {{ block.shopify_attributes }}>
  {{- block.settings.html_code -}}
</div>
{%- schema -%} 
  {
    "name": "t:sections.custom_html_section.name",
    "tag": null,
    "settings": [
      {
        "type": "html",
        "id": "html_code",
