      "id": "desktop_aspect_ratio",
      "label": "t:general.settings.image_ratio.label",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "t:general.settings.image_ratio.options.option_original.label"
        },
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.mobile_layout.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:general.settings.image.label"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "t:general.settings.image_ratio.label",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "t:general.settings.image_ratio.options.option_original.label"
        },
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.image",
      "category": "t:general.media"
    }
  ]
}
{% endschema %}