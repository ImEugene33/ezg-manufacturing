{%- if block.settings.text != blank -%}
  <div class="text-block__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
{%- endif -%}

{% stylesheet %}
  .text-block__text {
    margin: 0;
    color: #2d2926;
    font-family: "Helvetica Neue";
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0.32px;
  }
  .text-block__text p {
    margin: 0;
  }
  .text-block__text p + p {
    margin-top: 8px;
  }
  .text-block__text a {
    color: inherit;
    text-decoration: underline;
  }
  @media screen and (min-width: 768px) {
    .text-block__text {
      font-size: 18px;
      line-height: 22px;
      letter-spacing: 0.36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:general.text",
      "default": "<p>Add your text here.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.text",
      "category": "t:general.typography"
    }
  ]
}
{% endschema %}
