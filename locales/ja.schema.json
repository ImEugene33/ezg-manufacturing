	  "header_1": {
	   "paragraph_1": "Thank you for choosing Normcore, we're excited to be part of your journey.",
	   "paragraph_2": "Let's get your store up in just a few simple steps."
	  },
	  "header_2": {
	   "paragraph_1": "• Upload your logo: Sections > Header > Logo > Upload your brand logo.",
	   "paragraph_2": "• Choose a preset: Theme Settings > Theme style.",
	   "paragraph_3": "• Set colors & fonts: Theme Settings > Color schemes & Typography.",
	   "paragraph_4": "• Spacing: Theme Settings > Store design."
	  },
	  "header_3": {
	   "paragraph_1": "Normcore offers 5 presets that tailored to different niches and styles.",
	   "paragraph_2": "If you prefer to customize, feel free to mix and match our Banners (image or video), Collection browsing, Content collage, Custom section with theme blocks and more, to craft a homepage that truly reflects your brand."
	  },
	  "header_4": {
	   "paragraph_1": "• Product Pages: various media gallery layouts, zoom media, content blocks, performance graphs and recently viewed products.",
	   "paragraph_2": "• Collection Pages: choose grid styles, filter options, and product comparision.",
	   "paragraph_3": "• Cart & Checkout: enable dynamic Checkout button or Cart drawer for a seamless experience."
	  },
	  "header_5": {
	   "paragraph_1": "• Flexible header & menu",
