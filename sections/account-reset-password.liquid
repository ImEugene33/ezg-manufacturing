{{ 'account.css' | asset_url | stylesheet_tag }}

<div data-animate="regular-section" class="js-animate section account-reset-password background color-{{- section.settings.color_scheme }}">
	<div class="ctnr">
    <div class="d-flex fd-column middle-xs gap-scale-4xl">
      <div class="ta-center">
        {%- if section.settings.enable_h1_tag -%}
          <h1 class="promotional-heading h2">{{ 'customer.reset_password.title' | t }}</h1>
        {%- else -%}
          <span class="promotional-heading h2">{{ 'customer.reset_password.title' | t }}</span>
        {%- endif -%}
        <div class="fs-body-xl mt-scale-xl">{{ 'customer.reset_password.subtext' | t: email: '' }}</div>
      </div>
      {%- form 'reset_customer_password', class: 'form form__customer form--reset-password' -%}
        {%- if form.errors -%}
          <div class="d-flex top-xs start-xs mb-scale-2xl">
            {% render 'icon-infor', class: 'icon-fix-m icon color-error' %}
            <div class="ml-3xs flex-1 fs-body-s color-text-80">
              {% for error in form.errors %}
                <div>
                  {% if error == 'form' %}
                    {{ form.errors.messages[error] }}
                  {% else %}
                    {{ form.errors.translated_fields[error] | capitalize }} {{ form.errors.messages[error] }}
                  {% endif %} 
                </div>
              {% endfor %}
            </div>
          </div>
        {%- endif -%}
        <div class="mb-scale-xl">
          <label for="password" class="field__label fs-body-m p-relative d-block">
            {{ 'customer.reset_password.password' | t }}<sup class="ml-4xs color-danger p-absolute top-0">*</sup>
          </label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password-error"
            {% endif %}
            placeholder="{{ 'customer.placeholder.password' | t }}"
            aria-required="true"
            required="required"
            class="field__text{% if form.errors contains 'password' %} field--error{% endif %} w-100"
          >
        </div>
        <div class="mb-scale-2xl">
          <label for="password_confirmation" class="field__label fs-body-m p-relative d-block">
            {{ 'customer.reset_password.password_confirm' | t }}<sup class="ml-4xs color-danger p-absolute top-0">*</sup>
          </label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            {% if form.errors contains 'password_confirmation' %}
              aria-invalid="true"
              aria-describedby="password_confirmation-error"
            {% endif %}
            placeholder="{{ 'customer.placeholder.password' | t }}"
            aria-required="true"
            required="required"
            class="field__text{% if form.errors contains 'password_confirmation' %} field--error{% endif %} w-100"
          >
        </div>
        <div class="d-flex fd-column-reverse fd-row-sm center-xs">
          <button class="btn btn-l btn-primary mb-xs w-100">
            {{ 'customer.reset_password.button' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
	</div>
</div>
{% schema %}
{
  "name": "t:sections.account_reset_password.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_h1_tag",
      "label": "t:general.settings.enable_h1_tag_for_heading.label",
      "info": "t:general.settings.enable_h1_tag_for_heading.info",
      "default": true
    }
  ]
}
{% endschema %}