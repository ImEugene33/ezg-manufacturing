<style>
    {%- if section.settings.remove_padding_top -%}
        #section-{{ section.id }} {
            padding-top: 0!important;
        }
    {%- endif -%}
    {%- if section.settings.remove_padding_bottom -%}
        #section-{{ section.id }} {
            padding-bottom: 0!important;
        }
    {%- endif -%}
    {%- if section.settings.enable_fullwidth -%}
        #section-{{ section.id }} {
            padding-inline: 0;
        }
    {%- endif -%}
</style>
<div id="section-{{ section.id }}" class="section  background color-{{- section.settings.color_scheme }}"  data-ui-component="Section Apps">
  <div class="{{ section.settings.enable_fullwidth | default: 'ctnr' | replace: 'true', '' }} w-100">
    {%- for block in section.blocks -%}
      {%- render block -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
  {
    "name": "t:sections.apps.name",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:general.settings.color_schemes.label",
        "default": "scheme-1"
      },
      {
        "type": "checkbox",
        "id": "enable_fullwidth",
        "label": "t:sections.apps.settings.enable_layout_fullwidth.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "remove_padding_top",
        "default": false,
        "label": "t:general.settings.remove_padding_top.label"
      },
      {
        "type": "checkbox",
        "id": "remove_padding_bottom",
        "default": false,
        "label": "t:general.settings.remove_padding_bottom.label"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "t:sections.apps.name"
      }
    ]
  }
{% endschema %}
