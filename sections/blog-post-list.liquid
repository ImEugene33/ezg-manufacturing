{%- liquid
  assign md = 12.0 | divided_by: section.settings.columns_per_row_desktop

  assign items_per_row_on_desktop = section.settings.columns_per_row_desktop | plus: 0

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item = 'js-carousel-item p-relative scrollable-aln-start'

  assign data_step_desktop = items_per_row_on_desktop

  assign data_step_mobile = 1
  if settings.carousel_slide == 'single_item'
    assign data_step_desktop = 1
  endif
  assign items_to_show = section.settings.items_to_show
  assign button_label = section.settings.button_text | default: 'View all'
  assign button_link = section.settings.blog.url
  assign enabel_button = section.settings.enable_button
  assign button_position = section.settings.button_position
  if button_position == 'last-item'
    assign hidden_button = 'd-none-important'
  endif

  assign index = 1
  assign index_accessibility = 1
  assign total_articles = blogs[section.settings.blog].articles.size
  assign total_items = total_articles | plus: 0
  if total_articles > items_to_show
    assign total_items = items_to_show
  endif
  if button_position == 'last-item'
    assign total_items = total_items | plus: 1
  endif
-%}
{%- if section.blocks.size > 0 or section.settings.heading != blank or section.settings.description != blank or section.settings.enable_button == true or section.settings.show_featured_image == true -%}
  {%- render 'section-padding-collapse' -%}
  <div data-animate="regular-section" class="js-animate section section--vertical o-hidden color-{{- section.settings.color_scheme }} background" data-ui-component="Section Blog Post List">
    {%- if section.settings.heading != blank or section.settings.description != blank or section.settings.enable_button == true -%}
      <div class="section__header">
        <div class="ctnr">
          {% render 'section-content-horizontal',
            class: 'section__text--horizontal p-relative zi-1',
            heading_size: section.settings.heading_size,
            button_main_text: button_label,
            button_main_link: button_link,
            button_main_style: 'btn-s btn-tertiary',
            enable_button: enabel_button,
            hidden_button: hidden_button,
            enable_countdown: false
          %}
        </div>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 or section.settings.show_featured_image == true -%}
      <div class="section__content">
        <div class="blog-post-content ctnr">
          <sht-carousel class="sht-carousel p-relative d-block" data-enable="{{ section.settings.carousel_desktop }}" data-enable-mobile="{{ section.settings.carousel_mobile }}">
            <div aria-atomic="true" class="rw section-content-style o-hidden r-gap-scale-xl {{ carousel_style }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel-md' }}" style="--carousel-xs: 12; --carousel-sm: 6;--carousel-md: {{- md -}};">
              {% for article in blogs[section.settings.blog].articles limit: items_to_show %}
                <sht-carousel-itm class="carousel__item clm {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}"
                style="--w-xs:12;--w-sm:6; --w-md: {{- md -}};"
                role="group"
                aria-roledescription="Slide"
                aria-label="{{ 'accessibility.slide' | t }} {{ index_accessibility }} {{ 'accessibility.of' | t }} {{ total_items }}"
                data-item-index="{{ index_accessibility }}">
                  {% render 'card-article-block',
                    article: article,
                    blog: section.settings.blog,
                    show_image: section.settings.show_featured_image,
                    image_ratio: section.settings.image_ratio,
                    %}
                </sht-carousel-itm>
                  {% liquid
                    assign index = index | plus: 1
                    assign index_accessibility = index_accessibility | plus: 1
                  %}
                {% else %}
                  {%- liquid
                    assign total_items = 3
                    if button_position == 'last-item'
                      assign total_items = 4
                    endif
                  -%}
                  {% for i in (1..3) %}
                    <sht-carousel-itm data-attribute-placeholder="1" aria-hidden="true" aria-disabled="true"
                    class="clm carousel__item {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}"
                    style="--w-xs:12; --w-sm:6; --w-md: {{- md -}};"
                    role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ total_items }}" data-item-index="{{ forloop.index }}">
                      {% render 'card-article-block-placeholder',
                        placeholder_index: forloop.index,
                        show_image: section.settings.show_featured_image,
                        image_ratio: section.settings.image_ratio
                    %}
                    </sht-carousel-itm>
                  {% endfor %}
              {%- endfor %}
              {% if button_position == 'last-item' and enabel_button == true %}
                {%- liquid
                  assign total_items = blogs[section.settings.blog].articles.size | plus: 1
                  if blogs[section.settings.blog].articles.size > items_to_show
                    assign total_items = items_to_show | plus: 1
                  endif

                  if blogs[section.settings.blog].articles == blank
                    assign total_items = 4
                    assign index_accessibility = 4
                  endif
                -%}
                <sht-carousel-itm class="carousel__item clm {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }} d-flex middle-xs center-xs"
                style="--w-xs:12; --w-sm:6; --w-md: {{- md -}};" role="group" aria-roledescription="Slide"
                aria-label="{{ 'accessibility.slide' | t }} {{ index_accessibility }} {{ 'accessibility.of' | t }} {{ total_items }}" data-item-index="{{ index_accessibility }}">
                  <div class="card card-collection card-animate card--border w-100 p-relative d-flex fd-column h-100 p-s rad-m o-hidden">
                    <a href="{{- section.settings.blog.url -}}" class="btn gap-3xs btn-s w-100 h-100 btn-tertiary hide-empty {% if section.settings.blog == blank %}disable{% endif %}">
                      {{- button_label -}}
                      {% render 'icon-caret-right', size: 16, class: 'rtl-flip-x' %}
                    </a>
                  </div>
                </sht-carousel-itm>
              {% endif %}

            </div>
            <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3">
              <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-caret-left' %}</button>
              <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-caret-right' %}</button>
            </div>

            <div class="carousel-overflow {{ section.settings.carousel_mobile | replace: 'true', '' | replace: 'false', 'd-none' }} {{ section.settings.carousel_desktop | replace: 'true', 'd-block-md' | replace: 'false', 'd-none-md' }}"></div>

            {% if settings.show_progress_indicator %}
              {% liquid
                assign show_on_desktop = false
                assign show_on_mobile = false
                if section.settings.carousel_desktop == 'true' and items_per_row_on_desktop < total_items
                    assign show_on_desktop = true
                endif
                if section.settings.carousel_mobile == 'true'
                    assign show_on_mobile = true
                endif
              %}
              <div class="slider-scrollbar p-2xl {% if show_on_desktop %} d-flex-md {% else %} d-none-md {% endif %} {% if show_on_mobile %} d-flex {% else %} d-none {% endif %}">
                <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-tablet="2" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                  <div class="scrollbar-thumb js-scrollbar-thumb"></div>
                </div>
              </div>
            {% endif %}
        </sht-carousel>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.blog_post_list.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_post_list.settings.blog.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.section_heading.label",
      "default": "Blog post list"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        {
          "value": "h3-regular",
          "label": "t:general.settings.heading_size.options.extra_large.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.large.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.regular.label"
        },
        {
          "value": "h6",
          "label": "t:general.settings.heading_size.options.small.label"
        }
      ],
      "default": "h5"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.section_description.label"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "t:general.settings.maximum_items_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.blog_post_item.content"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "t:general.settings.show_featured_image.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:general.settings.image_ratio.label",
      "visible_if": "{{ section.settings.show_featured_image == true }}",
      "options": [
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "value": "auto",
          "label": "t:general.settings.image_ratio.options.option_original.label"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.desktop_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_desktop",
      "label": "t:general.settings.list_style.label",
      "default": "true",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_per_row_desktop",
      "label": "t:general.settings.columns_per_row.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:general.settings.columns_per_row.options_3.label"
        },
        {
          "value": "4",
          "label": "t:general.settings.columns_per_row.options_4.label"
        },
        {
          "value": "5",
          "label": "t:general.settings.columns_per_row.options_5.label"
        },
        {
          "value": "6",
          "label": "t:general.settings.columns_per_row.options_6.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.mobile_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_mobile",
      "label": "t:general.settings.list_style.label",
      "default": "true",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.button.content"
    },
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "t:general.settings.enable_view_all_button.label",
      "info": "t:sections.blog_post.settings.link_to_blog_page.info",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:general.settings.label.label",
      "default": "View all",
      "visible_if": "{{ section.settings.enable_button == true }}"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "t:general.settings.position.label",
      "default": "above-listing",
      "visible_if": "{{ section.settings.enable_button == true }}",
      "options": [
        {
          "value": "last-item",
          "label": "t:general.settings.last_item.label"
        },
        {
          "value": "above-listing",
          "label": "t:general.settings.above_listing.label"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tags",
      "name": "t:sections.blog_post_list.blocks.tags.name",
      "limit": 1,
      "settings": [
      ]
    },
    {
      "type": "title",
      "name": "t:sections.blog_post_list.blocks.title.name",
      "limit": 1,
      "settings": [
      ]
    },
    {
      "type": "additional_information",
      "name": "t:sections.blog_post_list.blocks.additional_information.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "info_to_show",
          "label": "t:general.settings.info_to_show.name",
          "options": [
            {
              "value": "author_name",
              "label": "t:general.settings.info_to_show.options.option_author_name.label"
            },
            {
              "value": "published_date",
              "label": "t:general.settings.info_to_show.options.option_published_date.label"
            },
            {
              "value": "both",
              "label": "t:general.settings.info_to_show.options.option_both.label"
            }
          ],
          "default": "published_date"
        }
      ]
    },
    {
      "type": "excerpt",
      "name": "t:sections.blog_post_list.blocks.excerpt.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.blog_post.settings.change_excerpts.content"
        },
        {
          "type": "checkbox",
          "id": "truncate_text",
          "label": "t:general.settings.truncate_text.label",
          "info": "t:general.settings.truncate_text.info",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_post_list.name",
      "blocks": [
				{
					"type":"tags"
				},
        {
					"type":"title"
				},
        {
					"type":"additional_information"
				},
        {
					"type":"excerpt"
				}
			]
    }
  ]
}
{% endschema %}