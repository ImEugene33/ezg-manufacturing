{{ 'section-capability-columns.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    background-color: var(--color-background);
    color: var(--color-normal-text);
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .capability-columns__grid {
    --capability-columns-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="section-{{ section.id }} capability-columns color-{{ section.settings.color_scheme }} {{ section.settings.sect_class }}{% if section.settings.stretch_cards %} capability-columns--stretch-cards{% endif %}">
  <div class="capability-columns__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="capability-columns__heading h3">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="capability-columns__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

<script>
  function equalizeCapabilityCards() {
    const grids = document.querySelectorAll('.capability-columns--stretch-cards');
    grids.forEach(grid => {
      const cards = grid.querySelectorAll('.capability-item');
      let max = 0;
      cards.forEach(c => {
        c.style.minHeight = '0';
        c.style.height = 'auto';
      });
      cards.forEach(c => {
        if (c.offsetHeight > max) max = c.offsetHeight;
      });
      cards.forEach(c => {
        c.style.minHeight = max + 'px';
      });
    });
  }
  window.addEventListener('load', equalizeCapabilityCards);
  window.addEventListener('resize', equalizeCapabilityCards);
  document.addEventListener('shopify:section:load', equalizeCapabilityCards);
</script>

{% schema %}
