{%- liquid
  assign now =  "now" | date: "%N"
  assign section_id = section.id | md5 | truncate: 12, ""
  assign tab_label_placeholder = 'general.collection.label' | t
  assign tab_aria_controls_prefix = "products-tabs-tabs-" | append: section_id | append: now
  assign tab_id = "products-tabs-tab-" | append: section_id | append: now
  assign xs = 12.0 | divided_by: section.settings.columns_per_row_mobile
  assign md = 12.0 | divided_by: section.settings.columns_per_row_desktop
  assign tab_label_placeholder = 'general.collection.label' | t

  assign items_per_row_on_desktop = section.settings.columns_per_row_desktop | plus: 0
  assign items_per_row_on_mobile = section.settings.columns_per_row_mobile | plus: 0

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item = 'js-carousel-item p-relative scrollable-aln-start'

  assign data_step_desktop = items_per_row_on_desktop
  assign data_step_mobile = items_per_row_on_mobile

  if settings.carousel_slide == 'single_item'
    assign data_step_desktop = 1
    assign data_step_mobile = 1
  endif

  assign limit_products = section.settings.max_items
  if section.settings.max_items == 0
    assign limit_products = collection.products.size
  endif
-%}
{%- if section.blocks.size > 0 or section.settings.heading != blank or section.settings.description != blank -%}
  {%- render 'section-padding-collapse' -%}
  <div data-animate="regular-section" class="js-animate section section--vertical o-hidden color-{{- section.settings.color_scheme }} background" data-ui-component="Section Collection Browsing">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section__header">
        <div class="ctnr">
          {% render 'section-content-horizontal',
            section: section,
            class: 'section__text--horizontal p-relative zi-1',
            heading_size: section.settings.heading_size
          %}
        </div>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="section__content">
        <div class="ctnr">
          <sht-tabs class="d-block">
            {% if section.blocks.size > 1 %}
              <sht-tab-overflow class="p-relative tab__wrapper--underline" data-tab-style="{{ settings.tab_style }}">
                <ul class="js-tab-container tab__header--{{- settings.tab_style }} p-relative ox-auto disable-scrollbars ls-none ws-nowrap d-flex mb-scale-2xl f-extra" role="tablist">
                  {% for block in section.blocks limit: section.blocks.size %}
                    <li class="tab__item d-inline-block" {{ block.shopify_attributes }} role="presentation">
                      <a class="tab__link fs-body-xl d-block p-relative ele-focus-visible  {% if forloop.first %}tab__link--active{% endif %} js-tab-link" role="tab" id="{{ tab_id }}-{{ block.id }}" href="#{{ tab_aria_controls_prefix }}-{{ block.id }}" aria-controls="{{ tab_aria_controls_prefix }}-{{ block.id }}">
                      {{ block.settings.collection_heading | default: block.settings.selected_collection.title | default: tab_label_placeholder }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
                <div class="js-tab-overflow tab-overflow p-absolute inset pe-none"></div>
              </sht-tab-overflow>
            {% endif %}
            <div class="tab__content js-tab-content">
              {% for block in section.blocks limit: section.blocks.size %}
                {%- liquid
                  assign collection = collections[block.settings.selected_collection]
                  assign products = collection.products
                -%}
                <div class="tab__panel {% if forloop.first %} tab__panel--active {% endif %} {{ block.type }} js-tab-panel {{ tab_aria_controls_prefix }}-{{ block.id }} js-animate" id="{{ tab_aria_controls_prefix }}-{{ block.id }}" data-tab-content-id="{{ tab_aria_controls_prefix }}-{{ block.id }}" aria-labelledby="{{ tab_id }}-{{ block.id }}" role="tabpanel" {{ block.shopify_attributes }}>
                  <sht-carousel class="sht-carousel p-relative d-block" data-enable="{{ section.settings.carousel_desktop }}" data-enable-mobile="{{ section.settings.carousel_mobile }}">
                    <div aria-atomic="true" class="rw o-hidden section-content-style r-gap-scale-xl {{ carousel_style }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel-md' }}" style="--carousel-xs:{{- xs -}}; --carousel-sm:{{- xs -}}; --carousel-md: {{- md -}};">
                      {%- assign index_accessibility = 1 -%}
                      {% for product in products limit: limit_products %}
                        {% liquid
                          if limit_products <= products.size
                            assign total_items = limit_products | plus: 0
                          else
                            assign total_items = products.size | plus: 0
                          endif
                        %}
                        <sht-carousel-itm class="carousel__item clm {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}" style="--w-xs:{{- xs -}};--w-md: {{- md -}};" role="group" aria-roledescription="slide" aria-label="{{ 'accessibility.slide' | t }} {{ index_accessibility }} {{ 'accessibility.of' | t }} {{ total_items }}" data-item-index="{{ index_accessibility }}">
                          {% render 'mini-card-product',
                            product: product,
                            show_vendor: section.settings.show_vendor,
                            show_quick_view: section.settings.enable_quick_view,
                            show_variant_swatches: section.settings.show_variant_swatches,
                            show_price: section.settings.show_price,
                            show_badge: section.settings.show_badge,
                            quick_buy: section.settings.quick_buy,
                            show_rating: section.settings.show_rating
                          %}
                        </sht-carousel-itm>
                        {%- assign index_accessibility = index_accessibility | plus: 1 -%}
                      {% else %}
                        {% liquid
                          assign limit_products = section.settings.max_items
                          if section.settings.max_items == 0
                            assign limit_products = 4
                          endif
                        %}
                        {% for i in (1..4) limit: limit_products %}
                          {% assign total_items = 4 %}
                          <sht-carousel-itm data-attribute-placeholder="1" aria-hidden="true" aria-disabled="true"
                          class="clm carousel__item {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}" style="--w-xs:{{- xs -}};--w-md: {{- md -}};"
                          role="group" aria-roledescription="slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ total_items }}" data-item-index="{{ forloop.index }}">
                            {% render 'mini-card-product-placeholder',
                              product: product,
                              show_quick_view: section.settings.enable_quick_view,
                              product_placeholder: forloop.index
                              show_vendor: true,
                              show_price: true
                            %}
                          </sht-carousel-itm>
                        {% endfor %}
                      {% endfor %}
                    </div>
                    <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3">
                      <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-caret-left' %}</button>
                      <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-caret-right' %}</button>
                    </div>

                    <div class="carousel-overflow {{ section.settings.carousel_mobile | replace: 'true', '' | replace: 'false', 'd-none' }} {{ section.settings.carousel_desktop | replace: 'true', 'd-block-md' | replace: 'false', 'd-none-md' }}"></div>

                    {% if settings.show_progress_indicator %}
                      {% liquid
                        assign show_on_desktop = false
                        assign show_on_mobile = false
                        if section.settings.carousel_desktop == 'true' and items_per_row_on_desktop < total_items
                            assign show_on_desktop = true
                        endif
                        if section.settings.carousel_mobile == 'true' and items_per_row_on_mobile < total_items
                            assign show_on_mobile = true
                        endif
                      %}
                      <div class="slider-scrollbar p-2xl {% if show_on_desktop %} d-flex-md {% else %} d-none-md {% endif %} {% if show_on_mobile %} d-flex {% else %} d-none {% endif %}">
                        <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="{{ items_per_row_on_mobile }}" data-thumb-tablet="{{ items_per_row_on_mobile }}" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                          <div class="scrollbar-thumb js-scrollbar-thumb"></div>
                        </div>
                      </div>
                    {% endif %}
                  </sht-carousel>
                </div>
              {%- endfor -%}
            </div>
          </sht-tabs>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_browsing.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.section_heading.label",
      "default": "Collection browsing"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        {
          "value": "h3-regular",
          "label": "t:general.settings.heading_size.options.extra_large.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.large.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.regular.label"
        },
        {
          "value": "h6",
          "label": "t:general.settings.heading_size.options.small.label"
        }
      ],
      "default": "h5"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.section_description.label",
      "default": "<p>Show featured products in popular collections</p>"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "t:general.settings.option_maximum_item.label",
      "info": "t:general.settings.option_maximum_item.info",
      "min": 0,
      "step": 2,
      "max": 24,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:general.settings.product_card.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:general.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:general.settings.show_rating.label",
      "info": "t:general.settings.show_rating.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "t:general.settings.show_quick_view.label",
      "info": "t:general.settings.show_quick_view.info",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_buy",
      "label": "t:general.settings.quick_buy.label",
      "info": "t:general.settings.quick_buy.info",
      "options": [
        {
          "value": "not_use",
          "label": "t:general.settings.not_use.label"
        },
        {
          "value": "standard",
          "label": "t:general.settings.standard.label"
        },
        {
          "value": "bulk",
          "label": "t:general.settings.bulk.label"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "show_variant_swatches",
      "label": "t:general.settings.show_variant_swatch.label",
      "info": "t:general.settings.show_variant_swatch.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:general.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:general.settings.show_badge.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.desktop_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_desktop",
      "label": "t:general.settings.list_style.label",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_per_row_desktop",
      "label": "t:general.settings.columns_per_row.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:general.settings.columns_per_row.options_3.label"
        },
        {
          "value": "4",
          "label": "t:general.settings.columns_per_row.options_4.label"
        },
        {
          "value": "5",
          "label": "t:general.settings.columns_per_row.options_5.label"
        },
        {
          "value": "6",
          "label": "t:general.settings.columns_per_row.options_6.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.mobile_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_mobile",
      "label": "t:general.settings.list_style.label",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_per_row_mobile",
      "label": "t:general.settings.columns_per_row.label",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_browsing.blocks.collection.name",
      "settings": [
        {
          "type": "text",
          "id": "collection_heading",
          "label": "t:general.settings.collection_heading.label",
          "info": "t:general.settings.collection_heading.info",
          "default": "Highlighted collection"
        },
        {
          "type": "collection",
          "id": "selected_collection",
          "label": "t:general.settings.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_browsing.name",
      "blocks": [
				{
					"type":"collection"
				},
        {
					"type":"collection"
				},
        {
					"type":"collection"
				},
        {
					"type":"collection"
				}
			]
    }
  ]
}
{% endschema %}
