{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign section_image = section.settings.section_image
  assign default_button_send_message = 'templates.contact.form.send' | t
-%}
<div class="color-{{ section.settings.color_scheme }} section-contact section-contact--{{ section.id }} {{ section.settings.desktop_content_ordering }} {{ section.settings.mobile_content_ordering }}" id="{{ section.id }}" style="margin-bottom: 50px;">
  <div class="ctnr" style="--section-image-radius: {{ section.settings.section_image_radius }}px;">
    <div class="d-flex center-xs s-content rw align-stretch {{ section.settings.desktop_content_ordering }} {{ section.settings.mobile_content_ordering }}">
      <div class="clm" style="--w-xs:12; width: 100%; max-width: 800px; margin: 0 auto;">
        <div class="contact-form-content w-100">
          <div class="s-header {{ section.settings.content_alignment_desktop }} {{ section.settings.mobile_content_alignment }}" style="margin-bottom: 50px;">
            {%- if section.settings.heading_text != blank -%}
              <h2 class="section__heading {{ section.settings.heading_size }} m-zero">{{ section.settings.heading_text | escape }}</h2>
            {%- endif -%}
          </div>
          <div class="contact-form p-relative">
            {%- form 'contact', id: form_id, class: 'form-contact contact-form-wrapper' -%}
              {%- if form.posted_successfully? -%}
                <div style="background-color: #e6f9e6; color: #006600; padding: 20px; border-radius: 8px; margin-bottom: 24px; text-align: center; font-weight: bold; width: 100%; border: 1px solid #006600;">
                  Thank you! Your message has been sent successfully.
                </div>
              {%- elsif form.errors -%}
                <div style="background-color: #fbecec; color: #cc0000; padding: 20px; border-radius: 8px; margin-bottom: 24px; text-align: center; font-weight: bold; width: 100%; border: 1px solid #cc0000;">
                  Please check the errors below.
                  <br>
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </div>
              {%- endif -%}
            <div class="rw gap-equal">
              {%- assign has_email_field = false -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign custom_width = '--w-xs:12;--w-md:6;'
                  if block.settings.width == '100'
                    assign custom_width = '--w-xs:12;--w-md:12;'
                  endif
                -%}
                
                {%- case block.type -%}
                  {%- when 'heading' -%}
                    <div class="clm field mb-scale-xl" style="--w-xs:12;" {{ block.shopify_attributes }}>
                      <{{ block.settings.size }} class="m-zero pt-24" style="border-bottom: 1px solid rgba(var(--color-text), 0.1); padding-bottom: 8px;">
                        {{ block.settings.text | escape }}
                      </{{ block.settings.size }}>
                    </div>
                    
                  {%- when 'text_field' -%}
                    <div class="clm field mb-scale-xl" style="{{ custom_width }}" {{ block.shopify_attributes }}>
                      <label class="field__label fs-body-m d-block p-relative" for="{{ form_id }}-{{ forloop.index }}">
                        {{- block.settings.label | escape -}}
                        {%- if block.settings.required -%}
                          <sup class="p-absolute ml-4xs color-danger">*</sup>
                        {%- endif -%}
                      </label>
                      {%- liquid
                        assign field_name = block.settings.internal_name | default: block.settings.label | escape
                        if block.settings.field_type == 'email' and has_email_field == false
                          assign field_name = 'email'
                          assign has_email_field = true
                        endif
                      -%}
                      {%- if block.settings.use_as_textarea -%}
                        <textarea
                          rows="5"
                          id="{{ form_id }}-{{ forloop.index }}"
                          class="textarea field__text field--focus field--hover fs-body-m w-100"
                          name="contact[{{ field_name }}]"
                          placeholder="{{ block.settings.placeholder }}"
                          {% if block.settings.required %}required{% endif %}
                          ></textarea>
                      {%- else -%}
                        <input
                          class="field__text field--focus field--hover fs-body-m w-100"
                          type="{{ block.settings.field_type }}"
                          id="{{ form_id }}-{{ forloop.index }}"
                          name="contact[{{ field_name }}]"
                          placeholder="{{ block.settings.placeholder }}"
                          {% if block.settings.required %}required{% endif %}
                        >
                      {%- endif -%}
                    </div>
                    
                  {%- when 'dropdown' -%}
                    <div class="clm field mb-scale-xl" style="{{ custom_width }}" {{ block.shopify_attributes }}>
                      <label class="field__label fs-body-m d-block p-relative" for="{{ form_id }}-{{ forloop.index }}">
                        {{- block.settings.label | escape -}}
                        {%- if block.settings.required -%}
                          <sup class="p-absolute ml-4xs color-danger">*</sup>
                        {%- endif -%}
                      </label>
                      {%- assign options = block.settings.options | split: ',' -%}
                      <div class="field__select p-relative p-zero d-block">
                        <sht-select class="custom-select fs-body-m d-block" aria-label="{{- block.settings.label | escape -}}">
                          <span class="toggle__icon d-flex middle-xs center-xs select__icon">
                            {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-m icon p-absolute', class_first: 'toggle__icon--plus icon-fix-m icon p-absolute', class_second: 'toggle__icon--minus icon-fix-m icon p-absolute' %}
                          </span>
                          <select class="js-variant-select-item" name="contact[{{ block.settings.internal_name | default: block.settings.label | escape }}]" id="{{ form_id }}-{{ forloop.index }}" {% if block.settings.required %}required{% endif %}>
                            <option value="" disabled selected>-- Select --</option>
                            {%- for value in options -%}
                              <option value="{{- value | strip -}}">{{- value | strip -}}</option>
                            {%- endfor -%}
                          </select>
                        </sht-select>
                      </div>
                    </div>
                    
                  {%- when 'checkbox' -%}
                    <div class="clm field mb-scale-xl" style="{{ custom_width }}" {{ block.shopify_attributes }}>
                      <div class="d-flex middle-xs mt-12">
                        <input
                          type="hidden"
                          name="contact[{{ block.settings.internal_name | default: block.settings.label | escape }}]"
                          value="No"
                        >
                        <input
                          type="checkbox"
                          id="{{ form_id }}-{{ forloop.index }}"
                          name="contact[{{ block.settings.internal_name | default: block.settings.label | escape }}]"
                          value="Yes"
                          style="margin-right: 8px; transform: scale(1.2);"
                          {% if block.settings.required %}required{% endif %}
                        >
                        <label class="fs-body-m mb-zero" for="{{ form_id }}-{{ forloop.index }}">
                          {{- block.settings.label | escape -}}
                          {%- if block.settings.required -%}
                            <sup class="p-absolute ml-4xs color-danger">*</sup>
                          {%- endif -%}
                        </label>
                      </div>
                    </div>
                    
                  {%- when 'radio' -%}
                    <div class="clm field mb-scale-xl" style="{{ custom_width }}" {{ block.shopify_attributes }}>
                      <label class="field__label fs-body-m d-block p-relative mb-8" style="margin-bottom: 8px;">
                        {{- block.settings.label | escape -}}
                        {%- if block.settings.required -%}
                          <sup class="p-absolute ml-4xs color-danger">*</sup>
                        {%- endif -%}
                      </label>
                      {%- assign options = block.settings.options | split: ',' -%}
                      <div class="d-flex fd-row gap-16" style="gap: 16px;">
                        {%- for value in options -%}
                          <div class="d-flex middle-xs">
                            <input
                              type="radio"
                              id="{{ form_id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                              name="contact[{{ block.settings.internal_name | default: block.settings.label | escape }}]"
                              value="{{ value | strip }}"
                              style="margin-right: 8px;"
                              {% if block.settings.required and forloop.first %}required{% endif %}
                            >
                            <label class="fs-body-m mb-zero" for="{{ form_id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                              {{- value | strip -}}
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>

                {%- endcase -%}
              {%- endfor -%}

              <div class="clm field d-flex fd-column fd-row-sm center-xs mt-24" style="--w-xs:12; margin-top: 24px;">
                <button type="submit" class="btn btn-primary btn-l ta-center w-100 w-md-auto">
                  {{- section.settings.button_label | escape | default: default_button_send_message -}}
                </button>
              </div>
            </div>
          {%- endform -%}
        </div>
      </div>
      </div>
      {%- if section.settings.section_image != blank -%}
        <div class="contact-form-image rad-m o-hidden">
          {%- render 'image', image_item: section_image, image_wrap_classes: 'image-animate', image_classes: 'mah-90v m-auto rad-m o-hidden', ratio: section.settings.section_image.aspect_ratio -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('{{ form_id }}');
    if (!form) return;
    
    // Find all checkboxes in the form
    const checkboxes = form.querySelectorAll('input[type="checkbox"]');
    let triggerCheckbox = null;
    
    checkboxes.forEach(cb => {
      const label = cb.nextElementSibling;
      if (label && label.textContent.includes('Same as Product Owner')) {
        triggerCheckbox = cb;
      }
    });

    if (triggerCheckbox) {
      triggerCheckbox.addEventListener('change', function() {
        if (this.checked) {
          const allFields = form.querySelectorAll('.field');
          
          let isTargetSection = false;
          let sourceFields = {};
          let targetFields = [];
          
          allFields.forEach(field => {
            if (field.contains(triggerCheckbox)) {
              isTargetSection = true;
              return;
            }
            
            const labelEl = field.querySelector('label');
            const inputEl = field.querySelector('input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]), select, textarea');
            
            if (labelEl && inputEl) {
              const labelText = labelEl.textContent.replace('*', '').trim();
              
              if (!isTargetSection) {
                sourceFields[labelText] = inputEl.value;
              } else {
                // Only map fields up to the next heading or checkbox if needed, 
                // but since we collect all after, it will just map any matching label after it
                targetFields.push({
                  input: inputEl,
                  label: labelText
                });
              }
            }
          });
          
          // Apply values
          targetFields.forEach(target => {
            if (sourceFields[target.label] !== undefined) {
              target.input.value = sourceFields[target.label];
              
              // If it's a select inside sht-select, we might need to update the visible text
              if (target.input.tagName.toLowerCase() === 'select') {
                const customSelect = target.input.closest('sht-select');
                if (customSelect) {
                  const visibleText = customSelect.querySelector('.js-variant-select-item-text, .toggle__text, span:not(.toggle__icon)');
                  if (visibleText) {
                    visibleText.textContent = target.input.options[target.input.selectedIndex].text;
                  }
                }
              }
              target.input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }
      });
    }
  });
</script>
