{%- liquid
  assign total_items = section.blocks.size
  assign items_per_row_on_desktop = 12 | divided_by: total_items
  assign items_per_row_on_tablet = 2
  assign items_per_row_on_mobile = 1

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item = 'js-carousel-item p-relative scrollable-aln-start'
-%}
{%- if section.blocks.size > 0 -%}
  {%- render 'section-padding-collapse' -%}
  <div data-animate="regular-section" class="js-animate section section--vertical o-hidden color-{{ section.settings.color_scheme }} background" data-ui-component="Section Cross Page Promotion" role="region" aria-labelledby="cross-promo-heading-{{ section.id }}">
    <div class="section__content">
      <div class="ctnr">
        <sht-carousel class="sht-carousel p-relative d-block" aria-label="{{ 'accessibility.slide' | t }}">
          <div aria-atomic="true" class="section-content-style rw o-hidden r-gap-scale-xl {{ carousel_style }} carousel--special" style="--carousel-xs:12;">
            {% for block in section.blocks %}
              <sht-carousel-itm class="clm carousel__item d-flex {{ carousel_item }} {% if total_items < 4 %}maw-md-100{% endif %}" style="--w-xs: 12; --w-sm: 6;--w-md: 3;" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
                {% render 'card-icon-with-text',
                  card_border: true,
                  text_position: section.settings.text_position,
                  theme_library_icon: block.settings.theme_library_icon,
                  icon_color: section.settings.icon_color,
                  icon_source: block.settings.icon_source,
                  icon_image: block.settings.icon_image,
                  custom_code: block.settings.custom_code,
                  icon_size: section.settings.icon_size,
                  title: block.settings.title,
                  description: block.settings.description,
                  link: block.settings.link,
                  label: block.settings.label
                %}
              </sht-carousel-itm>
            {% endfor %}
          </div>
          <div class="carousel-overflow d-none-md"></div>
          {% if settings.show_progress_indicator %}
            <div class="slider-scrollbar p-2xl d-none-md {% if items_per_row_on_tablet < total_items %} d-flex-sm {% else %} d-none-sm {% endif %} {% if items_per_row_on_mobile < total_items %} d-flex {% else %} d-none {% endif %} {{ total_items | replace: 1, 'd-none' }}">
              <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-tablet="2" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                <div class="scrollbar-thumb js-scrollbar-thumb"></div>
              </div>
            </div>
          {% endif %}
        </sht-carousel>
      </div>
    </div>
  </div>
{%- endif -%}

