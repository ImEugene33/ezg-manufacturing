{{ 'section-cta-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign text = section.settings.text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_style = section.settings.button_style | default: 'secondary'
-%}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} cta {{ section.settings.sect_class }}">
  <div class="cta__container">
    <div class="cta__copy">
      {%- if heading != blank -%}
        {%- if heading_tag == 'h3' -%}
          <h3 class="cta__heading cta__heading--h3">{{ heading }}</h3>
        {%- else -%}
          <h2 class="cta__heading h2">{{ heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if text != blank -%}
        <div class="cta__text">{{ text }}</div>
      {%- endif -%}
    </div>
    {%- if button_label != blank -%}
      {%- if button_link != blank -%}
        <a href="{{ button_link }}" class="cta__btn btn btn--{{ button_style }}">{{ button_label }}</a>
      {%- else -%}
        <a class="cta__btn btn btn--disabled btn--{{ button_style }}" aria-disabled="true">{{ button_label }}</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.cta_section.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.content.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.heading.label",
      "default": "Let’s Build Something Great Together"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.cta_section.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:general.settings.heading_size.options.h2.label" },
        { "value": "h3", "label": "t:general.settings.heading_size.options.h3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:general.settings.text.label",
      "default": "<p>Versatile and multipurpose, the cutting-edge media-promotion sections easily handle images, slideshows, and videos, allowing you to enhance your online store with diverse content forms.</p>"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:general.settings.button_label.label",
      "default": "Contact Our Team"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:general.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:general.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:general.settings.primary.label" },
        { "value": "secondary", "label": "t:general.settings.secondary.label" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "t:sections.cta_section.settings.headers.padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.cta_section.settings.padding_top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.cta_section.settings.padding_bottom.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.cta_section.settings.padding_top_mob.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.cta_section.settings.padding_bottom_mob.label",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.cta_section.settings.headers.background.content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.cta_section.settings.bg_color.label",
      "default": "#4b687a"
    },
    {
      "type": "text",
      "id": "sect_class",
      "label": "t:sections.cta_section.settings.sect_class.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.cta_section.name"
    }
  ]
}
{% endschema %}
