{{ 'section-custom-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    {% if section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} custom-content {{ section.settings.sect_class }}">
  <div class="custom-content__container custom-content__container--{{ section.settings.content_align }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom_content.name",
  "blocks": [
    { "type": "title" },
    { "type": "text" },
    { "type": "image" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.layout.content"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:general.settings.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:general.left" },
        { "value": "center", "label": "t:general.center" },
        { "value": "right", "label": "t:general.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.custom_content.settings.headers.padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_content.settings.padding_top.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_content.settings.padding_bottom.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_content.settings.padding_top_mob.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_content.settings.padding_bottom_mob.label",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.custom_content.settings.headers.background.content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.custom_content.settings.bg_color.label"
    },
    {
      "type": "text",
      "id": "sect_class",
      "label": "t:sections.custom_content.settings.sect_class.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_content.name",
      "blocks": [
        { "type": "title" },
        { "type": "text" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
