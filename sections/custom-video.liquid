{{ 'section-custom-video.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign text = section.settings.text
  assign video = section.settings.video
  assign poster = section.settings.poster
  assign video_alt = video.alt | default: heading | default: 'Video'

  assign poster_image = poster | default: video.preview_image
  if poster_image != blank
    assign poster_url = poster_image | image_url: width: 1920
  endif
  assign video_sources = video.sources | where: 'format', 'mp4' | sort: 'width' | reverse
-%}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    background-color: {{ section.settings.bg_color | default: '#191919' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} custom-video {{ section.settings.sect_class }}">
  <div class="custom-video__container">
    <div class="custom-video__header">
      {%- if heading != blank -%}
        {%- if heading_tag == 'h3' -%}
          <h3 class="custom-video__heading custom-video__heading--h3">{{ heading }}</h3>
        {%- else -%}
          <h2 class="custom-video__heading h2">{{ heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if text != blank -%}
        <div class="custom-video__text">{{ text }}</div>
      {%- endif -%}
    </div>

    <div class="custom-video__media">
      {%- if video != blank -%}
        <div class="custom-video__player" data-custom-video>
          <video
            class="custom-video__video"
            {%- if poster_url != blank %} poster="{{ poster_url }}"{% endif %}
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="{{ video_alt }}"
          >
            {%- for source in video_sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>

          <div class="custom-video__controls">
            <button type="button" class="custom-video__control" data-custom-video-play aria-label="Play video">
              {%- render 'icon-pause', class: 'custom-video__control-icon custom-video__control-icon--pause' -%}
              {%- render 'icon-play', class: 'custom-video__control-icon custom-video__control-icon--play' -%}
            </button>
            <button type="button" class="custom-video__control" data-custom-video-mute aria-label="Unmute video">
              {%- render 'icon-sound-off', class: 'custom-video__control-icon custom-video__control-icon--sound-off' -%}
              {%- render 'icon-sound-high', class: 'custom-video__control-icon custom-video__control-icon--sound-on' -%}
            </button>
          </div>
        </div>
      {%- elsif poster_url != blank -%}
        {{ poster_image | image_url: width: 1920 | image_tag:
          widths: '375, 550, 750, 1000, 1200, 1600, 1920',
          sizes: '(min-width: 1024px) 1344px, 100vw',
          alt: video_alt,
          loading: 'lazy',
          class: 'custom-video__placeholder'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-video__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const players = document.querySelectorAll('[data-custom-video]');

    players.forEach(function (player) {
      const video = player.querySelector('video');
      const playBtn = player.querySelector('[data-custom-video-play]');
      const muteBtn = player.querySelector('[data-custom-video-mute]');

      if (!video) return;

      video.addEventListener('play', function () {
        player.classList.add('is-playing');
        if (playBtn) playBtn.setAttribute('aria-label', 'Pause video');
      });

      video.addEventListener('pause', function () {
        player.classList.remove('is-playing');
        if (playBtn) playBtn.setAttribute('aria-label', 'Play video');
      });

      if (playBtn) {
        playBtn.addEventListener('click', function () {
          if (video.paused) {
            video.play();
          } else {
            video.pause();
          }
        });
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', function () {
          video.muted = !video.muted;
          player.classList.toggle('is-unmuted', !video.muted);
          muteBtn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
        });
      }

      player.addEventListener('click', function (event) {
        if (event.target.closest('.custom-video__controls')) return;
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.custom_video.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.content.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.heading.label",
      "default": "Our Commitment To You"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.custom_video.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:general.settings.heading_size.options.h2.label" },
        { "value": "h3", "label": "t:general.settings.heading_size.options.h3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:general.settings.text.label",
      "default": "<p>EZG’s commitment to you is this: we dedicate our time and energy to your project as if the final product would be used in our own facility. We listen to your questions and concerns and solve your problem with creativity, precision, and integrity. We put the needs of our customers first because we know that trust is the foundation of any good relationship.</p><p>As a manufacturer of our own line of construction equipment, we understand the importance of quality and reliability. For a business to be successful, we understand you need partners you can count on.</p>"
    },
    {
      "type": "header",
      "content": "t:general.settings.video.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:general.video"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:sections.custom_video.settings.poster.label",
      "info": "t:sections.custom_video.settings.poster.info"
    },
    {
      "type": "header",
      "content": "t:sections.custom_video.settings.headers.padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_video.settings.padding_top.label",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_video.settings.padding_bottom.label",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_video.settings.padding_top_mob.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_video.settings.padding_bottom_mob.label",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.custom_video.settings.headers.background.content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.custom_video.settings.bg_color.label",
      "default": "#191919"
    },
    {
      "type": "text",
      "id": "sect_class",
      "label": "t:sections.custom_video.settings.sect_class.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_video.name"
    }
  ]
}
{% endschema %}
