{%- liquid
  assign section_id = section.id | md5 | truncate: 12, ''
  assign form_id = section_id | prepend: 'cf-'
  assign default_button_send_message = "general.button.send_message" | t
-%}
{%- if section.blocks.size > 0 -%}
{%- render 'section-padding-collapse' -%}
<div data-animate="regular-section" class="js-animate section section-vertical background color-{{- section.settings.color_scheme }}" data-ui-component="Section Extensive Descriptions">
  <div class="ctnr extensive-descriptions">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="product__info product__block-{{- block.type }} mb-xl" {{ block.shopify_attributes }}>
              {% render 'product-description', product: product, block: block %}
            </div>
          {%- endif -%}
        {%- when 'collapsible_item' -%}
          <div class="product__info product__block-{{- block.type }} mb-xl" {{ block.shopify_attributes }}>
            <sht-accordion class="accordion d-flex fd-column">
              <div class="accordion__item js-accordion-item rad-m border">
                <button class="region-trigger accordion__header-large accordion__button ele-focus-visible w-100 js-accordion-trigger d-flex middle-xs p-relative c-pointer rad-m {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ block.settings.expand_collapsible }}" aria-controls="collapsible-content-{{- block.id -}}">
                  {%- liquid
                    if block.settings.enable_icon
                      render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.custom_icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
                    endif
                  -%}
                  <span class="fs-heading-s m-zero flex-1 ta-left">
                    {{- block.settings.heading | default: 'Information' | escape -}}
                  </span>
                  <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                    {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
                  </span>
                </button>
                <div class="fs-body-m accordion__content-large o-hidden rte js-accordion-content accordion-content {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1" style="max-height: {{ block.settings.expand_collapsible | replace: true, 'auto' | replace: false, '0' }};">
                  {{- block.settings.text -}}
                  {%- if block.settings.content_from_page != blank -%}
                    {{- block.settings.content_from_page.content -}}
                 {%- endif -%}
                </div>
              </div>
            </sht-accordion>
          </div>
        {%- when 'performance_graphs' -%}
          {%- liquid
            assign graph_popup_id = block.id | append: section.id | md5 | truncate: 12, ""
            assign graph_list = block.settings.graphs_metafield
            assign graph_namespace = graph_list | split: '.' | first
            assign graph_key = graph_list | split: '.' | last
            assign graph_values = product.metafields[graph_namespace][graph_key].value
            assign margin_graph = ''
            if block.settings.use_list_of_graphs and graph_values.count < 1
              assign margin_graph = 'mb-0'
            endif
          -%}
          {%- unless block.settings.use_list_of_graphs == true and product.metafields[graph_namespace][graph_key] == blank or graph_values.count < 1 -%}
            <div class="product__info product__block-{{- block.type }} mb-xl {{ margin_graph }}" {{ block.shopify_attributes }}>
              {% if block.settings.show_as_collapsible %}
                <sht-accordion class="accordion d-flex fd-column">
                  <div class="accordion__item js-accordion-item rad-m border">
                    <button class="region-trigger accordion__header-large accordion__button ele-focus-visible w-100 p-zero js-accordion-trigger d-flex middle-xs p-relative c-pointer {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ block.settings.expand_collapsible }}" aria-controls="collapsible-content-{{- block.id -}}">
                      {%- liquid
                        if block.settings.enable_icon
                          render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.custom_icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
                        endif
                      -%}
                      <span class="fs-body-m m-zero flex-1 ta-left">
                        <span class="fs-heading-s component-heading">{{- block.settings.heading | escape -}}</span>
                      </span>
                      <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                        {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
                      </span>
                    </button>
                    <div class="accordion__content-large o-hidden js-accordion-content accordion-content {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1" style="max-height: {{ block.settings.expand_collapsible | replace: true, 'auto' | replace: false, '0' }};">
                      {%- render 'performance-graph-block', block: block, graph_popup_id: graph_popup_id, graph_values: graph_values -%}
                    </div>
                  </div>
                </sht-accordion>
              {% else %}
                <span class="fs-heading-s component-heading pt-m pb-m d-block hide-empty">{{- block.settings.heading | escape -}}</span>
                {%- render 'performance-graph-block', block: block, graph_popup_id: graph_popup_id, graph_values: graph_values -%}
              {% endif %}
            </div>
          {%- endunless -%}
        {%- when 'contact_form' -%}
          {% assign value_default = "general.contact_form.label" | t %}
          {%- capture contact_form_layout -%}
            <div class="rw center-xs">
              <div class="clm m-zero-md" style="--w-xs:12;">
                {%- form 'contact', id: form_id, class: 'form-contact' -%}
                  {%- if form.posted_successfully? or form.errors -%}
                    <sht-noti class="js-popover-noti ml-m noti-message message--success d-flex middle-xs between-xs gap-xs p-s maw-fit-content-sm rad-m color-{{ settings.popover_notification_color }} background">
                      <div class="d-flex middle-xs gap-xs fs-body-m">
                        <div class="icon-success p-relative">
                          <svg class="h-100 w-100">
                            <circle cx="12" cy="12" r="11"></circle>
                            <circle cx="12" cy="12" r="11" class="progress"></circle>
                          </svg>
                          {%- if form.posted_successfully? -%}
                            <div class="p-absolute d-flex middle-xs center-xs inset">
                              {% render 'icon-check' | class: 'icon icon-fix-m'  %}
                            </div>
                          {%- elsif form.errors -%}
                            <div class="p-absolute d-flex middle-xs center-xs inset">
                              {% render 'icon-x-mark' | class: 'icon icon-fix-m' %}
                            </div>
                          {%- endif -%}
                        </div>
                        {%- if form.posted_successfully? -%}
                          <span class="flex-1">{{ 'general.contact_form.success' | t }}</span>
                        {%- elsif form.errors -%}
                          <span class="flex-1">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                        {%- endif -%}
                        <div class="btn btn-icon-m js-icon-cancel">
                          {% render 'icon-x-mark' | class: 'icon icon-fix-m' %}
                        </div>
                      </div>
                    </sht-noti>
                  {%- endif -%}
                  <div class="rw gap-equal">
                    <div class="clm field mb-scale-xl" style="--w-xs:12;--w-md:6">
                      <label class="d-block field__label fs-body-m" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
                      <input
                      class="field__text field--focus field--hover fs-body-m w-100"
                      autocomplete="name"
                      type="text"
                      id="{{ form_id }}-name"
                      name="contact[Name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      placeholder="{{ 'templates.contact.form.name_placeholder' | t }}"
                      >
                    </div>
                    <div class="clm field mb-scale-xl" style="--w-xs:12;--w-md:6">
                      <label class="field__label fs-body-m d-block p-relative" for="{{ form_id }}-email">{{ 'templates.contact.form.email' | t }}<sup class="p-absolute ml-4xs color-danger">*</sup></label>
                      <input
                      autocomplete="email"
                      type="email"
                      id="{{ form_id }}-email"
                      class="field__text field--focus field--hover fs-body-m w-100"
                      name="contact[email]"
                      spellcheck="false"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      aria-required="true"
                      pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                      placeholder="{{ 'templates.contact.form.email_placeholder' | t }}"
                      required
                      >
                    </div>
                    <div class="clm field mb-scale-2xl" style="--w-xs:12;">
                      <label class="field__label fs-body-m p-relative d-block" for="{{ form_id }}-message">{{ 'templates.contact.form.message' | t }}<sup class="p-absolute ml-4xs color-danger">*</sup></label>
                      <textarea
                        rows="5"
                        id="{{ form_id }}-message"
                        required
                        class="textarea field__text field--focus field--hover fs-body-m w-100"
                        name="contact[{{ 'templates.contact.form.message_title' | t }}]"
                        placeholder="{{ 'templates.contact.form.message_placeholder' | t }}"
                      >
                        {{- form.body -}}
                      </textarea>
                    </div>
                    <div class="clm field d-flex fd-column fd-row-sm" style="--w-xs:12;">
                      <button type="submit" class="btn btn-primary btn-l ta-center w-100 w-md-auto">
                        {{- block.settings.button_label | default: default_button_send_message -}}
                      </button>
                    </div>
                  </div>
                {%- endform -%}
              </div>
            </div>
          {%- endcapture -%}
          <div class="product__info product__block-{{- block.type }} mb-xl" {{ block.shopify_attributes }}>
            {% if block.settings.show_as_collapsible %}
              <sht-accordion class="accordion d-flex fd-column">
                <div class="accordion__item js-accordion-item rad-m border">
                  <button class="region-trigger accordion__header-large accordion__button ele-focus-visible w-100 p-zero js-accordion-trigger d-flex middle-xs p-relative c-pointer {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ block.settings.expand_collapsible }}" aria-controls="collapsible-content-{{- block.id -}}">
                    {%- liquid
                      if block.settings.enable_icon
                        render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.custom_icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
                      endif
                    -%}
                    <span class="fs-body-m m-zero flex-1 ta-left">
                      <span class="fs-heading-s component-heading">{{- block.settings.heading | escape | default: value_default -}}</span>
                    </span>
                    <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                      {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
                    </span>
                  </button>
                  <div class="accordion__content-large o-hidden js-accordion-content accordion-content {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1" style="max-height: {{ block.settings.expand_collapsible | replace: true, 'auto' | replace: false, '0' }};">
                    {{ contact_form_layout }}
                  </div>
                </div>
              </sht-accordion>
            {% else %}
              <span class="fs-heading-s component-heading pt-m pb-m d-block hide-empty">{{- block.settings.heading | escape | default: value_default -}}</span>
              {{ contact_form_layout }}
            {% endif %}
          </div>
        {%- when 'divider' -%}
          {% liquid
            assign bgc_color = 'background: var(--color-normal-text);'
            unless block.settings.divider_color.alpha == 0.0 or block.settings.divider_color == blank
              assign bgc_color = 'background: ' | append: block.settings.divider_color
            endunless
          %}
          <div class="product__info product__divider product__block-{{- block.type }} mb-xl" {{ block.shopify_attributes }} style="{{ bgc_color }}">
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{%- render 'main-product-graph-dialog', section: section -%}

{% schema %}
{
  "name": "t:sections.extensive_descriptions.name",
