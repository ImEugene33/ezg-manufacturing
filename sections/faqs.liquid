{%- liquid 
  assign section_id = section.id | md5 | truncate: 12, ''
  assign form_id = section_id | prepend: 'cf-'
  assign alignment_class = section.settings.heading_alignment_desktop | append: ' ' | append: section.settings.heading_alignment_mobile
  assign color_form_background = section.settings.color_custom_form_background
  assign color_form_content = section.settings.color_custom_form_content
  assign default_item_heading = "section.map.heading_info" | t
  assign default_button_send_message = "general.button.send_message" | t
  unless color_form_background.alpha == 0.0 or color_form_background == blank
    assign color_form_background = 'background: ' | append: color_form_background | append: '; --color-background-rgb: ' | append: color_form_background.red | append: ', ' | append: color_form_background.green | append: ', ' | append: color_form_background.blue
  endunless
  unless color_form_content.alpha == 0.0 or color_form_content == blank
    assign color_form_content = 'color: ' | append: color_form_content | append: '; --color-normal-text-rgb: ' | append: color_form_content.red | append: ', ' | append: color_form_content.green | append: ', ' | append: color_form_content.blue
  endunless
-%}
{%- if section.blocks.size > 0 or section.settings.heading_text != blank or section.settings.description_text != blank or section.settings.enable_contact_form != false -%}
  {%- render 'section-padding-collapse' -%}
  <div data-animate="regular-section" class="js-animate section faqs o-hidden background color-{{- section.settings.color_scheme }}" data-ui-component="Section FAQs" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
    <div class="ctnr">
      {%- if section.settings.heading_text != blank or section.settings.description_text != blank%}
        <div class="section__text d-flex fd-column {{ alignment_class }}">
          {%- if section.settings.heading_text != blank%}
            <h2 class="section__heading faqs__heading promotional-heading {{ section.settings.heading_size }} hide-empty">{{- section.settings.heading_text | escape -}}</h2>
          {% endif -%}
          {%- if section.settings.description_text != blank %}
            <div class="section__description faqs__desc fs-body-xl rte hide-empty o-hidden w-100">{{- section.settings.description_text -}}</div>
          {% endif -%}
        </div>
      {% endif -%}
      <div class="faqs__content gap-scale-2xl center-xs mt-scale-4xl d-flex {{ section.settings.content_ordering }} {{ section.settings.content_ordering_mobile }} fd-column">
        {% if section.blocks.size > 0 %}
          <div class="faqs__information">
            <sht-accordion class="accordion d-flex fd-column" data-properties='{"multiple": {{ section.settings.one_item_expand }} }'>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign aria_expanded = 'false'
                  assign ac_open_css = ''
                  assign styles = 'max-height: 0;'
  
                  if section.settings.open_first_item and forloop.first
                    assign aria_expanded = 'true'
                    assign ac_open_css = 'open'
                    assign styles = ''
                  endif
                -%}
                <div class="accordion__item js-accordion-item rad-m border mb-scale-xl" {{ block.shopify_attributes }}>
                  <button class="region-trigger accordion__header-large accordion__button ele-focus-visible w-100 js-accordion-trigger d-flex middle-xs p-relative c-pointer rad-m {{ ac_open_css }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ aria_expanded }}" aria-controls="collapsible-content-{{- block.id -}}">
                    {%- liquid
                      if block.settings.show_icon
                        render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
                      endif
                    -%}
                    <span class="fs-heading-s component-heading m-zero flex-1 ta-left">
                      {{- block.settings.heading_faq_item | default: default_item_heading | escape -}}
                    </span>
                    <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                      {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
                    </span>
                  </button>
                  <div class="fs-body-m accordion__content-large o-hidden rte js-accordion-content accordion-content {{ ac_open_css }}" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1"  style="{{ styles }}">
                    {{- block.settings.description_faq_item-}}
                  </div> 
                </div>
              {%- endfor -%}
            </sht-accordion>
          </div>
        {% endif %}
        
        {% if section.settings.enable_contact_form %} 
          <div class="faqs__form">
            <div class="p-m border rad-l" style="{{ color_form_background }}; {{ color_form_content }}">
              {%- if section.settings.heading_contact_form != blank -%}
                <h3 class="regular-heading hide-empty m-zero h4">{{- section.settings.heading_contact_form | escape -}}</h3>
              {%- endif -%}
              {%- if section.settings.description_contact_form != blank -%}
                <div class="section__description fs-body-xl rte hide-empty o-hidden">{{- section.settings.description_contact_form -}}</div>
              {%- endif -%}
              <div class="rw center-xs mt-scale-2xl">
                <div class="clm m-zero-md js-animate" style="--w-xs:12; --duration: .6s; --delay: .3s;">
                  {%- form 'contact', id: form_id, class: 'form-contact' -%}
                    {%- if form.posted_successfully? or form.errors -%}
                      <sht-noti class="js-popover-noti ml-m noti-message message--success d-flex middle-xs between-xs gap-xs p-s maw-fit-content-sm rad-m color-{{ settings.popover_notification_color }} background">
                        <div class="d-flex middle-xs gap-xs fs-body-m">
                          <div class="icon-success p-relative">
                            <svg class="h-100 w-100">
                              <circle cx="12" cy="12" r="11"></circle>
                              <circle cx="12" cy="12" r="11" class="progress"></circle>
                            </svg>
                            {%- if form.posted_successfully? -%}
                              <div class="p-absolute d-flex middle-xs center-xs inset">
                                {% render 'icon-check' | class: 'icon icon-fix-m'  %}
                              </div>
                            {%- elsif form.errors -%}
                              <div class="p-absolute d-flex middle-xs center-xs inset">
                                {% render 'icon-x-mark' | class: 'icon icon-fix-m' %}
                              </div>
                            {%- endif -%}
                          </div>
                          {%- if form.posted_successfully? -%}
                            <span class="flex-1">{{ 'general.contact_form.success' | t }}</span>
                          {%- elsif form.errors -%}
                            <span class="flex-1">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                          {%- endif -%}
                          <div class="btn btn-icon-m js-icon-cancel">
                            {% render 'icon-x-mark' | class: 'icon icon-fix-m' %}
                          </div>
                        </div>
                      </sht-noti>
                    {%- endif -%}
                    <div class="rw gap-equal">
                      <div class="clm field mb-scale-xl" style="--w-xs:12;--w-md:6">
                        <label class="d-block field__label fs-body-m" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
                        <input 
                        class="field__text field--focus field--hover fs-body-m w-100" 
                        autocomplete="name" 
                        type="text" 
                        id="{{ form_id }}-name" 
                        name="contact[Name]"
                        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" 
                        placeholder="{{ 'templates.contact.form.name_placeholder' | t }}"
                        >
                      </div>
                      <div class="clm field mb-scale-xl" style="--w-xs:12;--w-md:6">
                        <label class="field__label fs-body-m d-block p-relative" for="{{ form_id }}-email">{{ 'templates.contact.form.email' | t }}<sup class="p-absolute ml-4xs color-danger">*</sup></label>
                        <input
                        autocomplete="email"
                        type="email"
                        id="{{ form_id }}-email"
                        class="field__text field--focus field--hover fs-body-m w-100"
                        name="contact[email]"
                        spellcheck="false"
                        autocapitalize="off" 
                        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                        aria-required="true"
                        pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                        placeholder="{{ 'templates.contact.form.email_placeholder' | t }}"
                        required
                        >
                      </div>
                      
                      <div class="clm field mb-scale-2xl" style="--w-xs:12;">
                        <label class="field__label fs-body-m p-relative d-block" for="{{ form_id }}-message">{{ 'templates.contact.form.message' | t }}<sup class="p-absolute ml-4xs color-danger">*</sup></label>
                        <textarea
                          rows="5"
                          id="{{ form_id }}-message"
                          required
                          class="textarea field__text field--focus field--hover fs-body-m w-100"
                          name="contact[{{ 'templates.contact.form.message_title' | t }}]"
                          placeholder="{{ 'templates.contact.form.message_placeholder' | t }}"
                        >
                          {{- form.body -}}
                        </textarea>
                      </div>
                      <div class="clm field d-flex fd-column fd-row-sm center-xs" style="--w-xs:12;">
                        <button type="submit" class="btn btn-primary btn-l ta-center w-100 w-md-auto">
                          {{- section.settings.button_label | default: default_button_send_message -}}
                        </button>
                      </div>
                    </div>
                  {%- endform -%}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div> 
{%- endif -%}
{% schema %}
	{
    "name": "t:sections.faqs.name",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "t:general.settings.headers.general.content"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:general.settings.color_schemes.label",
        "default": "scheme-1"
      },
      {
        "type": "text", 
        "id": "heading_text",
        "label": "t:general.settings.section_heading.label",
        "default": "Frequently asked questions"
      },
      {
        "type": "select",
        "label": "t:general.settings.heading_size.label",
        "id": "heading_size",
        "visible_if": "{{ section.settings.heading_text != blank }}",
        "options": [
          {
            "value": "headline",
            "label": "t:general.settings.heading_size.options.extra_large.label"
          },
          {
            "value": "h1",
            "label": "t:general.settings.heading_size.options.large.label"
          },
          {
            "value": "h2",
            "label": "t:general.settings.heading_size.options.regular.label"
          },
          {
            "value": "h3",
            "label": "t:general.settings.heading_size.options.small.label"
          }
        ],
        "default": "h2"
      },
      {
        "type": "richtext",
        "id": "description_text",
        "label": "t:general.settings.section_description.label",
        "default": "<p>Write some useful information about your business, contact information or links to various FAQ pages.</p>"
      },
      {
        "type": "header",
        "content": "t:sections.faqs.settings.headers.faq_item.content"
      },
      {
        "type": "checkbox",
        "id": "one_item_expand",
        "label": "t:sections.faqs.settings.one_item_expand.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "open_first_item",
        "label": "t:sections.faqs.settings.open_first_item.label",
        "default": true
      },
      {
        "type": "header",
        "content": "t:general.settings.contact_form.label"
      },
      {
        "type": "checkbox",
        "id": "enable_contact_form",
        "label": "t:sections.faqs.settings.enable_contact_form.label",
        "default": true
      },
      {
        "type": "text",
        "id": "heading_contact_form",
        "label": "t:general.settings.heading.label",
        "default": "Didn’t find your answer?",
        "visible_if": "{{ section.settings.enable_contact_form == true }}"
      },
      {
        "type": "richtext",
        "id": "description_contact_form",
        "label": "t:general.settings.description.label",
        "default": "<p>Link to some useful pages that your customers might want to know about.</p>",
        "visible_if": "{{ section.settings.enable_contact_form == true }}"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "t:general.settings.button_label.label",
        "default": "Send message",
        "visible_if": "{{ section.settings.enable_contact_form == true }}"
      },
      {
        "type": "color",
        "id": "color_custom_form_background",
        "label": "t:sections.faqs.settings.color_custom_form_background.label",
        "default": "rgba(0,0,0,0)",
        "visible_if": "{{ section.settings.enable_contact_form == true }}"
      },
      {
        "type": "color",
        "id": "color_custom_form_content",
        "label": "t:sections.faqs.settings.color_custom_form_content.label",
        "default": "rgba(0,0,0,0)",
        "visible_if": "{{ section.settings.enable_contact_form == true }}"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.desktop_layout.content"
      },
      {
        "type": "select",
        "id": "heading_alignment_desktop",
        "label": "t:general.settings.heading_alignment.label",
        "options": [
          {
            "value": "ta-left-md top-md",
            "label": "t:general.settings.option_left.label"
          },
          {
            "value": "ta-center-md middle-md",
            "label": "t:general.settings.option_center.label"
          },
          {
            "value": "ta-right-md bottom-md",
            "label": "t:general.settings.option_right.label"
          }
        ],
        "default": "ta-center-md middle-md"
      },
      {
        "type": "select",
        "id": "content_ordering",
        "label": "t:general.settings.content_ordering.label",
        "default": "fd-row-sm",
        "visible_if": "{{ section.settings.enable_contact_form == true }}",
