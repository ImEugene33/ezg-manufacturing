  "presets": [
    {
      "name": "t:sections.feature_cards.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Swift to Change",
            "text": "<p>Ensuring our technology, facility and team are performing at their very best is key when delivering to our customers. Remaining agile, allows us to meet customer expectations, no matter the circumstances.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Our Commitment to You",
            "text": "<p>As a manufacturer of our own products, we understand the importance of quality and reliability. For a business to be successful, they need partners that they can count on.</p>"
