{{ 'section-feature-cards.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    background-color: var(--color-background);
    color: var(--color-normal-text);
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .feature-cards__grid {
    --feature-cards-columns-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="section-{{ section.id }} feature-cards color-{{ section.settings.color_scheme }} {{ section.settings.sect_class }}">
  <div class="feature-cards__container">
    <div class="feature-cards__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            {%- liquid
              assign image = block.settings.image
              assign image_alt = image.alt | default: block.settings.image_alt
              assign aspect_ratio = image.aspect_ratio | default: 1.1
            -%}
            <div class="feature-cards__card feature-cards__card--image" {{ block.shopify_attributes }}>
              <div class="feature-cards__image" style="--feature-cards-aspect-ratio: {{ aspect_ratio }};">
                {%- if image != blank -%}
                  {{ image | image_url: width: 1000 | image_tag:
                    widths: '375, 550, 750, 1000',
                    sizes: '(min-width: 1024px) 33vw, 100vw',
                    alt: image_alt,
                    loading: 'lazy',
                    class: 'feature-cards__image-img'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-cards__image-img' }}
                {%- endif -%}
              </div>
            </div>

          {%- when 'feature' -%}
            <div class="feature-cards__card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="feature-cards__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="feature-cards__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="feature-cards__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feature_cards.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:sections.feature_cards.settings.columns_desktop.label",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.feature_cards.settings.headers.colors.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.feature_cards.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.feature_cards.settings.headers.padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_cards.settings.padding_top.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_cards.settings.padding_bottom.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_cards.settings.padding_top_mob.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.feature_cards.settings.padding_bottom_mob.label",
      "default": 32
    },
    {
      "type": "text",
      "id": "sect_class",
      "label": "t:sections.feature_cards.settings.sect_class.label"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:general.settings.image.name",
