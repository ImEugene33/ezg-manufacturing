{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{% liquid
  assign section_id = section.id | md5 | truncate: 12, ''
  assign current_year = 'now' | date: '%Y'
%}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
  }
  @media only screen and (min-width: 1196px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  {%- render 'section-padding-collapse' -%}
  <footer class="section-{{ section.id }} footer-section section section--vertical color-{{ section.settings.color_scheme }} background {{ section.settings.sect_class }}" data-ui-component="Section Footer">
    <div data-animate="regular-section" class="js-animate footer-section__container">
      <div class="footer-section__top">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="footer-section__logo">
            <img
              srcset="{{ section.settings.logo | image_url: width: 280 }} 1x, {{ section.settings.logo | image_url: width: 560 }} 2x"
              src="{{ section.settings.logo | image_url: width: 280 }}"
              loading="lazy"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
          </a>
        {%- endif -%}

        {%- if section.settings.certification_badge != blank -%}
          <div class="footer-section__badge">
            <img
              srcset="{{ section.settings.certification_badge | image_url: width: 138 }} 1x, {{ section.settings.certification_badge | image_url: width: 276 }} 2x"
              src="{{ section.settings.certification_badge | image_url: width: 138 }}"
              loading="lazy"
              width="{{ section.settings.certification_badge.width }}"
              height="{{ section.settings.certification_badge.height }}"
              alt="{{ section.settings.certification_badge.alt | escape }}"
            >
          </div>
        {%- endif -%}

        <div class="footer-section__nav">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'contact_info' -%}
                {%- if block.settings.heading != blank or block.settings.content != blank -%}
                  <div class="footer-section__col footer-section__col--contact" {{ block.shopify_attributes }}>
                    <sht-clps-rgn
                      class="footer-section__accordion"
                      data-properties='{"isCollapsibleOnDesktop":false, "isCollapsibleOnMobile":true, "isExpandOnMobile": false, "ariaDescribedby": "clsbeTgr-{{ section_id }}-{{ forloop.index }}", "ariaControls": "clsbeCtt-{{ section_id }}-{{ forloop.index }}"}'
                    >
                      <button id="clsbeTgr-{{ section_id }}-{{ forloop.index }}" class="footer-section__trigger m-zero js-collapsible-region-trigger" aria-controls="clsbeCtt-{{ section_id }}-{{ forloop.index }}" aria-expanded="false">
                        <span class="h6">{{- block.settings.heading -}}</span>
                        <span class="toggle__icon d-flex middle-xs center-xs">
                          {%- render 'icon-toggle', icon_arrow: 'icon', size: 12 -%}
                        </span>
                      </button>
                      <div id="clsbeCtt-{{ section_id }}-{{ forloop.index }}" class="region-content js-collapsible-region-content o-hidden" role="region" tabindex="-1" aria-describedby="clsbeTgr-{{ section_id }}-{{ forloop.index }}">
                        <div class="rte">{{ block.settings.content }}</div>
                      </div>
                    </sht-clps-rgn>
                  </div>
                {%- endif -%}
              {%- when 'menu' -%}
                {%- if block.settings.main_menu != blank or block.settings.heading != blank -%}
                  <div class="footer-section__col" {{ block.shopify_attributes }}>
                    <sht-clps-rgn
                      class="footer-section__accordion"
                      data-properties='{"isCollapsibleOnDesktop":false, "isCollapsibleOnMobile":true, "isExpandOnMobile": false, "ariaDescribedby": "clsbeTgr-{{ section_id }}-{{ forloop.index }}", "ariaControls": "clsbeCtt-{{ section_id }}-{{ forloop.index }}"}'
                    >
                      <button id="clsbeTgr-{{ section_id }}-{{ forloop.index }}" class="footer-section__trigger m-zero js-collapsible-region-trigger" aria-controls="clsbeCtt-{{ section_id }}-{{ forloop.index }}" aria-expanded="false">
                        <span class="h6">
                          {%- if block.settings.heading != blank -%}
                            {{- block.settings.heading -}}
                          {%- else -%}
                            {{- block.settings.main_menu.title -}}
                          {%- endif -%}
                        </span>
                        <span class="toggle__icon d-flex middle-xs center-xs">
                          {%- render 'icon-toggle', icon_arrow: 'icon', size: 12 -%}
                        </span>
                      </button>
                      <div id="clsbeCtt-{{ section_id }}-{{ forloop.index }}" class="region-content js-collapsible-region-content o-hidden" role="region" tabindex="-1" aria-describedby="clsbeTgr-{{ section_id }}-{{ forloop.index }}">
                        {%- if block.settings.main_menu -%}
                          <ul class="footer-section__list">
                            {%- for link in block.settings.main_menu.links -%}
                              <li>
                                <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} class="footer-section__link footer__menu-link d-flex middle-xs w-100{% if link.current %} footer__link--active{% endif %}">
                                  {{- link.title -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    </sht-clps-rgn>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="footer-section__bottom">
        {%- if shop.terms_of_service or shop.privacy_policy -%}
          <ul class="footer-section__legal">
            {%- if shop.terms_of_service -%}
              <li><a href="{{ shop.terms_of_service.url }}" class="footer-section__legal-link">{{ shop.terms_of_service.title }}</a></li>
            {%- endif -%}
            {%- if shop.privacy_policy -%}
              <li><a href="{{ shop.privacy_policy.url }}" class="footer-section__legal-link">{{ shop.privacy_policy.title }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_linkedin_link != blank or settings.social_youtube_link != blank -%}
          <ul class="footer-section__social" aria-label="social-media">
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ settings.social_facebook_link }}" rel="noopener" title="Facebook" aria-label="Facebook" class="footer-section__social-link">
                  {%- render 'icon-facebook2' -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ settings.social_instagram_link }}" rel="noopener" title="Instagram" aria-label="Instagram" class="footer-section__social-link">
                  {%- render 'icon-instagram2' -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li>
                <a href="{{ settings.social_twitter_link }}" rel="noopener" title="X-Twitter" aria-label="X-Twitter" class="footer-section__social-link">
                  {%- render 'icon-x' -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_linkedin_link != blank -%}
              <li>
                <a href="{{ settings.social_linkedin_link }}" rel="noopener" title="Linkedin" aria-label="Linkedin" class="footer-section__social-link">
                  {%- render 'icon-linkedin' -%}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a href="{{ settings.social_youtube_link }}" rel="noopener" title="Youtube" aria-label="Youtube" class="footer-section__social-link">
                  {%- render 'icon-youtube' -%}
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.logo_mark != blank -%}
          <img
            class="footer-section__mark"
            src="{{ section.settings.logo_mark | image_url: width: 80 }}"
            loading="lazy"
            width="{{ section.settings.logo_mark.width }}"
            height="{{ section.settings.logo_mark.height }}"
            alt=""
          >
        {%- endif -%}

        {%- if section.settings.copyright_text != blank -%}
          <div class="footer-section__copyright">{{- section.settings.copyright_text | replace: '[year]', current_year -}}</div>
        {%- endif -%}
      </div>
    </div>
  </footer>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-9e40671e-03fb-4794-866d-f94c8ca7b57d"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.headers.logo.content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:general.settings.logo.label"
    },
    {
      "type": "image_picker",
      "id": "logo_mark",
      "label": "t:sections.footer.settings.logo_mark.label",
      "info": "t:sections.footer.settings.logo_mark.info"
    },
    {
      "type": "image_picker",
      "id": "certification_badge",
      "label": "t:sections.footer.settings.certification_badge.label"
    },
    {
      "type": "header",
      "content": "t:sections.copyright_bar.settings.headers.copyright_bar.content"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "t:sections.copyright_bar.settings.copyright_content.label",
      "default": "<p>© [year]. All rights reserved.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.headers.padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_bottom.label",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_top_mob.label",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_bottom_mob.label",
      "default": 12
    },
    {
      "type": "text",
      "id": "sect_class",
      "label": "t:sections.footer.settings.sect_class.label"
    }
  ],
  "blocks": [
    {
      "type": "contact_info",
      "name": "t:sections.footer.blocks.contact_info.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.heading.label",
          "default": "Contact us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:general.settings.description.label",
          "default": "<p><strong>Address</strong><br>1833 North Riverview Road<br>Malta, OH 43758</p><p><strong>Email</strong><br><a href=\"mailto:sales@ezgmfg.com\">sales@ezgmfg.com</a></p><p><strong>Phone</strong><br><a href=\"tel:1-888-971-6301\">1-888-971-6301</a></p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.heading.label",
          "info": "t:sections.footer.settings.menu.info"
        },
        {
          "type": "link_list",
          "id": "main_menu",
          "default": "footer",
          "label": "t:general.settings.menu.label",
          "info": "t:general.settings.menu.info"
        }
      ]
    }
  ]
}
{% endschema %}
