{{ 'section-history-tab.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign heading_before = heading
  assign heading_accent = ''
  assign heading_after = ''

  assign heading_parts = heading | split: '('
  if heading_parts.size > 1
    assign heading_before = heading_parts[0]
    assign heading_remainder = heading | slice: heading_before.size, heading.size | remove_first: '('
    assign heading_remainder_parts = heading_remainder | split: ')'
    assign heading_accent = heading_remainder_parts[0]
    assign heading_after = heading_remainder | slice: heading_accent.size, heading_remainder.size | remove_first: ')'
  endif
-%}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mob }}px;
    padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    --history-tab-heading-accent-color: {{ section.settings.heading_accent_color }};
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} history-tab color-{{ section.settings.color_scheme }} {{ section.settings.sect_class }}" data-history-tab>
  <div class="history-tab__container">
    {%- if section.settings.eyebrow != blank or heading != blank -%}
      <div class="history-tab__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="history-tab__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="history-tab__heading">{{- heading_before -}}{%- if heading_accent != blank -%}<span class="history-tab__heading-accent">{{- heading_accent -}}</span>{%- endif -%}{{- heading_after -}}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="history-tab__tabs" role="tablist" aria-label="{{ heading | strip_html | default: 'History' }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="history-tab__tab{% if forloop.first %} history-tab__tab--active{% endif %}"
            id="history-tab-trigger-{{ block.id }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="history-tab-panel-{{ block.id }}"
            data-history-tab-trigger
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</button>
        {%- endfor -%}
      </div>

      <div class="history-tab__panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign image_alt = image.alt | default: block.settings.title | default: 'History'
            assign image_position = block.settings.image_position | default: 'left'
            assign image_px_width = settings.container_max_width | times: 0.595 | round
            assign sizes = '(min-width: 1024px) ' | append: image_px_width | append: 'px, 100vw'
          -%}
          <div
            class="history-tab__panel{% if forloop.first %} history-tab__panel--active{% endif %}{% if image_position == 'right' %} history-tab__panel--image-right{% endif %}"
            id="history-tab-panel-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="history-tab-trigger-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            data-history-tab-panel
            {{ block.shopify_attributes }}
          >
            <div class="history-tab__media">
              {%- if image != blank -%}
                {{ image | image_url: width: image.width | image_tag:
                  widths: '375, 550, 750, 1000, 1200, 1600',
                  sizes: sizes,
                  alt: image_alt,
                  loading: 'lazy',
                  class: 'history-tab__media-img'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'history-tab__media-img' }}
              {%- endif -%}
            </div>
            <div class="history-tab__content">
              {%- if block.settings.date_label != blank or block.settings.title != blank -%}
                <div class="history-tab__copy">
                  {%- if block.settings.date_label != blank -%}
                    <p class="history-tab__date">{{ block.settings.date_label }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p class="history-tab__title">{{ block.settings.title }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="history-tab__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    const roots = document.querySelectorAll('[data-history-tab]');

    roots.forEach(function (root) {
      const triggers = root.querySelectorAll('[data-history-tab-trigger]');
      const panels = root.querySelectorAll('[data-history-tab-panel]');

      triggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          if (trigger.classList.contains('history-tab__tab--active')) return;

          triggers.forEach(function (item) {
            item.classList.remove('history-tab__tab--active');
            item.setAttribute('aria-selected', 'false');
          });
          panels.forEach(function (panel) {
            panel.classList.remove('history-tab__panel--active');
            panel.setAttribute('hidden', '');
          });

          trigger.classList.add('history-tab__tab--active');
          trigger.setAttribute('aria-selected', 'true');

          const panel = root.querySelector('#' + trigger.getAttribute('aria-controls'));
          if (panel) {
            panel.classList.add('history-tab__panel--active');
            panel.removeAttribute('hidden');
          }

          trigger.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
      });
    });
  })();
</script>

