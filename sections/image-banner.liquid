{%- liquid
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  assign preload = false

  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
    assign preload = true
  endif

  assign desktop_content_alignment = section.settings.desktop_content_alignment
  assign mobile_content_alignment = section.settings.mobile_content_alignment
  assign desktop_content_position = section.settings.desktop_content_position
  assign mobile_content_position = section.settings.mobile_content_position

  assign sht_mask_mb = mobile_content_position | replace: '-xs', ''
  assign sht_mask_desk = desktop_content_position

  assign size = '100vw'
  if section.settings.section_image_width == 'max-width'
    assign size = '(min-width: 1024px) calc(' | append:  settings.container_max_width | append: 'px, 100vw'
  endif

  if sht_mask_desk == 'center-md'
    if desktop_content_alignment contains 'left'
      assign sht_mask_desk = 'center-left-md'
    elsif desktop_content_alignment contains 'right'
      assign sht_mask_desk = 'center-right-md'
    endif
  endif

  if sht_mask_mb == 'center'
    if mobile_content_alignment contains 'left'
      assign sht_mask_mb = 'center-left'
    elsif mobile_content_alignment contains 'right'
      assign sht_mask_mb = 'center-right'
    endif
  endif

  if section.settings.mobile_image
    assign mobile_image_alt  = section.settings.mobile_image.alt | default: section.settings.mobile_image.image | split: '/' | last
    assign mobile_image = section.settings.mobile_image | image_url: width: section.settings.mobile_image.width | image_tag: widths: '320, 450, 550, 750, 950, 1024, 1200', sizes: size, alt: mobile_image_alt, class: 'js-image-lazy-mobile d-none-md d-block w-100 h-100 of-cover p-absolute top-0', loading: loading, fetchpriority: fetchpriority, preload: preload
  endif

  assign desktop_image = 'hero-apparel-1' | placeholder_svg_tag: 'placeholder w-100 h-100 of-cover'
  assign desktop_image_alt = section.settings.desktop_image.alt | default: section.settings.desktop_image.image | split: '/' | last
  assign desktop_image = section.settings.desktop_image | image_url: width: section.settings.desktop_image.width | image_tag: widths: '320, 450, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000', sizes: size, alt: desktop_image_alt, class: 'js-image-lazy w-100 h-100 of-cover', loading: loading, fetchpriority: fetchpriority, preload: preload

  assign overlay_opacity = section.settings.section_overlay_opacity | divided_by: 100.0

  assign overlay_color = 'inherit'
  unless section.settings.section_mask_overlay_color.alpha == 0.0 or section.settings.section_mask_overlay_color == blank
    assign overlay_color = section.settings.section_mask_overlay_color | color_modify: 'alpha', overlay_opacity
  endunless
  unless section.settings.section_content_overlay_color.alpha == 0.0 or section.settings.section_content_overlay_color == blank
    assign content_color = 'color:' | append: section.settings.section_content_overlay_color
    assign content_color_sub = '--label-countdown:' | append: section.settings.section_content_overlay_color | color_modify: 'alpha', 0.6
  endunless

  assign min_height_mobile = section.settings.height_mobile
  assign min_height_desktop = section.settings.height_desktop

  if min_height_desktop == 'adapt_img'
    assign min_height_desktop = ''
    if section.settings.section_image_width == 'full-width'
      assign min_height_desktop = 100 | divided_by : section.settings.desktop_image.aspect_ratio | append: 'vw'
    elsif section.settings.section_image_width == 'stretch'
      assign min_height_desktop = 'calc((100vw - 2*var(--fix-m))/IMAGE_RATIO_DESK)' | replace: 'IMAGE_RATIO_DESK', section.settings.desktop_image.aspect_ratio
    else
      assign min_height_desktop = settings.container_max_width | divided_by: section.settings.desktop_image.aspect_ratio | append: 'px'
    endif
    if section.settings.desktop_image == blank
      assign min_height_desktop = '500px'
    endif
  endif

  if min_height_mobile == 'adapt_img'
    assign min_height_mobile = ''
    assign min_height_mobile = 100 | divided_by : section.settings.mobile_image.aspect_ratio | append: 'vw'
    if section.settings.mobile_image == blank
      assign min_height_mobile = 100 | divided_by : section.settings.desktop_image.aspect_ratio | append: 'vw'
    endif
    if section.settings.mobile_image == blank and section.settings.desktop_image == blank
      assign min_height_mobile = '500px'
    endif
  endif

  assign section_content_class = 'promotion-section-container zi-1 d-flex fd-column h-100 w-100 content--' | append: sht_mask_desk | append: ' content--' | append: sht_mask_mb | append: ' ' | append: section.settings.desktop_content_position | append: ' ' | append: section.settings.mobile_content_position | append: ' ' | append: desktop_content_alignment | append: ' ' | append: mobile_content_alignment
  assign section_content_style = '--mh-xs: MIN_HEIGHT_MOBILE ;--mh-md: MIN_HEIGHT_DESKTOP;' | replace: 'MIN_HEIGHT_MOBILE', min_height_mobile | replace: 'MIN_HEIGHT_DESKTOP', min_height_desktop | append: content_color
-%}

{%- unless section.settings.section_image_width == 'full-width' -%}
	{%- render 'section-padding-collapse' -%}
{%- endunless -%}

{%- if section.settings.enable_transparent_header -%}
  {%- render 'transparent-header-style' -%}
{%- endif -%}

<div data-animate="banner-section" id="section-{{ section.id }}" data-ui-component="Section Image Banner" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}"
class="section js-animate section-promotion--{{- section.settings.section_image_width }} promotion-section background color-{{- section.settings.color_scheme }}"
  {% if section.settings.enable_transparent_header %} enable-transparent-header {% endif %}
  style=" --color-mask: {{ overlay_color }}; --overlay: {{ overlay_opacity }}; {{ content_color }}"
>
  <div class="ctnr rad-l-md o-hidden section-promotion__wrapper p-relative sht-mask sht-mask--{{ sht_mask_desk }} sht-mask--{{ sht_mask_mb }}">
    <div class="promotion-section__background inset p-absolute banner-media__animate">
      {{ mobile_image }}
      {{ desktop_image }}
    </div>
    <div class="p-relative zi-1">
      {%- render 'section-content',
        class: section_content_class,
        button_position_md: desktop_content_alignment,
        button_position_mb: mobile_content_alignment,
        section_content_style: section_content_style,
        content_color_sub: content_color_sub
      -%}
    </div>
  </div>
</div>

{% schema %}
