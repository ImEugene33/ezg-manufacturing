{%- liquid
  assign image_loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign content_width = section.settings.desktop_media_width | replace: '8', '4' | prepend: '--w-xs: 12; --w-md: '
  assign media_width = section.settings.desktop_media_width | prepend: '--w-xs: 12; --w-md: '
  assign alignment_class = section.settings.desktop_content_alignment | append: ' ' | append: section.settings.mobile_content_alignment
  -%}
{%- render 'section-padding-collapse' -%}
<div data-animate="regular-section" class="js-animate section image-with-text o-hidden background color-{{- section.settings.color_scheme }}" {{ section.settings.color_scheme.settings.color_background }}
>
  <div class="ctnr">
    <div class="rw media-with-text__grid center-xs fd-row-md {{ section.settings.desktop_layout }} {{ section.settings.mobile_layout -}}">
      {%- if section.blocks.size > 0 -%}
        <div class="clm" style="{{ content_width }}">
            <div class="media-with-text__content">
              {%- render 'section-content-text-icon',
              alignment_class: alignment_class
              -%}
            </div>
        </div>
      {%- endif -%}
      {%- assign image_count = 0 -%}
      {%- capture image_list -%}
        <div class="media-with-text__column top-xs d-flex fd-column gap-3xs hide-empty w-100 o-hidden rad-s {{ section.settings.image_alignment | replace: 'on_scroll', 'p-sticky top-0' }}">
          {%- for i in (1..2) -%}
            {%- liquid
              assign image_key = 'image_' | append: i
              assign link_key = 'image_' | append: i | append: '_link' 
              assign image = section.settings[image_key]
              assign link = section.settings[link_key]
              assign image_name = image.src | split: '/' | last | split: '.' | first
              assign alt_text = image.alt | default: image_name
            -%}
          {%- if image != blank -%}
            {%- assign image_count = image_count | plus: 1 -%}
            <div class="image-with-text__image o-hidden w-100 p-relative mah-90v image-animate" style="aspect-ratio: {{ image.aspect_ratio }};">
                {%- if link != blank -%}
                  <a class="p-absolute inset ele-focus-visible" href="{{ link.url }}" aria-label="{{ alt_text }}"></a>
                {%- endif -%}
                {{- image | image_url: width: image.width | image_tag: alt: alt_text, widths: '320, 450, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000', sizes: '(min-width: 1025px) calc(100vw / 2), 100vw', class: 'w-100 h-100 rad-s of-cover', loading: image_loading, fetchpriority: fetchpriority -}}
            </div>
            {%- endif -%}
        {%- endfor -%}
        </div>
        <div class="media-with-text__column top-xs d-flex fd-column gap-3xs hide-empty w-100 o-hidden rad-s {{ section.settings.image_alignment | replace: 'on_scroll', 'p-sticky top-0' }}">
          {%- for i in (3..4) -%}
            {%- liquid
              assign image_key = 'image_' | append: i
              assign link_key = 'image_' | append: i | append: '_link'
              assign image = section.settings[image_key]
              assign link = section.settings[link_key]
              assign image_name = image.src | split: '/' | last | split: '.' | first
              assign alt_text = image.alt | default: image_name
            -%}
          {%- if image != blank -%}
            {%- assign image_count = image_count | plus: 1 -%}
            <div class="image-with-text__image o-hidden w-100 p-relative mah-90v image-animate" style="aspect-ratio: {{ image.aspect_ratio }};">
                {%- if link != blank -%}
                  <a class="p-absolute inset ele-focus-visible" href="{{ link.url }}" aria-label="{{ alt_text }}"></a>
                {%- endif -%}
                {{- image | image_url: width: image.width | image_tag: alt: alt_text, widths: '320, 450, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000', sizes: '(min-width: 1025px) calc(100vw / 2), 100vw', class: 'w-100 h-100 rad-s of-cover', loading: image_loading, fetchpriority: fetchpriority -}}
            </div>
            {%- endif -%}
        {%- endfor -%}
        </div>
      {%- endcapture -%}
      <div class="clm d-flex media-with-text__images gap-3xs {{ section.settings.image_alignment | replace: 'on_scroll', 'top-xs' }} media-with-text__images-{{- image_count -}}-item hide-empty" style="{{ media_width }}">
        {%- if image_count == 0 -%}
          <div class="o-hidden rad-s o-hidden w-100">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder w-100 d-block image-animate' }}
          </div>
        {%- else -%}
          {{- image_list -}}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
