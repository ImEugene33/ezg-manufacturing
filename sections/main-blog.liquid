{% liquid
  assign md = 12.0 | divided_by: section.settings.columns_per_row_desktop
%}
<div data-animate="regular-section" class="js-animate section section--vertical color-{{- section.settings.color_scheme }} background" data-ui-component="Main Blog" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}">
  <div class="section__header">
    {%- if settings.enable_breadcrumb_blogs -%}
      {%- render 'breadcrumb', page: page, routes: routes, class: 'mb-m' -%}
    {%- endif -%}
    <div class="ctnr p-relative zi-1 d-flex start-xs gap-3xs">
      <div class="section__text-text hide-empty">
        <{{ section.settings.enable_h1_tag | default: 'span' | replace: true, 'h1' }} class="regular-heading {{ section.settings.heading_size }}">
          {{- blog.title | escape -}}
        </{{ section.settings.enable_h1_tag | default: 'span' | replace: true, 'h1' }}>
      </div>
      <div class="section__text-icon hide-empty">
        <a class="btn btn-icon-m btn-icon btn-tertiary {{ section.settings.show_rss | default: 'd-none-important' | replace: 'true', '' }}" href="{{ shop.url }}{{ blog.url }}.atom" title="RSS">
          {% render 'icon-rss' %}
        </a>
      </div>
    </div>
  </div>
  <div class="section__content">
    <div class="ctnr">
      {%- paginate blog.articles by section.settings.items_per_load -%}
        <div class="section__content d-flex fd-column gap-2xl">
          <sht-tab-overflow class="p-relative tab__wrapper--underline {{ section.settings.enable_tags_filter | default: 'd-none' | replace: 'true', 'block' }}">
            <ul class="js-tab-container tab__header--{{- settings.tab_style }} p-relative ox-auto disable-scrollbars ls-none ws-nowrap fs-body-xl d-flex f-extra">
              <li class="tab__item">
                <a href="{{ blog.url }}" class="tab__link {% if current_tags.first == blank %}tab__link--active{% endif %} d-block p-relative m-zero">
                  {{ 'blogs.all' | t }}
                </a>
              </li>
              {%- for tag in blog.all_tags -%}
                <li class="tab__item">
                  {%- liquid
                    assign class = '<a class="tab__link d-block p-relative m-zero"'
                    if current_tags.first == tag.title
                      assign class = '<a class="tab__link d-block p-relative tab__link--active m-zero"'
                    endif
                    echo tag | link_to_tag: tag | replace: '<a', class
                  -%}
                </li>
              {%- endfor -%}
            </ul>
            <div class="js-tab-overflow tab-overflow p-absolute inset pe-none"></div>
          </sht-tab-overflow>
          <div id="loadMoreContent" class="rw r-gap-xl" data-id="{{ section.id }}">
            {%- for article in blog.articles limit: section.settings.items_per_load -%}
              <div class="clm" style="--w-xs: 12; --w-sm: 6; --w-md: {{- md -}}">
                {% render 'card-article-block',
                  article: article,
                  blog: section.settings.blog,
                  show_image: section.settings.show_featured_image,
                  image_ratio: section.settings.blog_image_ratio,
                %}
              </div>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            {%- if section.settings.blogs_load_method == 'pagination' -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- elsif section.settings.blogs_load_method == 'showmore'-%}
              {% render 'load-more-component', paginate: paginate %}
            {%- else -%}
                {% render 'infinite-scroll-component', paginate: paginate, class: 'mt-scale-2xl' %}
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "items_per_load",
      "default": "16",
      "label": "t:sections.main_blog.settings.items_per_load.label",
      "options": [
        {
          "value": "16",
          "label": "t:general.settings.items_per_load.options.options_1.label"
        },
        {
          "value": "24",
          "label": "t:general.settings.items_per_load.options.options_2.label"
        },
        {
          "value": "32",
          "label": "t:general.settings.items_per_load.options.options_3.label"
        },
        {
          "value": "48",
          "label": "t:general.settings.items_per_load.options.options_4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "blogs_load_method",
      "label": "t:sections.main_blog.settings.blogs_load_method.label",
      "options": [
        {
          "value": "pagination",
          "label": "t:general.settings.pagination.label"
        },
        {
          "value": "showmore",
          "label": "t:general.settings.show_more_button.label"
        },
        {
          "value": "infinite",
          "label": "t:general.infinite_scroll"
        }
      ],
      "default": "pagination"
    },
    {
      "type": "checkbox",
      "id": "show_rss",
      "label": "t:sections.main_blog.settings.show_rss.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_tags_filter",
      "label": "t:sections.main_blog.settings.enable_tags_filter.label",
      "default": true
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "options": [
        {
          "value": "h3-regular",
          "label": "t:general.settings.heading_size.options.extra_large.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.large.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.regular.label"
        },
        {
          "value": "h6",
          "label": "t:general.settings.heading_size.options.small.label"
        }
      ],
      "default": "h3-regular"
    },
    {
      "type": "checkbox",
      "id": "enable_h1_tag",
      "label": "t:general.settings.enable_h1_tag.label",
      "info": "t:general.settings.enable_h1_tag_info.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.blog_post_item.content"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "t:general.settings.show_featured_image.label",
      "default": true
    },
    {
      "type": "select",
      "id": "blog_image_ratio",
      "label": "t:general.settings.image_ratio.label",
      "visible_if": "{{ section.settings.show_featured_image == true }}",
      "default": "1/1",
      "options": [
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "value": "auto",
          "label": "t:general.settings.image_ratio.options.option_original.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.desktop_layout.content"
    },
    {
      "type": "select",
      "id": "columns_per_row_desktop",
      "label": "t:general.settings.columns_per_row.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:general.settings.columns_per_row.options_3.label"
        },
        {
          "value": "4",
          "label": "t:general.settings.columns_per_row.options_4.label"
        },
        {
          "value": "5",
          "label": "t:general.settings.columns_per_row.options_5.label"
        },
        {
          "value": "6",
          "label": "t:general.settings.columns_per_row.options_6.label"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tags",
      "name": "t:sections.blog_post_list.blocks.tags.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.no_customization.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.blog_post_list.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.no_customization.label"
        }
      ]
    },
    {
      "type": "additional_information",
      "name": "t:sections.blog_post_list.blocks.additional_information.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "info_to_show",
          "label": "t:general.settings.info_to_show.name",
          "options": [
            {
              "value": "author_name",
              "label": "t:general.settings.info_to_show.options.option_author_name.label"
            },
            {
              "value": "published_date",
              "label": "t:general.settings.info_to_show.options.option_published_date.label"
            },
            {
              "value": "both",
              "label": "t:general.settings.info_to_show.options.option_both.label"
            }
          ],
          "default": "published_date"
        }
      ]
    },
    {
      "type": "excerpt",
      "name": "t:sections.blog_post_list.blocks.excerpt.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.blog_post.settings.change_excerpts.content"
        },
        {
          "type": "checkbox",
          "id": "truncate_text",
          "label": "t:general.settings.truncate_text.label",
          "info": "t:general.settings.truncate_text.info",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}