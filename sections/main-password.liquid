{%- liquid
  assign desktop_background_image_alt  = section.settings.desktop_background_image.alt | default: section.settings.desktop_background_image.image | split: '/' | last
  assign desktop_background_image = section.settings.desktop_background_image | image_url: width: section.settings.desktop_background_image.width | image_tag: widths: '750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: desktop_background_image_alt, class: 'js-image-lazy d-none d-block-md w-100 h-100 of-cover'

  assign mobile_background_image_alt  = section.settings.mobile_background_image.alt | default: section.settings.mobile_background_image.image | split: '/' | last
  assign mobile_background_image = section.settings.mobile_background_image | image_url: width: section.settings.mobile_background_image.width | image_tag: widths: '750', sizes: "(min-width: 361px) calc(100vw/2), calc(100vw/3)", alt: mobile_background_image_alt, class: 'js-image-lazy-mobile d-none-md d-block w-100 h-100 of-cover'

  if section.settings.mobile_background_image == blank
    assign desktop_background_image = desktop_background_image | replace: 'd-none d-block-md', ''
  endif

  assign overlay_opacity = section.settings.section_overlay_opacity | divided_by: 100.0

  assign overlay_color = 'inherit'
  unless section.settings.section_mask_overlay_color.alpha == 0.0 or section.settings.section_mask_overlay_color == blank
    assign overlay_color = section.settings.section_mask_overlay_color | color_modify: 'alpha', overlay_opacity
  endunless
  unless section.settings.section_content_overlay_color.alpha == 0.0 or section.settings.section_content_overlay_color == blank
    assign content_color = 'color:' | append: section.settings.section_content_overlay_color
    assign content_color_rgb = '--color-normal-text-rgb:' | append: section.settings.section_content_overlay_color.red | append: ',' | append: section.settings.section_content_overlay_color.green | append: ',' | append: section.settings.section_content_overlay_color.blue
  endunless

  assign desktop_content_alignment = section.settings.desktop_content_alignment
  assign mobile_content_alignment = section.settings.mobile_content_alignment

  assign sht_mask_desk = 'center-md'
  if desktop_content_alignment contains 'left'
    assign sht_mask_desk = 'center-left-md'
  elsif desktop_content_alignment contains 'right'
    assign sht_mask_desk = 'center-right-md'
  endif

  assign sht_mask_mb = 'center'
  if mobile_content_alignment contains 'left'
    assign sht_mask_mb = 'center-left'
  elsif mobile_content_alignment contains 'right'
    assign sht_mask_mb = 'center-right'
  endif

  assign alignment_class = section.settings.desktop_content_alignment | append: ' ' | append: section.settings.mobile_content_alignment
  assign section_content_class = 'promotion-section-container zi-1 d-flex fd-column h-100 w-100 mah-100 ' | append: section.settings.desktop_content_position | append: ' ' | append: section.settings.mobile_content_position | append: ' ' | append: section.settings.desktop_content_alignment | append: ' ' | append: section.settings.mobile_content_alignment
-%}
{{ 'password.css' | asset_url | stylesheet_tag: preload: true }}
<div data-animate="banner-section" class="js-animate password-wrapper section w-100 ta-center middle-xs between-xs o-hidden color-{{ section.settings.color_scheme }} section-promotion--{{- section.settings.section_image_width }} promotion-section background" data-ui-component="Section Main Password" style="{{ content_color }}">
  <div class="ctnr h-100 rad-l-md o-hidden section-promotion__wrapper p-relative">
    {% if section.settings.mobile_background_image or section.settings.desktop_background_image %}
      <div class="promotion-section__background p-absolute w-100 h-100 sht-mask sht-mask--{{ sht_mask_desk }} sht-mask--{{ sht_mask_mb }} inset" style=" --color-mask: {{ overlay_color }}; --overlay: {{ overlay_opacity }};">
          <div class="banner-media__animate d-block w-100 h-100">
            {%- liquid
              echo desktop_background_image | replace: "src=", 'loading="lazy" decoding="async" src='
              if section.settings.mobile_background_image
                  echo mobile_background_image | replace: "src=", 'data="mobile" loading="lazy" decoding="async" src='
              endif
            -%}
          </div>
      </div>
    {% endif %}
    <div class="p-relative zi-1 h-100">
        <div class="banner-content__animate section__text d-flex fd-column h-100 o-hidden align-content-end end-xs">
          <div class="password flex-auto w-100 zi-2 d-flex fd-column center-xs middle-xs flex-1" style="{{ content_color }}">
            {%- if shop.password_message != blank -%}
              <div class="">
                {{ shop.password_message }}
              </div>
            {%- endif -%}
            <div class="center-xs {{ section_content_class }} wb-break-word">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'logo' -%}
                    <div class="password__logo" {{ block.shopify_attributes }}>
                      <div class="d-flex middle-xs" style="--logo-ratio: {{ block.settings.logo.aspect_ratio }};--logo-width-desktop: {{ block.settings.logo_max_width_desktop -}} px; --logo-max-width: {{ block.settings.logo_max_width_mobile }}px">
                        <a href="{{ routes.root_url }}" aria-label="{{ block.settings.logo.alt | default: shop.name | escape }}" class="header__logo-link m-zero js-header-logo-link d-block h5 p-relative wb-break-word">
                          {%- if block.settings.logo != blank -%}
                            {%- liquid
                              assign logo_alt = block.settings.logo.alt | default: shop.name | escape
                              assign logo_height = block.settings.logo_max_width_desktop | times: 2 | divided_by: block.settings.logo.aspect_ratio
                              assign logo_width = 500
                            -%}
                            {% capture sizes %}{{ logo_width }}px{% endcapture %}
                            {% capture widths %}{{ block.settings.logo_max_width_desktop }}, {{ logo_width | round }}, {{ logo_width }}{% endcapture %}
                            {{- block.settings.logo | image_url: width: 500 | image_tag: class: 'password-logo-image w-100', widths: widths, height: logo_height, width: logo_width, alt: logo_alt, sizes: sizes, preload: true -}}
                          {%- else -%}
                            <span class="header__heading m-zero wb-break-word">{{ shop.name }}</span>
                          {%- endif -%}
                        </a>
                      </div>
                    </div>
                  {% when 'subheading'%}
                    <div class="subheading section__subheading hide-empty d-block {{ settings.subheading_style }}" {{ block.shopify_attributes }}>
                      {{- block.settings.subheading | escape -}}
                    </div>
                  {% when 'heading'%}
                      <{{- block.settings.enable_h1_tag | replace: true, 'h1' | replace: false, 'h2' }} class="section__heading wb-break-word hide-empty d-block m-zero {{ block.settings.heading_size }} hide-empty" {{ block.shopify_attributes }}>{{- block.settings.heading | escape -}}</{{- block.settings.enable_h1_tag | replace: true, 'h1' | replace: false, 'h2' -}}>
                  {% when 'description'%}
                    <div class="section__description fs-body-xl rte hide-empty o-hidden_" {{ block.shopify_attributes }}>
                      {{- block.settings.description -}}
                    </div>
                  {% when 'newsletter'%}
                    <div class="password__newsletter section__newsletter-form w-100" {{ block.shopify_attributes }} style="{{ content_color_rgb }}">
                      {% render 'newsletter-form',
                        form_id: 'mainPassword',
                        form_name: 'mainPassword',
                        classes: 'fw-wrap',
                        button_label: block.settings.submit_button,
                        input_class: 'flex-1',
                        alignment_class: alignment_class %}
                    </div>
                  {% when 'social'%}
                    <div class="password-socials mt-scale-m " {{ block.shopify_attributes }}>
                      <span class="h6 d-block m-zero hide-empty">{{- block.settings.heading -}}</span>
                      {% render 'socials', classes: 'center-xs', button_type: block.settings.button_style %}
                    </div>
                {% endcase %}
              {%- endfor -%}
            </div>
          </div>
          <div class="password__footer promotion-section-container d-flex fd-column center-xs w-100 p-relative zi-2 between-md middle-xs fd-row-md">
            <div class="d-flex middle-xs center-xs fw-wrap">
              <button class="btn btn-s btn-tertiary modal__toggle-open d-flex middle-xs" onclick="window.shtPasswordModal.showModal(this, true)" style="{{ content_color }}">
                {{ 'general.password_page.login_password_button' | t }}
              </button>
              <span class="password__admin-account">
                &nbsp; {{- 'general.password_page.admin_link_html' | t -}}&nbsp;
                <a href="{{routes.root_url}}admin" class="btn btn-s btn-tertiary" style="{{ content_color }}">{{- 'general.password_page.admin_link_login' | t -}}</a>
              </span>
            </div>
            <div class="copyright-textarea rte d-flex middle-xs center-xs hide-empty fd-column fd-row-md" style="{{ content_color_rgb }}">
              {%- liquid
                assign current_year = 'now' | date: "%Y"
              -%}
              {{- section.settings.copyright_content | replace: '[year]', current_year -}}
              {%- if section.settings.enable_powered_by_shopify -%}
                &nbsp;
                {{ powered_by_link }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
  </div>
</div>
<sht-dialog class="sht-dialog js-password-modal-content p-fixed left-0 top-0 hidden-xs opacity-0 w-100 h-100 zi-10 d-flex center-xs middle-xs ta-center o-hidden hidden-xs"
role="dialog"
aria-labelledby="dialogPasswordHeading"
aria-modal="true"
id="shtPasswordModal"
>
  <div class="sht-dialog-overlay js-dialog-overlay"></div>
  <div class="dialog password-modal__content drawer-content-container rad-l o-hidden disable-scrollbars background p-relative" tabindex="-1">
    <div class="dialog__header d-flex between-xs middle-xs">
      <h6 class="ta-left m-zero" id="dialogPasswordHeading" data-type="modal-title">
        {{ 'general.password_page.login_form_heading' | t }}
      </h6>
      <button aria-label="{{ 'accessibility.close' | t }}" type="button" class="btn btn-tertiary btn-icon btn-icon-l drawer__btn-close js-dialog-close-btn" data-dismiss="modal">
        {%- render 'icon-x-mark' -%}
      </button>
    </div>
    <div class="modal-dialog__body dialog__body d-grid gap-s disable-scrollbars">
      {%- form 'storefront_password', class: 'password_form', id: 'modal-password' -%}
        <div class="form__group d-flex fd-column fd-row-sm gap-xs">
          <input id="mainPasswordInput" type="password" class="field__text field--large field--hover w-100 fg-1" name="password"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordLoginForm-password-error"
          {%- endif -%}
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            aria-label="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            autofocus
            required
          >
          <label class="field__label visually-hidden" for="mainPasswordInput">{{ 'general.password_page.your_password' | t }}</label>
          <button aria-label="{{ 'general.password_page.login_form_submit' | t }}" type="submit" name="commit" class="btn btn-primary btn-m fs-0">
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        </div>
        {%- if form.errors -%}
          <div class="message--error d-flex middle-xs start-xs mt-xs gap-3xs">
            <div class="icon fs-0">
              {%- render 'icon-warning-circled' | class: 'icon icon-fix-m' -%}
            </div>
            <span class="fs-body-s">
              {{ form.errors.messages['form'] }}
            </span>
          </div>
        {%- endif -%}
      {%- endform -%}
      <span class="d-flex gap-xs middle-xs center-xs">
        <span class="d-block fs-body-m">{{- "general.password_page.admin_link_html" | t -}}</span>
        <a href="{{- routes.root_url -}}admin" class="btn btn-tertiary btn-s">{{- 'general.password_page.admin_link_login' | t -}}</a>
      </span>
    </div>
  </div>
</sht-dialog>
<ul hidden>
  <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
</ul>
{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.image_optional.content"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "t:general.settings.background_image.label",
      "info": "t:general.settings.background_image.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "t:general.settings.mobile_background_image.label",
      "info": "t:general.settings.mobile_background_image.info"
    },
    {
      "type": "range",
      "unit": "%",
      "max": 90,
      "min": 0,
      "step": 1,
      "default": 30,
      "id": "section_overlay_opacity",
      "label": "t:general.settings.overlay_opacity.label"
    },
    {
      "type": "color",
      "id": "section_mask_overlay_color",
      "label": "t:general.settings.custom_mask_overlay_opacity.label",
      "visible_if": "{{ section.settings.section_overlay_opacity != 0 }}"
    },
    {
      "type": "color",
      "id": "section_content_overlay_color",
      "label": "t:general.settings.custom_content_overlay_opacity.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.copyright.content"
    },
    {
      "type": "richtext",
      "id": "copyright_content",
      "label": "t:sections.copyright_bar.settings.copyright_content.label",
      "info": "t:sections.copyright_bar.settings.copyright_content.info",
      "default": "<p>© [year]. All rights reserved.</p>"
    },
    {
      "type": "checkbox",
      "default": true,
      "id": "enable_powered_by_shopify",
      "label": "t:general.settings.show_powered_by_shopify.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.desktop_layout.label"
    },
    {
      "type": "select",
      "id": "section_image_width",
      "label": "t:general.settings.banner_width.label",
      "options": [
        {
          "value": "max-width",
          "label": "t:general.settings.options.option_max_width.label"
        },
        {
          "value": "stretch",
          "label": "t:general.settings.options.option_stretch.label"
        },
        {
          "value": "full-width",
          "label": "t:general.settings.options.option_full_width.label"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "options": [
        {
          "value": "ta-left-md top-md",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center-md middle-md",
          "label": "t:general.settings.option_center.label"
        },
        {
          "value": "ta-right-md bottom-md",
          "label": "t:general.settings.option_right.label"
        }
      ],
      "default": "ta-center-md middle-md"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.mobile_layout.content"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "t:general.settings.content_alignment.label",
      "options": [
        {
          "value": "ta-left top-xs",
          "label": "t:general.settings.option_left.label"
        },
        {
          "value": "ta-center middle-xs",
          "label": "t:general.settings.option_center.label"
        },
        {
          "value": "ta-right bottom-xs",
          "label": "t:general.settings.option_right.label"
        }
      ],
      "default": "ta-center middle-xs"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.main_password.blocks.settings.logo.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:general.settings.logo_image.label",
          "info": "t:sections.header.settings.logo_image.info"
        },
        {
          "type": "range",
          "id": "logo_max_width_desktop",
          "label": "t:sections.header.settings.logo_max_width_desktop.label",
          "min": 40,
          "max": 500,
          "default": 140,
          "step": 10,
          "unit": "px",
          "visible_if": "{{ block.settings.logo != blank }}"
        },
        {
          "type": "range",
          "id": "logo_max_width_mobile",
          "label": "t:sections.header.settings.logo_max_width_mobile.label",
          "min": 40,
          "max": 140,
          "default": 70,
          "step": 10,
          "unit": "px",
          "visible_if": "{{ block.settings.logo != blank }}"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "t:general.settings.subheading.label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "label": "t:general.settings.text.label",
          "id": "subheading",
          "default": "Stay tune!"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:general.settings.heading.label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.text.label",
          "default": "Opening soon"
        },
        {
          "type": "select",
          "label": "t:general.settings.text_size.label",
          "id": "heading_size",
          "visible_if": "{{ block.settings.heading != blank }}",
          "options": [
            {
              "value": "headline",
              "label": "t:general.settings.heading_size.options.extra_large.label"
            },
            {
              "value": "h1",
              "label": "t:general.settings.heading_size.options.large.label"
            },
            {
              "value": "h2",
              "label": "t:general.settings.heading_size.options.regular.label"
            },
            {
              "value": "h3",
              "label": "t:general.settings.heading_size.options.small.label"
            }
          ],
          "default": "h2"
        },
        {
          "type": "checkbox",
          "id": "enable_h1_tag",
          "label": "t:general.settings.enable_h1_tag.label",
          "info": "t:general.settings.enable_h1_tag_info.info",
          "default": true,
          "visible_if": "{{ block.settings.heading != blank }}"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:general.settings.description.label",
      "settings": [
        {
          "type": "richtext",
          "label": "t:general.settings.description.label",
          "id": "description",
          "default": "<p>Be the first to know about our new collections and exclusive offers</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:general.newsletter_form.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:section.newsletter.block.settings.newsletter_form.info"
        },
        {
          "type": "text",
          "id": "submit_button",
          "label": "t:general.settings.submit_button.label",
          "default": "Notify me"
        }
      ]
    },
    {
      "type": "social",
      "name": "t:settings_schema.social_media.name",
      "limit": 1,
      "settings": [
      ]
    }
  ]
}
{% endschema %}
