{%- liquid
  assign section_id = section.id | md5 | truncate: 12, ""
	assign product_form_installment_id = 'productFormInstallment-' | append: section.id
	assign thumb_index = 0
  assign variant_labels = settings.variant_option_name | downcase
  assign normalized_label = variant_labels | replace: ' ', '' | prepend: 'color,'
  assign variant_label = normalized_label | split: ',' | uniq
	assign hide_variant_image = true
  assign is_layout_grid = false
  if section.settings.media_layout contains 'layout-grid'
    assign hide_variant_image = false
    assign is_layout_grid = true
  endif
  assign popup_contents = ''
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  if section.settings.media_width_on_mobile == 'option_fullwidth'
    assign media_width_on_mobile = 'product-slideshow-mobile-full-width'
  endif
  assign clm_media = 6
  assign clm_info = 6
  if section.settings.media_width_on_desktop == '2/3'
    assign clm_media = 8
    assign clm_info = 4
  endif
  if product.media.size == 0
    assign clm_info = 12
  endif
	assign thumbnails_ratio = section.settings.thumbnails_ratio | replace: 'fit', '' | replace: 'fill', ''
	assign object_fit = 'of-cover'
	if section.settings.thumbnails_ratio contains 'fit'
	  assign object_fit = 'of-contain'
	endif
	assign media_background = section.settings.media_background_color
  assign sticky_product_form_id = 'productStickyForm-' | append: section.id
  assign days_new = settings.new_in_date_limit
  assign published_date = product.published_at | date: "%s"
  assign current_date = 'now' | date: "%s"
  assign days_since_published = current_date | minus: published_date | divided_by: 86400
  assign product_form_id = 'productForm-' | append: section.id
  if settings.enable_button_uppercase
    assign button_uppercase = 'tt-up'
  endif
  assign status_attribute = ''
  assign add_to_cart_btn_lbl = 'products.product.add_to_cart' | t
  if product.selected_or_first_available_variant.available == false and product.selected_or_first_available_variant.inventory_policy != 'continue' and product.selected_or_first_available_variant.inventory_management != blank
    assign status_attribute = 'disabled'
    assign add_to_cart_btn_lbl = 'products.product.sold_out' | t
  endif
  assign product_quantity = product.selected_or_first_available_variant.inventory_quantity
  if product.selected_or_first_available_variant.inventory_policy == 'continue' or product.selected_or_first_available_variant.inventory_management == blank
    assign product_quantity = 9999
  endif
  if section.settings.enable_sticky_media
    assign enable_sticky_media = 'main-product--sticky'
  endif
  assign size_guide_dialog_label = "size,größe,サイズ,尺寸,tamaño,taille,dimensione,размер,크기,الحجم,tamanho, kích thước, kích cỡ, ขนาด"
 -%}
{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}
{%- render 'section-padding-collapse' -%}
<div data-animate="regular-section" class="js-animate section main-product color-{{- section.settings.color_scheme }} background js-main-product" data-ui-component="Main Product Section" role="region" aria-label="product-detail-{{ section_id }}" id="{{ section.id }}" data-color="color-{{- section.settings.color_scheme }}">
  {%- if settings.enable_breadcrumb_products -%}
    {%- render 'breadcrumb', page: page, routes: routes, class: 'mb-m' -%}
  {%- endif -%}
  <div class="js-product-container gap-scale-4xl {{ section.settings.enable_fullwidth | default: 'ctnr' | replace: 'true', '' }} p-relative d-flex {{ section.settings.section_ordering }} fd-column top-xs {% if product.media.size == 1 %} product-media--single {% endif %}">
    {% if product.media.size > 0 %}
      <div class="main-product__media {{ enable_sticky_media }} w-100" style="--w-xs:12; --w-md:{{ clm_media }}" role="region" aria-label="product-gallery">
        <a class="visually-hidden skip-to-content btn btn-primary btn-l ta-center w-100 w-md-auto" href="#productInfo-{{ section.id }}">{{ 'accessibility.skip_to_product_information' | t }}</a>
        <div class="product__media-wrapper {{ media_width_on_mobile }} product__media--{{ section.settings.media_layout }} product__media--{{ section.settings.media_layout | replace: '-left' ,'' | replace: '-right' ,'' | replace: '-below' ,'' | replace: '-1-column', '' | replace: '-2-columns', '' | replace: '-collage', '' }}">
          <sht-prd-slideshow role="status" class="product-slideshow js-product-slideshow-container product__media--{{ section.settings.media_layout }} d-grid p-relative gap-2x" data-hide-variant-image="{{- hide_variant_image -}}" data-section="{{ section.id }}">
            <div class="product-slideshow__slide o-hidden w-100">
              {% render 'product-gallery-carousel',
                product: product,
                section: section,
                rand: section_id,
                hide_variant_image: hide_variant_image,
                is_first_image: false,
                open_zoom_modal: section.settings.enable_media_zoom,
                ratio: section.settings.main_media_ratio,
                media_background: media_background,
                carousel_desktop: true,
                is_layout_grid: is_layout_grid
              %}
            </div>
            <div class="product-slideshow__thumbnail d-block-md {{ section.settings.show_media_thumbnails | default: 'd-none' | replace: true, 'd-block' }}">
              <sht-slideshow-carousel data-layout="{{ section.settings.media_layout }}" data-section="{{ section.id }}" class="product-slideshow__carousel p-relative">
                <div class="product-slideshow__thumbs js-carousel-items d-flex middle-xs p-relative disable-scrollbars fw-nowrap scrollable scrl-bhvr-auto rad-l">
                  {%- liquid
                    if product.selected_or_first_available_variant.featured_media != null
                      assign thumb_index = thumb_index | plus: 1
                      assign featured_media = product.selected_or_first_available_variant.featured_media
                      render 'product-slideshow-thumb', section: section, media: featured_media, product: product, thumb_index: thumb_index, ratio: thumbnails_ratio, object_fit: object_fit, media_background: media_background
                    endif
                    for media in product.media
                      assign thumb_index = thumb_index | plus: 1
                      unless media.id == product.selected_or_first_available_variant.featured_media.id
                        render 'product-slideshow-thumb', section: section, media: media, product: product, thumb_index: thumb_index, ratio: thumbnails_ratio, object_fit: object_fit, media_background: media_background
                      endunless
                    endfor
                  -%}
                </div>
                <div class="product-slideshow__pagination carousel-pagination--vertical carousel-controls--outside carousel-pagination d-flex-md d-none-important center-xs no-js-hidden js-carousel-pagination p-absolute top-0 h-100">
                  <button type="button" data-step="1" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-m btn-secondary ele-focus-visible p-absolute rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled="true">
                    {% render 'icon-caret-up', class: 'icon icon-control icon-fix-m' %}
                  </button>
                  <button type="button" data-step="1" class="js-carousel-next-btn btn-carousel-next btn btn-icon-m btn-secondary ele-focus-visible p-absolute rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next">
                    {% render 'icon-caret-down', class: 'icon icon-control icon-fix-m' %}
                  </button>
                </div>
                <div class="thubnails-carousel-overflow"></div>
              </sht-slideshow-carousel>
            </div>
          </sht-prd-slideshow>
        </div>
      </div>
    {% endif %}
    <div id="productInfo-{{ section.id }}" class="main-product__info {{ enable_sticky_media }} d-flex top-xs fw-wrap c-gap-fix-xs w-100" style="--w-xs:12; --w-md:{{ clm_info }}">
      {%- for block in section.blocks -%}
				{%- case block.type -%}
          {%- when '@app' -%}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- when 'title' -%}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              <{{ block.settings.enable_h1_tag | default: 'span' | replace: true, 'h1' }} class="product__title {{ block.settings.heading_size }} m-zero hide-empty">{{- product.title | escape -}}</{{ block.settings.enable_h1_tag | default: 'span' | replace: true, 'h1' }}>
            </div>
          {%- when 'vendor' -%}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              <span class="visually-hidden">{{- 'accessibility.vendor' | t -}}</span>
              <span class="d-block color-text-60 fs-body-m wb-break-word f-extra">{{- product.vendor -}}</span>
            </div>
          {%- when 'product_type' -%}
            {% if product.type != blank %}
              {% liquid
                unless block.settings.color_product_type.alpha == 0.0 or block.settings.color_product_type == blank
                  assign color_product_type = '--color-normal-text-rgb:' | append: block.settings.color_product_type.red | append: ',' | append: block.settings.color_product_type.green | append: ',' | append: block.settings.color_product_type.blue
                endunless
              %}
              <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
                <span class="fs-heading-xs component-heading d-block hide-empty color-text-60 f-extra" style="{{ color_product_type }}" {{ block.shopify_attributes }}>{{- product.type -}}</span>
              </div>
            {% endif %}
          {%- when 'product_code' -%}
            <div class="product__info product__block-{{- block.type }} f-extra d-flex middle-xs fw-wrap gap-3xs hide-empty fs-body-m color-text-60 js-product-sku" id="sku-{{- section.id }}" role="status" {{ block.shopify_attributes }}>
              <span class="product-code-item variant-sku d-none mb-m hide-empty {% if block.settings.product_code_to_show == "sku_only" or block.settings.product_code_to_show == "both" %}d-inline-block{% endif %}">
                {%- if product.selected_or_first_available_variant.sku != blank -%}
                  <span>SKU: {{ product.selected_or_first_available_variant.sku }} </span>
                {%- endif -%}
              </span>
							{%- if block.settings.product_code_to_show == "both" and product.selected_or_first_available_variant.sku != blank and product.selected_or_first_available_variant.barcode != blank -%}
                <span class="product-code-item mb-m"> • </span>
							{%- endif -%}
              <span class="product-code-item variant-bar-code d-none mb-m hide-empty {% if block.settings.product_code_to_show == "barcode_only" or block.settings.product_code_to_show == "both" %}d-inline-block{% endif %}">
                {%- if product.selected_or_first_available_variant.barcode != blank -%}
                  <span>Barcode: {{ product.selected_or_first_available_variant.barcode }}</span>
                {%- endif -%}
              </span>
						</div>
          {%- when 'price' -%}
            {% liquid
              unless block.settings.color_product_price.alpha == 0.0 or block.settings.color_product_price == blank
                assign price_color = 'color: ' | append: block.settings.color_product_price
              endunless
            %}
						<div class="product__info product__price product__block-{{- block.type }} mb-3xl" {{ block.shopify_attributes }}>
              <div class="js-product-price">
                <div class="d-flex middle-xs gap-xs fw-wrap base-line" id="productPrice-{{- product.id }}" role="status" style="{{ price_color }}">
                  {%- render 'product-price', product: product, target: product.selected_or_first_available_variant, price_class: "d-flex middle-xs gap-xs base-line fw-wrap", price_style: block.settings.heading_size, price_regular_style: "fs-heading-m component-heading" -%}
                  <div class="product__badge d-flex gap-3xs fw-wrap hide-empty">
                    {%- if product.selected_or_first_available_variant.available == false and block.settings.show_sold_out_badge -%}
                      <span class="fs-heading-xs component-heading f-extra badge badge--sold-out d-inline-block background color-{{ settings.sold_out_color }} {{ settings.stock_badge_corner_radius }}">
                        {{- 'products.product.sold_out' | t -}}
                      </span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                      {%- liquid
                        assign discount_cost = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price
                        assign discount_percent = discount_cost | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round: 2
                      -%}
                      <span class="fs-heading-xs component-heading f-extra badge badge--sale d-inline-block background color-{{ settings.sale_color }} {{ settings.stock_badge_corner_radius }} p-relative {% if block.settings.show_sale_badge == "not_use" %}d-none-important{% endif %}">
                        {%- if block.settings.show_sale_badge == "text_sale_amount" -%}
                          {{ discount_percent }}% {{ 'products.product.off' | t }}
                        {%- elsif block.settings.show_sale_badge == "text_only" -%}
                          {{ 'products.product.sale_off' | t }}
                        {%- endif -%}
                        <span hidden>
                          {%- if settings.currency_code_enabled -%}
                            {{- discount_cost | money_with_currency -}}
                            {% else %} {{- discount_cost | money -}}
                          {%- endif -%}
                        </span>
                      </span>
                    {%- endif -%}
                    {% if days_since_published < days_new and settings.product_card_show_new_in_badge and block.settings.show_new_in_badge %}
                      <span class="fs-heading-xs component-heading f-extra badge badge--newin d-inline-block background color-{{ settings.new_in_color }} {{ settings.stock_badge_corner_radius }}">
                        {{ 'products.product.new_in' | t }}
                      </span>
                    {% endif %}
                  </div>
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <p class="fs-body-m mb-xs mt-xs color-text-60 hide-empty quantity-pricing-text">{{- 'product.volume_pricing_available' | t -}}</p>
                  <sht-accordion class="accordion rad-l border disable-scrollbars d-flex fd-column o-hidden mb-xs">
                    <div class="accordion__item volume-pricing-accordion background js-accordion-item">
                      <button class="region-trigger accordion__header accordion__button w-100 js-accordion-trigger d-flex middle-xs p-relative c-pointer open" id="collapsible-control-{{- block.id -}}" aria-expanded="true" aria-controls="collapsible-content-{{- block.id -}}">
                        <span class="m-zero flex-1 ta-left">
                          <span class="mb-xs component-heading fs-heading-s">{{- 'product.volume_pricing' | t -}}</span>
                        </span>
                        <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                          {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon icon-fix-xl', class_first: 'toggle__icon--plus p-absolute icon icon-fix-xl', class_second: 'toggle__icon--minus p-absolute icon icon-fix-xl' %}
                        </span>
                      </button>
                      <div class="accordion__content o-hidden js-accordion-content accordion-content open" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1" style="max-height: auto;">
                        {%- render 'quantity-pricing', product: product, target: product.selected_or_first_available_variant -%}
                      </div>
                    </div>
                  </sht-accordion>
                {%- endif -%}
              </div>
              {%- if block.settings.show_tax_and_shipping_policy -%}
                <p class="hide-empty mb-0 mt-xs fs-body-m color-text-60 rte">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </p>
              {% endif %}
              {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {{ form | payment_terms }}
              {%- endform -%}
            </div>
          {%- when 'variant_selector' -%}
            {%- liquid
							assign size_guide_dialog_id = block.id | append: section.id | md5 | truncate: 12, ""
							assign size_guide_cta = 'disabled'
							if block.settings.size_guide_content != blank
								assign size_guide_cta = ''
                assign size_guide_block = block
							endif
              assign size_guide_text = 'products.product.size_guide' | t
              assign size_label_heading = block.settings.size_label_heading | default: size_guide_text | escape
						-%}
						<div class="product__info product__block-{{ block.type }} d-flex fd-column mb-3xl" {{ block.shopify_attributes }}>
              <div class="js-variant-picker" id="variantPicker-{{- section.id }}">
                {%- unless product.has_only_default_variant -%}
                  {%- if block.settings.selector_style == 'block' -%}
                      <sht-variant-radios class="product__variants--radios d-flex fd-column no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" data-product-id="{{ product.id }}">
                        {%- for option in product.options_with_values -%}
                          {%- liquid
                            assign check_variant = true
                            assign index = forloop.index0
                            assign variant_name = option.name | downcase 
                          -%}
                          <fieldset class="form__fields product-option js-variant-radio-container d-flex fw-wrap">
                          <legend class="p-zero m-zero product-option__name d-flex between-xs gap-scale-3xs fw-wrap w-100 middle-xs">
                            <span class="d-flex flex-1 gap-scale-3xs middle-xs fw-wrap">
                              <span class="fs-body-l hide-empty">{{- option.name -}}:</span>
                              <span class="js-variant-radio-option-name fs-body-l hide-empty" data-option-index="{{ index }}" data-option-name="{{ option.name }}">{{ product.selected_or_first_available_variant.options[index] }}</span>
                            </span>
                            {% if block.settings.enable_size_guide and size_guide_dialog_label contains variant_name %}
                              <button class="btn btn-plain btn-tertiary d-flex gap-3xs middle-xs ta-right js-size-guide-btn {{ size_guide_cta | replace: 'disabled', 'disable' }}" aria-haspopup="dialog" onclick="window.dialogSizeGuide{{ size_guide_dialog_id }}.showModal(this, true)" {{ size_guide_cta }}>
                                {{ size_label_heading }}
                                {%- render 'icon-ruler', class: 'icon icon-fix-l' -%}
                              </button>
                            {% endif %}
                          </legend>
                          {%- liquid
                            for label in variant_label
                              assign label = label | strip
                              if label == variant_name and block.settings.show_variant_swatches
                                assign check_variant = false
                                render 'main-product-color-swatch', product: product, option: option, section: section, product_form_id: product_form_id, index: index 
                              endif
                            endfor
                          -%}
                          {%- if check_variant -%}
                            <ul class="variant-list ls-none d-flex fw-wrap">
                              {%- for value in option.values -%}
                                {% liquid
                                  assign option_disabled = true

                                  if value.available
                                    assign option_disabled = false
                                  endif
                                %}

                                <li class="form__field js-variant-option-value product-option__value
                                  {% if option_disabled %} product-option--unavailable {% endif %}
                                  {% if product.selected_or_first_available_variant.available == false and option.selected_value == value %}product-option--sold-out{% endif %}"
                                   data-value="{{ value | escape }}-{{ index }}"
                                   data-option-index="{{ index }}"
                                >
                                  <input type="radio" class="form__control input--variant js-variant-radio-item js-variant-item visually-hidden" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ option.name }}" value="{{ value | escape }}" data-variant-value="{{ value | escape }}-{{ index }}" form="{{ product_form_id }}"
                                    {% if option.selected_value == value %}
                                    checked
                                    {% endif %}
                                    data-option-value-id="{{ value.id }}"
                                  >
                                  <label class="form__label product-option__label d-block js-variant-option-label o-hidden p-relative c-pointer rad-s border-content-10 background fs-heading-xs component-heading" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" title="{{ value | escape }}">
                                    <span class="product-variant-label f-extra">
                                      {{ value }}
                                    </span>
                                  </label>
                                </li>
                              {%- endfor -%}
                              </ul>
                          {%- endif -%}
                          </fieldset>
                        {%- endfor -%}
                        <script data-selected-variant type="application/json">{{ product.selected_or_first_available_variant | json }}</script>
                      </sht-variant-radios>
                  {%- else -%}
                    {%- render 'main-product-variant-selects', section: section, product: product, variant_label: variant_label, block: block, product_form_id: product_form_id, enable_size_guide: block.settings.enable_size_guide, size_guide_dialog_id: size_guide_dialog_id, size_guide_dialog_label: size_guide_dialog_label, size_guide_cta: size_guide_cta -%}
                  {%- endif -%}
                  <noscript>
                  <div class="form__fields {% if product.has_only_default_variant %} hidden{% endif %}">
                    <div class="form__field">
                    <label class="form__label" for="Variants-{{ section.id }}-{{ forloop.index0 }}">{{ 'products.product.product_variants' | t }}</label>
                    <select name="Variants-{{ section.id }}-{{ forloop.index0 }}" id="Variants-{{ section.id }}-{{ forloop.index0 }}" class="form__control w-100 h-100 field__text field--focus field--hover" form="{{ product_form_id }}">
                      {%- for variant in product.variants -%}
                      <option
                        {% if variant == product.selected_or_first_available_variant %}
                        selected="selected"
                        {% endif %}
                        {% if variant.available == false %}
                        disabled
                        {% endif %}
                        value="{{ variant.id }}">
                        {{ variant.title }}
                        {%- if variant.available == false %}
                        - {{ 'products.product.sold_out' | t }}{% endif %}- {{ variant.price | money | strip_html }}
                      </option>
                      {%- endfor -%}
                    </select>
                    </div>
                  </div>
                  </noscript>
                {%- endunless -%}
              </div>
							<div class="js-inventory-tracking product__inventory-tracking hide-empty" role="status" id="inventoryTracking-{{ product.id }}">
								{%- if product.selected_or_first_available_variant.inventory_management != nil and product.selected_or_first_available_variant.inventory_quantity > 0 -%}
								<span class="d-flex gap-2xs middle-xs pt-m stock-status">
									{% if settings.low_stock_threshold > 0 and settings.low_stock_threshold >= product.selected_or_first_available_variant.inventory_quantity and block.settings.show_low_stock %}
                    <span class="icon-status icon-warning-sign"></span>
                    <span class="hide-empty fs-body-m color-text-80">
                      {%- if block.settings.show_stock_counter -%}
                        {{- 'products.product.low_stock_html' | t: stock: product.selected_or_first_available_variant.inventory_quantity -}}
                      {%- else -%}
                        {{- 'products.product.low_stock' | t -}}
                      {%- endif -%}
                    </span>
									{% else %}
                    <span class="icon-status icon-success-sign"></span>
                    <span class="hide-empty fs-body-m color-text-80">
                      {%- if block.settings.show_stock_counter -%}
                        {{- 'products.product.in_stock_html' | t: stock: product.selected_or_first_available_variant.inventory_quantity -}}
                      {%- else -%}
                        {{- 'products.product.in_stock' | t -}}
                      {%- endif -%}
                    </span>
									{%- endif -%}
								</span>
								{%- else -%}
									{%- if product.selected_or_first_available_variant.inventory_policy != 'continue' and product.selected_or_first_available_variant.inventory_management != blank -%}
										<span class="d-flex gap-2xs middle-xs pt-m stock-status">
											<span class="icon-status icon-error-sign"></span>
                      <span class="hide-empty fs-body-m color-text-80">{{- 'products.product.out_of_stock' | t -}}</span>
										</span>
									{%- endif -%}
								{%- endif -%}
							</div>
						</div>
          {%- when 'buy_buttons' -%}
            {%- liquid
              assign pre_order_status = false
              if block.settings.enable_pre_order and product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_management != blank and product.selected_or_first_available_variant.inventory_quantity == 0
                assign add_to_cart_btn_lbl = 'products.product.pre_order' | t
                assign pre_order_status = true
              endif
            -%}
            <sht-sticky-prd-info class="product__info product__block-{{- block.type }} d-block mb-3xl" data-section-id="{{ section.id }}" data-is-enabled="{{ section.settings.enable_sticky_add_to_cart }}">
							<div class="js-sticky-product-info" {{ block.shopify_attributes }}>
								<div class="product__form">
									<sht-prd-frm class="sht-product__form product-form js-sht-product-form" data-section="{{ section.id }}">
										{%- form 'product', product, id: product_form_id, class: 'form form__fields js-product-form js-main-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
											<div class="form__field">
												<input type="hidden" class="form__control" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
											</div>
											<div class="product-form__buttons d-flex top-xs fd-column">
												{%-liquid
													if block.settings.show_gift_card_form and product.gift_card?
														render 'gift-card-recipient-form', product: product, form: form, section: section
													endif
                        -%}
												<div class="d-flex gap-xs w-100 mb-s js-product-quantity-container js-quantity-wrapper fw-wrap" id="productQuantityContainer-{{ section.id }}">
                          <div class="d-flex gap-xs w-100 product-quantity-main">
                            <div class="js-product-quantity product__quantity{% unless block.settings.show_quantity_selector %} d-none{% endunless %}" id="productQuantity-{{ section.id }}" data-show="{{ block.settings.show_quantity_selector }}">
                              <label class="field__label visually-hidden" for="productQuantityInput-{{ section.id }}">{{ 'products.product.quantity.label' | t }}:</label>
                              <sht-qty-inp class="field_quantity d-inline-flex middle-xs center-xs" data-product-quantity="{{ product_quantity }}">
                                <button class="js-quantity-btn btn btn-icon-m btn-secondary" name="minus" data-name="minus" type="button" {{ status_attribute }}>
                                  <span class="visually-hidden">{{ 'general.cart.decrease' | t }}</span>
                                  {% render 'icon-minus', class: 'icon icon-fix-m' %}
                                </button>
                                <input class="js-quantity-input product-quantity-input input-number fs-body-l btn-icon-m b-zero ta-center bg-transparent color-secondary-text"
                                type="number"
                                name="quantity"
                                value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                                min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                                step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                                {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                                  max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                                {% endif %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                                id="productQuantityInput-{{ section.id }}"
                                form="{{ product_form_id }}">
                                <button class="js-quantity-btn btn btn-icon-m btn-secondary" name="plus" data-name="plus" type="button" {{ status_attribute }}>
                                  <span class="visually-hidden">{{ 'general.cart.increase' | t }}</span>
                                  {% render 'icon-plus', class: 'icon icon-fix-m' %}
                                </button>
                              </sht-qty-inp>
                            </div>
                            <button type="submit" name="add" data-pre-order="{{ pre_order_status }}" class="js-product-form-submit-btn product-btn-atc btn btn-secondary btn-l gap-3xs w-100" {{ status_attribute }}>
                              <span class="js-product-form-spinner product-form-spinner icon d-flex middle-xs">
                                {% render 'icon-spinner', size: '20px' %}
                              </span>
                              <span class="js-product-form-submit-btn-text {{ button_uppercase }}">{{ add_to_cart_btn_lbl }}</span>
                            </button>
                          </div>
                          <div class="form--error js-product-form-error-wrapper w-100" data-type="error-wrapper" role="alert" hidden>
                            <span class="d-flex middle-xs gap-3xs">
                              {%- render 'icon-warning-circled', class: 'icon icon-fix-m color-error' -%}
                              <span class="js-product-form-error-message fs-body-s color-text-80 mb-0 max-quantity-message" data-type="error-message"></span>
                            </span>
                          </div>
                          <div class="d-flex w-100 gap-3xs d-none-important js-max-quantity-message">
                            {%- render 'icon-warning-circled', class: 'icon icon-fix-m color-error' -%}
                            <p class="fs-body-s color-text-80 mb-0 max-quantity-message">{{ 'products.product.add_more_text' | t }} {{ product.title }} {{ 'sections.featured_blog.article.in_date' | t }} {{ product.selected_or_first_available_variant.title }} {{ 'products.product.item_to_cart' | t }}</p>
                          </div>
												</div>
												{%- if block.settings.show_dynamic_checkout_buttons and product.selected_or_first_available_variant.available -%}
													{{ form | payment_button }}
												{%- endif -%}
											</div>
										{%- endform -%}
									</sht-prd-frm>
								</div>
							</div>
              {%- if block.settings.note != blank -%}
                <div class="product__note rad-s p-xs {% if block.settings.show_dynamic_checkout_buttons %}mt-s{% endif %}">
                  <p class="fs-body-m mb-0">{{- block.settings.note -}}</p>
                </div>
              {%- endif -%}
							{%- if block.settings.show_payment_method and shop.enabled_payment_types -%}
                {%- if product.selected_or_first_available_variant.available -%}
                  <div class="product__payment-method mt-m wb-break-word d-flex fw-wrap gap-s center-xs middle-xs">
                    <span class="fs-body-s">{{- block.settings.payment_heading | escape -}}</span>
                    <ul class="list list-payment d-flex gap-2xs fw-wrap ls-none">
                      {%- for type in shop.enabled_payment_types -%}
                        <li class="list-payment__item d-flex">{{ type | payment_type_svg_tag }}</li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
							{%- endif -%}
						</sht-sticky-prd-info>
          {%- when 'description' -%}
            {% render 'product-description', product: product, block: block %}
          {%- when 'share' -%}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              <sht-share-prd-btn class="d-flex middle-xs gap-xs" data-product-url="{{ product.url | prepend: request.origin }}">
                <div class="fs-heading-s component-heading article__share">{{ "general.share.share" | t }}</div>
                <div class="social-share-list">{% render 'social-share', type: product %}</div>
              </sht-share-prd-btn>
            </div>
          {%- when 'attributes' -%}
            {%- if product.tags.size > 0 -%}
            <div class="product__info product__block-{{- block.type }} mb-m color-{{ settings.product_attribute_color }} {% unless settings.enable_product_attribute_tags %}d-none{% endunless %}" {{ block.shopify_attributes }}>
              <ul class="ls-none d-flex fw-wrap gap-3xs hide-empty f-extra">
                {%- for tag in product.tags -%}
                  <li class="tag"><span class="hide-empty {% if settings.enable_product_attribute_uppercase %}tt-up{% endif %}">{{- tag -}}</span></li>
                {%- endfor -%}
              </ul>
              </div>
            {%- endif -%}
          {%- when 'pickup_availability' -%}
            {%- liquid
              unless block.settings.content_color.alpha == 0.0 or block.settings.content_color == blank
                assign color_content = 'color: ' | append: block.settings.content_color | append: '; --color-normal-text-rgb:' | append: block.settings.content_color.red | append: ',' | append: block.settings.content_color.green | append: ',' | append: block.settings.content_color.blue
              endunless
              unless block.settings.background_color.alpha == 0.0 or block.settings.background_color == blank
                assign background_color = '; background: ' | append: block.settings.background_color
              endunless
						  assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities | where: 'pick_up_enabled', true
            -%}
						{%- if pick_up_availabilities.size > 0 -%}
							<div class="product__info product__block-{{- block.type }} mb-3xl {{ block.settings.show_pickup_time | default: '' | replace: 'true', 'pickup_availability--show-pickup-time' }}" {{ block.shopify_attributes }}>
                <sht-pickup-avail class="pickup-availability d-block no-js-hidden p-relative hide-empty card--border card-animate rad-l p-m" style="{{ color_content }} {{ background_color }}"
                {% if pick_up_availabilities.size > 0 %} available {% endif %}
                data-section="{{ section.id }}"
                data-base-url="{{ shop.url }}{{ routes.root_url }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-has-only-default-variant="{{ product.has_only_default_variant }}" data-show-expected-pickup-time="{{ block.settings.show_pickup_time }}">
                  <template>
                    <sht-pickup-avail-prwv class="d-flex top-xs pickup-availability__preview"> {% render 'icon-check', size: 24 %}
                      <div class="pickup-availability__info">
                        <p>{{- 'products.product.pickup_availability.unavailable' | t -}}</p>
                        <button class="btn">{{- 'products.product.pickup_availability.refresh' | t -}}</button>
                      </div>
                    </sht-pickup-avail-prwv>
                  </template>
                </sht-pickup-avail>
							</div>
						{%- endif -%}
          {%- when 'collapsible_item' -%}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              <sht-accordion class="accordion d-flex fd-column">
                <div class="accordion__item js-accordion-item rad-m border">
                  <button class="region-trigger accordion__header-large accordion__button w-100 ele-focus-visible js-accordion-trigger d-flex middle-xs p-relative c-pointer rad-m {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ block.settings.expand_collapsible }}" aria-controls="collapsible-content-{{- block.id -}}">
                    {%- liquid
                      if block.settings.enable_icon
                        render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.custom_icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
                      endif
                    -%}
                    <span class="fs-heading-s component-heading m-zero flex-1 ta-left">{{- block.settings.heading | default: 'Information' | escape -}}</span>
                    <span class="toggle__icon d-flex middle-xs center-xs p-relative">
                      {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
                    </span>
                  </button>
                  <div class="fs-body-m accordion__content-large o-hidden rte js-accordion-content accordion-content {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-content-{{- block.id -}}" role="region" aria-label="Accordion content {{ block.id }}" tabindex="-1" style="max-height: {{ block.settings.expand_collapsible | replace: true, 'auto' | replace: false, '0' }};">
                    {{- block.settings.text -}}
                    {%- if block.settings.content_from_page != blank -%}
                      {{- block.settings.content_from_page.content -}}
                   {%- endif -%}
                  </div>
                </div>
              </sht-accordion>
            </div>
          {%- when 'popup_content' -%}
            {%- liquid
              assign popup_content_dialog_id = block.id | append: section.id | md5 | truncate: 12, ""
              assign size_popup_content_cta = 'disabled'
              unless block.settings.popup_page == blank and block.settings.text == blank
                assign size_popup_content_cta = ''
              endunless
              if block.settings.button_color != blank and block.settings.button_color.alpha != 0.0
                assign button_color = 'color: ' | append: block.settings.button_color | append: '; --color-button-tertiary-text-rgb:' | append: block.settings.button_color.red | append: ',' | append: block.settings.button_color.green | append: ',' | append: block.settings.button_color.blue
              endif
              assign content_default = 'products.product.popup' | t
            %}
            <div class="product__info product__block-{{- block.type }} mb-m" {{ block.shopify_attributes }}>
              <button class="btn-popup_content btn btn-s btn-tertiary gap-3xs {{ button_uppercase }}" type="button" aria-haspopup="dialog" onclick="window.dialogPopupContent{{ popup_content_dialog_id }}.showModal(this, true)" {{ size_popup_content_cta }} style="{{ button_color }}">
                {% if block.settings.show_icon %}
                  {% render 'icon-loader', icon: block.settings.theme_library, class: 'flex-0-auto' %}
                {% endif %}
                {{- block.settings.heading | default: content_default -}}
              </button>
            </div>
            {% capture popup_content %}
              {% render 'product-popup-content', popup_content_dialog_id: popup_content_dialog_id, block: block %}
            {% endcapture %}
            {%- assign popup_contents = popup_contents | append: popup_content -%}
          {%- when 'custom_text' -%}
            {% liquid
              assign content_color = 'color: inherit'
              unless block.settings.content_color.alpha == 0.0 or block.settings.content_color == blank
                assign content_color = 'color: ' | append: block.settings.content_color | append: '; --color-normal-text-rgb:' | append: block.settings.content_color.red | append: ',' | append: block.settings.content_color.green | append: ',' | append: block.settings.content_color.blue
              endunless
            %}
            {%- if block.settings.text != blank -%}
              <div class="product__info product__block-{{- block.type }} mb-3xl" {{ block.shopify_attributes }} style="{{ content_color }}">
                <sht-read-more class="js-comp-drawer-des {{ block.settings.truncate_text | replace: 'true', 'truncate-text-open' | replace: 'false', 'truncate-text-close' }}">
                  <div class="prd-cp-des__content p-relative o-hidden js-expandable-content" data-expanded="false">
                    <div class="rte fs-body-l hide-empty">{{- block.settings.text -}}</div>
                  </div>
                  <div class="prd-cp-des__btn w-100 ta-left p-relative mt-4">
                    <button type="button" class="btn btn-s btn-tertiary js-expandable-content-btn c-pointer" data-view-more="Show more" data-view-less="Show less">{{ 'general.show_more.label' | t }}</button>
                  </div>
                </sht-read-more>
              </div>
            {%- endif -%}
          {%- when 'custom_liquid' -%}
            <div class="product__info product__block-{{- block.type }} hide-empty mb-3xl" {{ block.shopify_attributes }}>{{- block.settings.custom_liquid_code -}}</div>
          {%- when 'performance_graphs' -%}
            {%- render 'product-performance-graph', product: product, section: section, block: block -%}
          {%- when 'divider' -%}
            {% liquid
              assign bgc_color = 'background: var(--color-normal-text);'
              unless block.settings.divider_color.alpha == 0.0 or block.settings.divider_color == blank
                assign bgc_color = 'background: ' | append: block.settings.divider_color
              endunless
            %}
            <div class="product__info product__divider product__block-{{- block.type }} mb-3xl" {{ block.shopify_attributes }} style="{{ bgc_color }}">
            </div>
          {%- when 'complementary_products' -%}
            {%- render 'product-complementary-product', product: product, section: section, show_rating: block.settings.show_rating, block: block -%}
          {%- when 'icon_with_text' -%}
            <div class="product__info product__block-{{- block.type }} product__block-icon-with-text--{{- block.settings.desktop_block_width }} product__block-icon-with-text--{{- block.settings.mobile_block_width }}" {{ block.shopify_attributes }}>
              {% render 'card-icon-with-text',
                  card_border: true,
                  icon_color: block.settings.custom_icon_color,
                  text_position: section.settings.text_position,
                  theme_library_icon: block.settings.theme_library_icon,
                  icon_source: block.settings.icon_source,
                  icon_image: block.settings.icon_image,
                  custom_code: block.settings.custom_code,
                  icon_size: 'icon-fix-2xl',
                  title: block.settings.heading,
                  description: block.settings.description
                %}
            </div>
          {%- when 'customization_code' -%}
            <div class="product__info product__block-{{- block.type }} product__block-customization-code mb-m" {{ block.shopify_attributes }}>
              {%- render 'customization-code', product: product, section: section, block: block -%}
            </div>
          {%- when 'product_variation' -%}
            {%- render 'product-variation', product: product, section: section, block: block -%}
          {%- when 'product_rating' -%}
            {%- render 'product-rating', product: product -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- render 'main-product-graph-dialog', section: section -%}
<sht-product-recently-viewed data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" class="d-none"></sht-product-recently-viewed>
{{ popup_contents }}
{%- liquid
  if size_guide_block.settings.enable_size_guide
    render 'product-size-guide', size_guide_dialog_id: size_guide_dialog_id, size_guide_block: size_guide_block, size_guide_heading: size_label_heading
  endif
  if section.settings.enable_sticky_add_to_cart
    render 'product-sticky-purchasing-bar', product: product, sticky_product_form_id: sticky_product_form_id, section: section, product_form_id: product_form_id, purchasing_bar_position: section.settings.add_to_cart_sticky_position, add_to_cart_text: add_to_cart_btn_lbl
  endif
  render 'product-google-snippet', product: product
  render 'main-product-gallery-dialog', product: product, rand: section_id, ratio: thumbnails_ratio, object_fit: object_fit, media_background: section.settings.media_background_color 
  render 'js-loader', files: "component-add-to-cart.js" | split: ', '
-%}
{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.media.content",
      "info": "t:general.settings.headers.media.info"
    },
    {
      "type": "select",
      "id": "main_media_ratio",
      "label": "t:sections.multi_columns.settings.media_ratio.label",
      "options": [
        {
          "value": "1/1",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "value": "2/3",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "value": "3/2",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "value": "auto",
          "label": "t:general.settings.image_ratio.options.option_original.label"
        }
      ],
      "default": "2/3"
    },
    {
      "type": "select",
      "id": "thumbnails_ratio",
      "label": "t:general.settings.thumbnails_ratio.label",
      "options": [
        {
          "group": "t:general.settings.option_fill.label",
          "value": "1/1 fill",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "group": "t:general.settings.option_fill.label",
          "value": "2/3 fill",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "group": "t:general.settings.option_fill.label",
          "value": "3/2 fill",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        },
        {
          "group": "t:general.settings.option_fit.label",
          "value": "1/1 fit",
          "label": "t:general.settings.image_ratio.options.option_square.label"
        },
        {
          "group": "t:general.settings.option_fit.label",
          "value": "2/3 fit",
          "label": "t:general.settings.image_ratio.options.option_portrait.label"
        },
        {
          "group": "t:general.settings.option_fit.label",
          "value": "3/2 fit",
          "label": "t:general.settings.image_ratio.options.option_landscape.label"
        }
      ],
      "default": "1/1 fill"
    },
    {
      "type": "checkbox",
      "id": "enable_media_zoom",
      "label": "t:sections.main_product.settings.open_lightbox.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "zoom_images",
      "label": "t:sections.main_product.settings.zoom_images.label",
      "default": true
    },
    {
      "type": "color",
      "id": "media_background_color",
      "label": "t:general.settings.media_background.label",
      "info": "t:general.settings.media_background.info"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.desktop_layout.content"
    },
    {
      "type": "checkbox",
      "id": "enable_fullwidth",
      "label": "t:general.settings.enable_fullwidth_content.label",
      "default": true
    },
    {
      "type": "select",
      "id": "section_ordering",
      "label": "t:general.settings.section_ordering.label",
      "options": [
        {
          "value": "fd-row-md",
          "label": "t:general.settings.section_ordering.option_media_first.label"
        },
        {
          "value": "fd-row-reverse-md",
          "label": "t:general.settings.section_ordering.option_text_first.label"
        }
      ],
      "default": "fd-row-md"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:general.settings.headers.media_layout.label",
      "options": [
        {
          "group": "t:sections.main_product.settings.main_media_with_thumbnails.label",
          "value": "slideshow-left",
          "label": "t:sections.main_product.settings.option_thumbnails_left.label"
        },
        {
          "group": "t:sections.main_product.settings.main_media_with_thumbnails.label",
          "value": "slideshow-right",
          "label": "t:sections.main_product.settings.option_thumbnails_right.label"
        },
        {
          "group": "t:sections.main_product.settings.main_media_with_thumbnails.label",
          "value": "slideshow-below",
          "label": "t:sections.main_product.settings.option_thumbnails_below.label"
        },
        {
          "group": "t:sections.main_product.settings.media_gallery.label",
          "value": "layout-grid-1-column",
          "label": "t:sections.main_product.settings.option_1_column.label"
        },
        {
          "group": "t:sections.main_product.settings.media_gallery.label",
          "value": "layout-grid-2-columns",
          "label": "t:sections.main_product.settings.option_2_columns.label"
        },
        {
          "group": "t:sections.main_product.settings.media_gallery.label",
          "value": "layout-grid-collage",
          "label": "t:sections.main_product.settings.option_collage.label"
        }
      ],
      "default": "layout-grid-collage"
    },
    {
      "type": "select",
      "id": "media_width_on_desktop",
      "label": "t:sections.main_product.settings.media_width.label",
      "options": [
        {
          "value": "1/2",
          "label": "t:general.settings.block_width.options_1_2.label"
        },
        {
          "value": "2/3",
          "label": "2/3"
        }
      ],
      "default": "2/3"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_media",
      "label": "t:sections.main_product.settings.enable_sticky_media.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.mobile_layout.content"
    },
    {
