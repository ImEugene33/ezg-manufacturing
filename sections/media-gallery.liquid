{%- liquid
  assign loading = 'lazy'
  assign decoding = 'async'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign total_items = section.blocks.size
  assign has_items = false
  if total_items > 0
    assign has_items = true
  endif

  assign items_per_view = section.settings.items_per_view | plus: 0
  assign md              = 12.0 | divided_by: items_per_view
  assign layout_mode     = section.settings.layout_mode

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item  = 'js-carousel-item p-relative scrollable-aln-start'

  assign data_step_desktop = items_per_view
  assign data_step_mobile  = ''

  assign image_sizes = '(min-width: 1025px) calc(100vw / ' | append: items_per_view | append: '), (min-width: 768px) calc(100vw / 2), 100vw'
-%}

{%- if has_items -%}
  {%- render 'section-padding-collapse' -%}
  <div
    data-animate="regular-section"
    class="js-animate section color-{{ section.settings.color_scheme }} background"
    data-ui-component="Section Media Gallery"
    role="region"
  >
    <div class="ctnr d-flex fd-column r-gap-4xl">

      {%- if section.settings.heading != blank or section.settings.description != blank -%}
        <div class="section__header">
          <div class="d-flex fd-column gap-xs">
            {%- if section.settings.heading != blank -%}
              <h2 class="{{ section.settings.heading_size }} component-heading">
                {{- section.settings.heading | escape -}}
              </h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
              <div class="rte fs-body-l">{{- section.settings.description -}}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="section__content">

        {%- if layout_mode == 'slider' -%}
          {%- comment -%} ── SLIDESHOW MODE ── {%- endcomment -%}
          <sht-slideshow
            class="rad-l-md o-hidden p-relative d-block"
            data-slideshow-properties='{"sectionId": "{{ section.id }}", "autoplayAccessibilityText": ["{{ 'accessibility.start_slideshow' | t }}","{{ 'accessibility.stop_slideshow' | t }}"], "autoplayText": ["▶","||"], "separatorText": "{{ 'accessibility.of' | t }}", "autoplay": false}'
          >
            <div
              role="region"
              aria-roledescription="Carousel"
              class="slideshow__wrapper js-slideshow p-relative"
            >
              <div
                aria-live="polite"
                aria-atomic="true"
                id="slideShow-{{ section.id }}"
                class="slider-track js-slideshow-items scrollable scrollable-x scrl-bhvr-auto disable-scrollbars w-100 ox-auto d-flex"
              >
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign item_title = block.settings.title
                    assign item_desc  = block.settings.description
                    assign item_image = block.settings.image
                    
                    assign current_item = ''
                    if forloop.first
                      assign current_item = ' js-slideshow-image--current'
                    endif
                  -%}
                  <div
                    {{ block.shopify_attributes }}
                    role="group"
                    aria-roledescription="Slide"
                    aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ total_items }}"
                    class="slider-slide slider-slide-{{ forloop.index }} js-slideshow-item scrollable-aln-start p-relative w-100 h-100 d-flex o-hidden"
                  >
                    <div
                      class="js-slideshow-image w-100 h-100 p-absolute inset{{ current_item }}"
                      data-slideshow-index="{{ forloop.index }}"
                    >
                      {%- if item_image != blank -%}
                        {%- liquid
                          assign img_alt = item_image.alt | default: item_title
                          assign img_tag = item_image | image_url: width: item_image.width | image_tag: widths: '320,550,750,1024,1400,1600,2000', sizes: '100vw', alt: img_alt, class: 'of-cover w-100 h-100', loading: loading, fetchpriority: fetchpriority, decoding: decoding
                        -%}
                        {%- render 'image', image_item: img_tag, image_wrap_classes: 'h-100 w-100', image_classes: 'h-100 w-100 of-cover' -%}
                      {%- else -%}
                        {%- assign placeholder = 'lifestyle-1' | placeholder_svg_tag: 'placeholder w-100 h-100 of-cover' -%}
                        {{- placeholder -}}
                      {%- endif -%}
                    </div>

                    {%- if item_title != blank or item_desc != blank -%}
                      <div class="media-gallery__slide-text p-absolute bottom-0 left-0 w-100 p-m zi-2">
                        {%- if item_title != blank -%}
                          <span class="{{ section.settings.title_size }} media-gallery__title fw-bold d-block">
                            {{- item_title | upcase -}}
                          </span>
                        {%- endif -%}
                        {%- if item_desc != blank -%}
                          <div class="media-gallery__desc fs-body-m mt-2xs rte">{{- item_desc -}}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>

              <div class="slideshow__controls p-absolute bottom-0 zi-3 p-m w-100 no-js-hidden ta-center center-xs">
                <div class="d-inline-flex middle-xs gap-3xs p-3xs rad-p video-controller--light">
                  <button
                    aria-label="{{ 'accessibility.previous_slide' | t }}"
                    aria-controls="slideShow-{{ section.id }}"
                    class="btn btn-plain js-slideshow-prev-btn controls-nav-btn rad-s rtl-flip-x"
                    type="button"
                  >
                    {%- render 'icon-caret-left', class: 'icon icon-control icon-fix-m' -%}
                  </button>
                  <div class="slideshow__counter fs-body-m d-flex center-xs middle-xs">
                    <span class="js-slideshow-current icon-control">1</span>
                    <span class="slideshow__counter--separator js-slideshow-separator icon-control ml-4xs mr-4xs">{{ 'accessibility.of' | t }}</span>
                    <span class="js-slideshow-total icon-control">{{ total_items }}</span>
                  </div>
                  <button
                    aria-label="{{ 'accessibility.next_slide' | t }}"
                    aria-controls="slideShow-{{ section.id }}"
                    class="btn btn-plain js-slideshow-next-btn controls-nav-btn rad-s rtl-flip-x"
                    type="button"
                  >
                    {%- render 'icon-caret-right', class: 'icon icon-control icon-fix-m' -%}
                  </button>
                </div>
              </div>
            </div>
          </sht-slideshow>

        {%- else -%}
          {%- comment -%} ── GRID / CAROUSEL MODE ── {%- endcomment -%}
          <sht-carousel
            class="sht-carousel p-relative d-block"
            data-enable="{{ section.settings.carousel_desktop }}"
            data-enable-mobile="{{ section.settings.carousel_mobile }}"
          >
            <div
              aria-atomic="true"
              class="rw section-content-style o-hidden r-gap-scale-xl {{ carousel_style }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel-md' }}"
              style="--carousel-xs: 12; --carousel-sm: 6; --carousel-md: {{- md -}};"
            >
              {%- for block in section.blocks -%}
                {%- liquid
                  assign item_title = block.settings.title
                  assign item_desc  = block.settings.description
                  assign item_image = block.settings.image
                -%}
                <sht-carousel-itm
                  class="carousel__item clm start-xs {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}"
                  style="--w-xs: 12; --w-sm: 6; --w-md: {{- md -}};"
                  role="group"
                  aria-roledescription="Slide"
                  aria-label="{{ forloop.index }} {{ 'accessibility.of' | t }} {{ total_items }}"
                  data-item-index="{{ forloop.index }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="media-gallery__card d-flex fd-column gap-s">
                    <div class="media-gallery__media rad-m o-hidden p-relative">
                      {%- if item_image != blank -%}
                        {%- liquid
                          assign img_alt = item_image.alt | default: item_title
                          assign img_tag = item_image | image_url: width: item_image.width | image_tag: widths: '320,450,550,750,950,1024,1200,1400,1600,1800,2000', sizes: image_sizes, alt: img_alt, class: 'media of-cover w-100 h-100', loading: loading, fetchpriority: fetchpriority, decoding: decoding
                        -%}
                        {%- render 'image', image_item: img_tag, ratio: section.settings.media_ratio -%}
                      {%- else -%}
                        {%- assign placeholder = 'image' | placeholder_svg_tag: 'placeholder w-100 h-100 of-cover' -%}
                        {%- render 'image', image_item: placeholder, ratio: section.settings.media_ratio -%}
                      {%- endif -%}
                    </div>

                    {%- if item_title != blank or item_desc != blank -%}
                      <div class="d-flex fd-column gap-2xs">
                        {%- if item_title != blank -%}
                          <span class="{{ section.settings.title_size }} media-gallery__title--below fw-bold d-block">
                            {{- item_title | upcase -}}
                          </span>
                        {%- endif -%}
                        {%- if item_desc != blank -%}
                          <div class="fs-body-m rte">{{- item_desc -}}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </sht-carousel-itm>
              {%- endfor -%}
            </div>

            <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3">
              <button
                type="button"
                data-step="{{ data_step_desktop }}"
                data-step-mb="{{ data_step_mobile }}"
                class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x"
                aria-label="{{ 'accessibility.previous_slide' | t }}"
                name="previous"
                disabled
              >
                {%- render 'icon-caret-left' -%}
              </button>
              <button
                type="button"
                data-step="{{ data_step_desktop }}"
                data-step-mb="{{ data_step_mobile }}"
                class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x"
                aria-label="{{ 'accessibility.next_slide' | t }}"
                name="next"
                disabled
              >
                {%- render 'icon-caret-right' -%}
              </button>
            </div>
            <div class="carousel-overflow"></div>

            {%- if settings.show_progress_indicator -%}
              {%- liquid
                assign items_per_view_mobile = 1
                assign show_progress_desktop = false
                assign show_progress_mobile  = false
                if section.settings.carousel_desktop == 'true' and items_per_view < total_items
                  assign show_progress_desktop = true
                endif
                if section.settings.carousel_mobile == 'true' and items_per_view_mobile < total_items
                  assign show_progress_mobile = true
                endif
              -%}
              <div class="slider-scrollbar p-2xl {% if show_progress_desktop %} d-flex-md {% else %} d-none-md {% endif %} {% if show_progress_mobile %} d-flex {% else %} d-none {% endif %}">
                <div
                  class="scrollbar-track js-scrollbar-track"
                  data-thumb-mobile="{{ items_per_view_mobile }}"
                  data-thumb-tablet="{{ items_per_view_mobile }}"
                  data-thumb-desk="{{ items_per_view }}"
                  data-thumb-total="{{ total_items }}"
                  style="--width-thumb-desktop: {{ items_per_view | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%"
                >
                  <div class="scrollbar-thumb js-scrollbar-thumb"></div>
                </div>
              </div>
            {%- endif -%}
          </sht-carousel>
        {%- endif -%}

      </div>
    </div>
  </div>

  <style>
    .media-gallery__slide-text {
      background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 100%);
    }
    .media-gallery__slide-text .media-gallery__title,
    .media-gallery__slide-text .media-gallery__desc {
      color: #fff;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Media Gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "grid_carousel",
      "options": [
        { "value": "grid_carousel", "label": "Grid / Carousel" },
        { "value": "slider",        "label": "Full-width Slider" }
      ]
    },
    {
      "type": "select",
      "id": "carousel_desktop",
      "label": "Desktop — layout",
      "default": "true",
      "options": [
        { "value": "false", "label": "Grid" },
        { "value": "true",  "label": "Carousel" }
      ],
      "visible_if": "{{ section.settings.layout_mode == 'grid_carousel' }}"
    },
    {
      "type": "select",
      "id": "items_per_view",
      "label": "Items per row / view (desktop)",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "visible_if": "{{ section.settings.layout_mode == 'grid_carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_mobile",
      "label": "Mobile — layout",
      "default": "true",
      "options": [
        { "value": "false", "label": "Grid" },
        { "value": "true",  "label": "Carousel" }
      ],
      "visible_if": "{{ section.settings.layout_mode == 'grid_carousel' }}"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Aspect ratio (grid / carousel)",
      "options": [
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "2/3",  "label": "Portrait (2:3)" },
        { "value": "3/2",  "label": "Landscape (3:2)" },
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "auto", "label": "Original" }
      ],
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "fs-heading-s", "label": "Small" },
        { "value": "fs-heading-m", "label": "Medium" },
        { "value": "fs-heading-l", "label": "Large" }
      ],
      "default": "fs-heading-m"
    }
  ],
  "blocks": [
    {
      "type": "media_item",
      "name": "Media item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Gallery"
    }
  ]
}
{% endschema %}
