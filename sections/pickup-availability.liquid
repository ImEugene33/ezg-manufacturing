{%- assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true -%}
  <sht-pickup-avail-prwv class="d-flex top-xs gap-s">
    {% liquid
      assign is_check = false
      for item in product_variant.store_availabilities
        if item.available == true
          assign is_check = true
        endif
      endfor
    %}
    {% if pick_up_availabilities.size > 1 and is_check == true %}
      {% assign closest_location = pick_up_availabilities.first %}
      {% if closest_location.available %}
        <span class="icon d-flex center-sm middle-sm">
          {% render 'icon-check', class: 'icon icon-fix-2xl' %}
        </span>
      {% else %}
        <span class="icon d-flex center-sm middle-sm">
          {% render 'icon-x-mark', class: 'icon icon-fix-2xl' %}
        </span>
      {% endif %}
      <div class="pickup__availability-info">
        {%- if closest_location.available -%}
          <p class="m-zero fs-heading-s component-heading">{{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: closest_location.location.name }}</p>
          <p class="m-zero d-none pickup__availability-time mt-s tt-up fs-heading-xs component-heading">{{ closest_location.pick_up_time }}</p>
          <button class="btn btn-s btn-tertiary mt-m" aria-haspopup="dialog" aria-expanded="false">
              {{ 'products.product.pickup_availability.see_all_locations' | t }}
          </button>
        {%- else -%}
          <p class="m-zero fs-heading-s component-heading">{{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: closest_location.location.name }}</p>
          <button class="btn btn-s btn-tertiary mt-m" aria-haspopup="dialog">
            {{ 'products.product.pickup_availability.see_all_locations' | t }}
          </button>
        {%- endif -%}
      </div>
    {% elsif pick_up_availabilities.size == 1 %}
      {% assign only_location = pick_up_availabilities[0] %}
      {% if only_location.available %}
        <span class="icon d-flex center-sm middle-sm">
          {% render 'icon-check', class: 'icon icon-fix-2xl' %}
        </span>
      {% else %}
        <span class="icon d-flex center-sm middle-sm">
          {% render 'icon-x-mark', class: 'icon icon-fix-2xl' %}
        </span>
      {% endif %}
      <div class="pickup__availability-info">
        {%- if only_location.available -%}
          <p class="m-zero fs-heading-s component-heading">{{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: only_location.location.name }}</p>
          <p class="m-zero d-none pickup__availability-time mt-s tt-up fs-heading-xs component-heading">{{ only_location.pick_up_time }}</p>
          <button class="btn btn-s btn-tertiary mt-m" aria-haspopup="dialog" aria-expanded="false">
              {{ 'products.product.pickup_availability.see_store_information' | t }}
          </button>
        {%- else -%}
          <p class="m-zero fs-heading-s component-heading">{{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: only_location.location.name }}</p>
        {%- endif -%}
      </div>
    {% else %}
      <span class="icon d-flex center-sm middle-sm">
        {% render 'icon-x-mark', class: 'icon icon-fix-2xl' %}
      </span>
      <div class="pickup__availability-info">
        <p class="m-zero fs-heading-s component-heading">{{ 'products.product.pickup_availability.pick_up_unavailable' | t }}</p>
        <button class="btn btn-s btn-tertiary mt-m" aria-haspopup="dialog" aria-expanded="false">
          {{ 'products.product.pickup_availability.see_all_locations' | t }}
        </button>
      </div>
    {%- endif -%}
  </sht-pickup-avail-prwv>
  <sht-drwr-pickup class="drawer inset p-fixed no-focus-visible d-flex end-xs hidden-xs" id="drawerPickupAvailability" hidden tabindex="-1">
    <div class="drawer-overlay js-drawer-overlay p-fixed inset w-100 h-100v"></div>
    <sht-scroll-gradient-overlay class="drawer-wrapper drawer-content-container oy-scroll js-drawer-wrapper o-hidden p-relative zi-2 gradient-overlay--bottom gradient-overlay" role="dialog" aria-modal="true" aria-label="{{ 'products.product.pickup_availability.title' | t }}">
      <div class="drawer__header d-flex middle-xs between-xs gap-xs">
        <h2 class="drawer__heading h5 m-zero js-drawer-heading">{{ 'products.product.pickup_availability.pickup_location' | t }}
          <sup class="fs-body-xs f-extra {{ settings.numbers_style | replace: 'number', '' }}">
            {{ pick_up_availabilities.size }}
          </sup>
        </h2>
        <button class="js-drawer-btn-close drawer__btn-close btn btn-icon btn-icon-l btn-tertiary" type="button" aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon-x-mark' -%}
        </button>
      </div>
      <div class="drawer__body p-relative disable-scrollbars">
        <div class="disable-scrollbars h-100 oy-scroll js-scroll-element">
          {%- unless product_variant.product.has_only_default_variant -%}
            <p class="pickup-availability__variants d-none">
              {%- for product_option in product_variant.product.options_with_values -%}
                {{ product_option.name | escape }}:&nbsp;
                {%- for value in product_option.values -%}
                  {%- if product_option.selected_value == value -%}
                    <span>{{ value | escape }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- unless forloop.last -%},&nbsp;{%- endunless forloop.last -%}
              {%- endfor -%}
            </p>
          {%- endunless -%}
          <ul class="pickup-availability__list ls-none" role="list">
            {%- for availability in pick_up_availabilities -%}
              <li class="pickup-availability__item pt-m pb-m">
                <span class="m-zero d-block fs-body-xl mb-xs">{{ availability.location.name | escape }}</span>
                <div class="d-flex gap-s">
                  {%- if availability.available -%}
                    {% render 'icon-check', class: 'icon icon-fix-2xl' %}
                  {% else %}
                    {% render 'icon-x-mark', class: 'icon icon-fix-2xl' %}
                  {%- endif -%}
                  <div>
                    <p class="pick_up_time d-flex start-xs m-zero mb-4xs fs-body-l">
                      {%- if availability.available -%}
                        {{ 'products.product.pickup_availability.pick_up_available' | t }}
                      {% else %}
                        {{ 'products.product.pickup_availability.pick_up_unavailable' | t }}
                      {%- endif -%}
                    </p>
                    {%- assign address = availability.location.address -%}
                    <div class="fs-body-m">
                      <p class="m-zero">{{ address | format_address }}</p>
                      {%- if address.phone.size > 0 -%}
                        <p class="m-zero">{{ address.phone }}</p>
                      {%- endif -%}
                      {%- if availability.available -%}
                        <p class="d-none pickup__availability-time m-zero mt-s tt-up fs-heading-xs component-heading">{{ availability.pick_up_time }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </sht-scroll-gradient-overlay>
  </sht-drwr-pickup>