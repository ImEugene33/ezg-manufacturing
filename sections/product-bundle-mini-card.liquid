{%- liquid
  assign product_variant = product.selected_or_first_available_variant

  assign product_title = product_variant.title
  if product.has_only_default_variant
    assign product_title = ''
  endif

  assign ratio = settings.product_card_image_ratio | replace: 'auto', product.featured_media.aspect_ratio
  assign section_id = section.id | md5 | truncate: 12, ""
  assign random_number =  "now" | date: "%N" | append: section_id | append: product.id

  assign product_image_id =  random_number | prepend: 'cardProductImage-'
  assign product_link_class =  random_number | prepend: 'js-card-product-link-'
  assign image_width = '320, 450, 550, 750, 950, 1024, 1200, 1400, 1600, 1800, 2000'

  assign sizes = '(min-width: 769px) calc(' | append: settings.container_max_width | append: 'px / 4), (min-width: 459px) calc(100vw/2), 100vw'
  assign product_placeholder = 'product-apparel-1' | placeholder_svg_tag: 'placeholder w-100 h-100 media d-block'
  assign product_image = product_placeholder

  assign product_image_classes = 'h-100 media d-block ' | append: settings.product_card_image_type
  assign product_image = product_variant.featured_media | image_url: width: product_variant.featured_media.width | image_tag: widths: image_width, sizes: sizes, alt: product.title, class: product_image_classes, id: product_image_id
  if product_variant.featured_media == nil
    assign product_image = product.featured_media | image_url: width: product_variant.featured_media.width | image_tag: widths: image_width, sizes: sizes, alt: product.title, class: product_image_classes, id: product_image_id
  endif

  if product.has_only_default_variant
    assign product_image = product.featured_media | image_url: width: product_variant.featured_media.width | image_tag: widths: image_width, sizes: sizes, alt: product.title, class: product_image_classes, id: product_image_id
  endif
%}

<sht-carousel-itm data-product-id="{{ product_variant.id }}" class="clm carousel__item d-flex js-carousel-item p-relative scrollable-aln-start bundle-item" style="--w-xs: 12; --w-sm: 6;--w-md: 4;" role="group" aria-roledescription="slide" aria-label="{{ 'accessibility.slide' | t }} {{ 'accessibility.of' | t }}" data-item-index="">
  <div class="background mini-card card--border mini-card-component mini-card-bundle p-s rad-m o-hidden w-100 h-100  js-product-card-block">
    <a href="{{- product_variant.url | within: collection | default: '#' -}}" {{ product_variant.url | default: 'tabindex="-1"' | replace: product_variant.url , '' }} class="d-block w-100 h-100 p-absolute top-0 left-0 zi-1 {{ product_link_class }}" aria-label="{{ product.title | escape }}"></a>
    <div class="mini-card__product-media p-relative rad-s h-fit-content o-hidden" style="background-color: {{ settings.product_card_image_background }};">
      {% render 'image', image_item: product_image, ratio: ratio %}
    </div>
    <div class="d-flex gap-xs">
      <div class="mini-card__product-info flex-1">
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <span class="mini-card--vendor fs-body-s d-block mb-2xs color-text-80 js-mini-card-vendor f-extra">{{- product.vendor -}}</span>

        <h3 class="fs-heading-s component-heading mb-xs">
          <a href="{{- product.url | within: collection -}}" class="td-none ele-focus-visible {{ product_link_class }}">{{- product.title -}}</a>
        </h3>

        <span class="fs-body-s d-block color-text-60 hide-empty">{{- product_title -}}</span>

        {%- liquid
          render 'product-price-bundle' product: product_variant, target: product_variant, price_class: 'd-block mb-2xs mini-card--price js-mini-card-price', price_style: 'fs-body-xl', bundle_price: true
        -%}
      </div>

      <button class="btn btn-icon btn-icon-m btn-tertiary js-remove-product-bundle" type="button" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-x-mark' %}
      </button>
    </div>
  </div>
</sht-carousel-itm>
{% schema %}
{
  "name": "Mini card product bundle",
  "tag": "section",
  "class": "section-mini-card-product-bundle"
}
{% endschema %}
