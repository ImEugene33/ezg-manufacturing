{%- liquid
  assign xs = 12.0 | divided_by: section.settings.columns_per_row_mobile
  assign md = 12.0 | divided_by: section.settings.columns_per_row_desktop

  assign items_per_row_on_desktop = section.settings.columns_per_row_desktop | plus: 0
  assign items_per_row_on_mobile = section.settings.columns_per_row_mobile | plus: 0

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item = 'js-carousel-item p-relative scrollable-aln-start'

  assign data_step_desktop = items_per_row_on_desktop
  assign data_step_mobile = items_per_row_on_mobile

  if settings.carousel_slide == 'single_item'
    assign data_step_desktop = 1
    assign data_step_mobile = 1
  endif

  assign index = 1
  assign index_accessibility = 0
-%}
{%- render 'section-padding-collapse' -%}

<sht-prd-recom data-animate="regular-section" class="js-animate section section--vertical o-hidden color-{{- section.settings.color_scheme }} background" data-ui-component="Product Recommendation Section" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
  {% if recommendations.performed and recommendations.products_count > 0 %}
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section__header">
        <div class="ctnr">
          {% render 'section-content-horizontal',
            section: section,
            class: 'section__text--horizontal p-relative zi-1',
            heading_size: section.settings.heading_size
          %}
        </div>
      </div>
    {%- endif -%}
    <div class="section__content">
      <div class="ctnr">
        <sht-carousel class="sht-carousel p-relative d-block" data-enable="{{ section.settings.carousel_desktop }}" data-enable-mobile="{{ section.settings.carousel_mobile }}">
          <div aria-atomic="true" class="rw o-hidden section-content-style r-gap-scale-xl {{ carousel_style }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel-md' }}" style="--carousel-xs:{{- xs -}}; --carousel-sm:{{- xs -}}; --carousel-md: {{- md -}};">
            {% for recommendation in recommendations.products limit: section.settings.products_to_show %}
              {% liquid
                assign total_items = section.settings.products_to_show
                assign index = index | plus: 1
                assign index_accessibility = index_accessibility | plus: 1
                if index == 5
                  assign index = 1
                endif
              %}
              <sht-carousel-itm class="carousel__item clm {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}"
              style="--w-xs:{{- xs -}};--w-md: {{- md -}};" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ index_accessibility }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ index_accessibility }}">
                {% render 'card-product-block',
                  product: recommendation,
                  button_compare: false,
                  show_quick_view: section.settings.show_quick_view,
                  quick_buy: section.settings.quick_buy,
                  image_loading: 'lazy',
                  fetchpriority: 'low'
                %}
              </sht-carousel-itm>
            {%- endfor %}
          </div>
          <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3">
            <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-caret-left' %}</button>
            <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="{{ data_step_mobile }}" class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-caret-right' %}</button>
          </div>
          <div class="carousel-overflow {{ section.settings.carousel_mobile | replace: 'true', '' | replace: 'false', 'd-none' }} {{ section.settings.carousel_desktop | replace: 'true', 'd-block-md' | replace: 'false', 'd-none-md' }}"></div>

          {% if settings.show_progress_indicator %}
            {% liquid
              assign show_on_desktop = false
              assign show_on_mobile = false
              if section.settings.carousel_desktop == 'true' and items_per_row_on_desktop < total_items
                  assign show_on_desktop = true
              endif
              if section.settings.carousel_mobile == 'true' and items_per_row_on_mobile < total_items
                  assign show_on_mobile = true
              endif
            %}
            <div class="slider-scrollbar p-2xl {% if show_on_desktop %} d-flex-md {% else %} d-none-md {% endif %} {% if show_on_mobile %} d-flex {% else %} d-none {% endif %}">
              <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="{{ items_per_row_on_mobile }}" data-thumb-tablet="{{ items_per_row_on_mobile }}" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                <div class="scrollbar-thumb js-scrollbar-thumb"></div>
              </div>
            </div>
          {% endif %}
        </sht-carousel>
      </div>
    </div>
  {% else %}
    <div class="section-no-item"></div>
  {% endif %}
</sht-prd-recom>


{% schema %}
{
  "name": "t:sections.product_recommendation.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.settings.headers.general.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.product_recommendation.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.settings.color_schemes.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.settings.section_heading.label",
      "default": "Product recommendation"
    },
    {
      "type": "select",
      "label": "t:general.settings.heading_size.label",
      "id": "heading_size",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        {
          "value": "h3-regular",
          "label": "t:general.settings.heading_size.options.extra_large.label"
        },
        {
          "value": "h4",
          "label": "t:general.settings.heading_size.options.large.label"
        },
        {
          "value": "h5",
          "label": "t:general.settings.heading_size.options.regular.label"
        },
        {
          "value": "h6",
          "label": "t:general.settings.heading_size.options.small.label"
        }
      ],
      "default": "h3-regular"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:general.settings.section_description.label"
    },
    {
      "type": "range",
      "max": 10,
      "min": 1,
      "step": 1,
      "default": 10,
      "id": "products_to_show",
      "label": "t:general.settings.max_items_to_show.label"
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.desktop_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_desktop",
      "label": "t:general.settings.list_style.label",
      "default": "true",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_per_row_desktop",
      "label": "t:general.settings.columns_per_row.label",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:general.settings.columns_per_row.options_3.label"
        },
        {
          "value": "4",
          "label": "t:general.settings.columns_per_row.options_4.label"
        },
        {
          "value": "5",
          "label": "t:general.settings.columns_per_row.options_5.label"
        },
        {
          "value": "6",
          "label": "t:general.settings.columns_per_row.options_6.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.mobile_layout.content"
    },
    {
      "type": "select",
      "id": "carousel_mobile",
      "label": "t:general.settings.list_style.label",
      "default": "true",
      "options": [
        {
          "value": "false",
          "label": "t:general.settings.option_grid.label"
        },
        {
          "value": "true",
          "label": "t:general.settings.option_carousel.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_per_row_mobile",
      "label": "t:general.settings.columns_per_row.label",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.settings.headers.quick_shop.content"
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "t:general.settings.show_quick_view.label",
      "info": "t:general.settings.show_quick_view.info",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_buy",
      "label": "t:general.settings.quick_buy.label",
      "info": "t:general.settings.quick_buy.info",
      "options": [
        {
          "value": "not_use",
          "label": "t:general.settings.not_use.label"
        },
        {
          "value": "standard",
          "label": "t:general.settings.standard.label"
        },
        {
          "value": "bulk",
          "label": "t:general.settings.bulk.label"
        }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "t:general.verdor.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "t:general.title.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product_type",
      "name": "t:general.product_type.name",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "color_product_type",
          "label": "t:general.settings.custom_color.label"
        }
      ]
    },
    {
      "type": "price",
      "name": "t:general.price.name",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "color_product_price",
          "label": "t:general.settings.custon_price_color.label"
        }
      ]
    },
    {
      "type": "variants",
      "name": "t:general.variants.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.paragrap_3.label"
        },
        {
          "type": "text",
          "id": "card_product_variants",
          "label": "t:general.settings.product_variants.label",
          "default": "Material, Size"
        }
      ]
    },
    {
      "type": "product_attributes",
      "name": "t:general.product_attributes.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.paragrap_2.label"
        }
      ]
    },
    {
      "type": "product_rating",
      "name": "t:general.product_rating.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:general.settings.rating_paragrap.label"
        }
      ]
    }
  ]
}
{% endschema %}