{%- if section.blocks.size > 0 -%}
{%- liquid
  assign running_speed = section.settings.rotating_speed
  assign text_size = section.settings.item_size | replace: 'extra', 'headline' | replace: 'large', 'h1' | replace: 'regular', 'h2' | replace: 'small', 'h3'
  assign image_size = section.settings.item_size | replace: 'extra', 'img-7xl' | replace: 'large', 'img-6xl' | replace: 'regular', 'img-5xl' | replace: 'small', 'img-4xl'
  assign icon_size = 'icon ' | append: section.settings.item_size | replace: 'extra', 'icon-scale-6xl' | replace: 'large', 'icon-scale-5xl' | replace: 'regular', 'icon-scale-4xl' | replace: 'small', 'icon-scale-3xl'

  assign loading = "lazy"
  assign decoding = "async"
  assign fetchpriority = "auto"

  if section.index == 1
    assign loading = "eager"
    assign fetchpriority = "high"
  endif

  assign loop = 5
  case section.blocks.size
    when 1, 2
      assign loop = 12
    when 3, 4
      assign loop = 10
    when 5, 6
      assign loop = 7
  endcase
-%}
<sht-marquee-section data-animate="regular-section" class="js-animate marquee-section section-running-content o-hidden w-100 p-relative d-block color-{{- section.settings.color_scheme }} background" data-ui-component="Running Content Section" role="region" aria-labelledby="sectionRunningContentSpeed-{{ running_speed }}" normal-speed="{{ running_speed }}" hover-interaction="{{ section.settings.hover_interaction }}" slow-speed="1" direction="{{ section.settings.running_direction }}" size="{{ section.blocks.size }}">
  {% capture marquee_list %}
    <div aria-live="polite" aria-atomic="true" class="js-marquee-list d-flex fw-nowrap flex-auto">
      {% for block in section.blocks %}
        <div role="group" class="marquee-item js-marquee-item d-flex flex-auto">
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- liquid
                assign content_color_style = ''
                unless block.settings.color_text.alpha == 0.0 or block.settings.color_text == blank
                  assign content_color_style = 'color:' | append: block.settings.color_text
                endunless
              -%}
              <div class="running-content-item running-content-{{ block.type }} ta-center d-flex fd-column center-xs middle-xs {{ text_size }} m-zero hide-empty pl-scale-2xl" style="{{ content_color_style }}" {{ block.shopify_attributes }}>
                {{- block.settings.promotion_text -}}
              </div>
            {%- when 'image' -%}
              {%- liquid
                assign media = 'blog-apparel-1' | placeholder_svg_tag: 'placeholder media of-cover h-100 w-100 js-image-lazy'
                assign image_alt = block.settings.image.alt | default: block.settings.image | split: '/' | last
                assign media = block.settings.image | image_url: width: block.settings.image.width | image_tag: widths: '120, 240, 350', sizes: '350px', alt: image_alt, class: 'media of-cover h-100 w-100', loading: loading, fetchpriority: fetchpriority, decoding: decoding
                assign media_ratio = section.settings.image_ratio
                if section.settings.image_ratio == 'auto' and block.settings.image != blank
                  assign media_ratio = block.settings.image.aspect_ratio
                endif
              -%}
              <div class="running-content-item running-content-{{ block.type }} ta-center d-flex center-xs middle-xs {{ image_size }} pl-scale-2xl" {{ block.shopify_attributes }} >
                {%- render 'image', image_item: media, ratio: media_ratio , image_wrap_classes: "h-100 marquee-item--image", image_classes: "h-100 w-100" -%}
              </div>
            {%- when 'icon' -%}
              {%- liquid
                assign icon_color = ''
                unless block.settings.color_content.alpha == 0.0 or block.settings.color_content == blank
                  assign icon_color = 'color: ' | append: block.settings.color_content
                endunless
              -%}
              <div class="running-content-item running-content-{{ block.type }} ta-center d-flex center-xs middle-xs pl-scale-2xl" {{ block.shopify_attributes }}>
                <div class="marquee-item--icon" style="{{ icon_color }}">
                {%- liquid
                  assign icon_source = block.settings.icon_source
                  if icon_source == 'theme_library'
                    render 'icon-loader', icon: block.settings.options_icon, class: icon_size
                  endif
                -%}
                {%- if block.settings.custom_code != '' and icon_source != 'theme_library' -%}
                  <div class="custom-icon {{ section.settings.item_size }}">
                    {{- block.settings.custom_code -}}
                  </div>
                {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        </div>
      {% endfor %}
    </div>
  {% endcapture %}
  <div class="marquee-container d-flex js-marquee-container" loop-marquee="{{ loop }}">
    {%- for i in (1..loop) -%}
      <div class="d-flex fw-nowrap fs-0 marquee__items js-marquee-items middle-xs">
        {{ marquee_list }}
      </div>
    {%- endfor -%}
  </div>
</sht-marquee-section>
{%- endif -%}

