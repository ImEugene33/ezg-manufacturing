    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:general.settings.end_date.label",
      "info": "t:general.settings.end_date.info",
      "visible_if": "{{ section.settings.enable_countdown == true }}"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:general.settings.end_time.label",
      "info": "t:general.settings.end_time.info",
      "visible_if": "{{ section.settings.enable_countdown == true }}"
    },
    {
      "type": "richtext",
      "id": "end_text",
      "label": "t:general.settings.end_text.label",
      "info": "t:general.settings.end_text.info",
      "default": "<p>This event is finished</p>",
      "visible_if": "{{ section.settings.enable_countdown == true }}"
    },
    {
      "type": "color",
      "id": "countdown_background",
      "label": "t:general.settings.custom_background.label",
      "visible_if": "{{ section.settings.enable_countdown == true }}"
    },
    {
      "type": "color",
      "id": "countdown_number_color",
      "label": "t:general.settings.custom_number.label",
      "visible_if": "{{ section.settings.enable_countdown == true }}"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.running_image_link.blocks.image_link.name",
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.headers.general.content"
        },
        {
          "type": "url",
          "label": "t:general.settings.link.label",
          "id": "link"
        },
        {
          "type": "select",
          "id": "item_size",
          "label": "t:general.settings.item_size.label",
          "default": "large",
          "options": [
            {
              "value": "small",
              "label": "t:general.settings.option_small.label"
            },
            {
              "value": "regular",
              "label": "t:general.settings.option_regular.label"
            },
            {
              "value": "large",
              "label": "t:general.settings.option_large.label"
            }
          ]
        },
        {
          "type": "header",
          "content": "t:sections.header.settings.content.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:general.settings.background_image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.settings.heading.label",
          "default": "Image heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.settings.description.label",
          "default": "<p>Highlight your new collection or share content related to this image</p>"
        },
        {
          "type": "header",
          "content": "t:general.settings.headers.overlay_color.content"
        },
        {
          "type": "range",
          "max": 90,
          "min": 0,
          "step": 10,
          "default": 30,
          "id": "overlay_opacity",
          "label": "t:general.settings.overlay_opacity.label",
          "unit": "%"
        },
        {
          "type": "color",
          "id": "block_mask_overlay_color",
          "label": "t:general.settings.custom_mask_overlay_opacity.label",
          "visible_if": "{{ block.settings.overlay_opacity != 0 }}"
        },
        {
          "type": "color",
          "id": "block_content_overlay_color",
          "label": "t:general.settings.custom_content_overlay_opacity.label"
        }
      ]
    },
    {
      "type": "product",
      "name": "t:sections.running_image_link.blocks.product_link.name",
      "settings": [
        {
          "type": "header",
          "content": "t:general.settings.headers.general.content"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:general.settings.product.label"
        },
        {
          "type": "select",
          "id": "item_size",
          "label": "t:general.settings.item_size.label",
          "default": "large",
          "options": [
            {
              "value": "small",
              "label": "t:general.settings.option_small.label"
            },
            {
              "value": "regular",
              "label": "t:general.settings.option_regular.label"
            },
            {
              "value": "large",
              "label": "t:general.settings.option_large.label"
            }
          ]
        },
        {
          "type": "header",
          "content": "t:sections.header.settings.content.content"
        },
        {
          "type": "checkbox",
          "id": "show_product_title",
          "label": "t:general.settings.show_product_title.label",
          "default": true
        },
        {
          "type": "checkbox",
