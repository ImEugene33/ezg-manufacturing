{%- liquid
  assign md = 12.0 | divided_by: section.settings.columns_per_row
  assign items_per_row_on_desktop = section.settings.columns_per_row | plus: 0
  assign data_step_desktop = items_per_row_on_desktop

  assign carousel_style = 'js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars'
  assign carousel_item = 'js-carousel-item p-relative scrollable-aln-start'

  if settings.carousel_slide == 'single_item'
    assign data_step_desktop = 1
  endif
-%}
{%- render 'section-padding-collapse' -%}
{%- if section.blocks.size > 0 or section.settings.heading != blank or section.settings.description != blank or section.settings.label != blank -%}
  <div data-animate="regular-section" class="js-animate section section--vertical o-hidden color-{{- section.settings.color_scheme }} background" data-ui-component="Section Testimonials">
    {%- if section.settings.heading != blank or section.settings.description != blank or section.settings.label != blank -%}
      <div class="section__header">
        <div class="ctnr">
          {% render 'section-content-horizontal',
          class: 'section__text--horizontal p-relative zi-1',
          heading_size: section.settings.heading_size,
          button_main_text: section.settings.label,
          button_main_link: section.settings.link,
          button_main_style: 'btn-s btn-tertiary',
          enable_button: true,
          enable_countdown: false
        %}
        </div>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="section__content">
        <div class="ctnr">
          <sht-carousel class="sht-carousel p-relative d-block">
            <div aria-atomic="true" class="rw section-content-style o-hidden r-gap-scale-xl {{ carousel_style }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel-md' }}" style="--carousel-xs: 12; --carousel-sm: 6;--carousel-md: {{- md -}};">
              {%- assign index_accessibility = 1 -%}
              {% for block in section.blocks %}
                {% liquid
                  assign gap_class = 'gap-4xs'
                  if block.settings.icon_image != blank
                    assign gap_class = 'gap-s'
                    assign media = block.settings.icon_image | image_url: width: block.settings.icon_image.width | image_tag: widths: '120', sizes: '100vw', alt: block.settings.author_name, class: 'media of-cover rad-s d-block border'
                  endif
                %}
                {%- liquid assign total_items = forloop.length | plus: 0 -%}
                {% if block.settings.icon_image != blank or block.settings.review_content != blank or block.settings.author_name != blank or block.settings.author_description != blank %}
                  <sht-carousel-itm class="carousel__item clm d-flex {{ carousel_item }} {{ section.settings.carousel_mobile | replace: 'false', '' | replace: 'true', 'carousel__item-xs' }} {{ section.settings.carousel_desktop | replace: 'false', '' | replace: 'true', 'carousel__item-md' }}" style="--w-xs: 12; --w-sm: 6; --w-md: {{- md -}};" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ index_accessibility }} {{ 'accessibility.of' | t }} {{ total_items }}" data-item-index="{{ index_accessibility }}" {{ block.shopify_attributes }}>
                    <div class="card--border card-animate d-flex fd-column p-m rad-m w-100 {{ section.settings.content_alignment }}">
                      <div class="d-flex fd-column flex-1 mb-m {{ section.settings.content_alignment }}">
                        <div class="stars d-flex gap-4xs mb-m {{ section.settings.show_rating | default: 'd-none-important' | replace: 'true', '' }}" style="--color-star: {{- section.settings.color_rating -}}">
                          {% for i in (1..5) %}
                            {% assign star_class = 'color-text-30 icon icon-fix-m' %}
                            {% if i <= block.settings.rating %}
                              {% assign star_class = 'star-filled icon icon-fix-m' %}
                            {% endif %}
                            {% render 'icon-star-solid', class: star_class %}
                          {% endfor %}
                        </div>
                        <div class="rte hide-empty">{{- block.settings.review_content -}}</div>
                      </div>
                      <div class="d-flex {{ gap_class }}">
                        {% if block.settings.icon_image != blank %}
                          <div class="ttmnl-avatar-{{ section.settings.image_size }} mt-3xs">
                            {% render 'image', image_item: media, image_classes: 'h-100 w-100', ratio: section.settings.image_ratio %}
                          </div>
                        {% else %}
                          {% render 'icon-minus', class: 'icon icon-fix-2xl' %}
                        {% endif %}
                        <div class="d-flex fd-column gap-4xs flex-1">
                          <h3 class="{{ section.settings.heading_size_item }} hide-empty">{{- block.settings.author_name | escape -}}</h3>
                          <p class="fs-body-s m-zero color-text-60 hide-empty">{{- block.settings.author_description | escape -}}</p>
                        </div>
                      </div>
                    </div>
                  </sht-carousel-itm>
                {% endif %}
                {%- assign index_accessibility = index_accessibility | plus: 1 -%}
              {% endfor %}
            </div>
            <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3">
              <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="1" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-caret-left' %}</button>
              <button type="button" data-step="{{ data_step_desktop }}" data-step-mb="1" class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-caret-right' %}</button>
            </div>

            <div class="carousel-overflow {{ section.settings.carousel_mobile | replace: 'true', '' | replace: 'false', 'd-none' }} {{ section.settings.carousel_desktop | replace: 'true', 'd-block-md' | replace: 'false', 'd-none-md' }}"></div>

            {% if settings.show_progress_indicator %}
              {% liquid
                assign show_on_desktop = false
                assign show_on_mobile = false
                if section.settings.carousel_desktop == 'true' and items_per_row_on_desktop < total_items
                    assign show_on_desktop = true
                endif
                if section.settings.carousel_mobile == 'true' and 1 < total_items
                    assign show_on_mobile = true
                endif
              %}
              <div class="slider-scrollbar p-2xl {% if show_on_desktop %} d-flex-md {% else %} d-none-md {% endif %} {% if show_on_mobile %} d-flex {% else %} d-none {% endif %}">
                <div class="scrollbar-track js-scrollbar-track" data-thumb-mobile="1" data-thumb-tablet="2" data-thumb-desk="{{ items_per_row_on_desktop }}" data-thumb-total="{{ total_items }}" style="--width-thumb-desktop: {{ items_per_row_on_desktop | times: 100.0 | divided_by: total_items }}%; --width-thumb-tablet: {{ 2 | times: 100.0 | divided_by: total_items }}%; --width-thumb-mobile: {{ 1 | times: 100.0 | divided_by: total_items }}%">
                  <div class="scrollbar-thumb js-scrollbar-thumb"></div>
                </div>
              </div>
            {% endif %}
          </sht-carousel>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
  {
    "name": "t:sections.testimonials.name",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
      "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "t:general.settings.headers.general.content"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:general.settings.color_schemes.label",
        "default": "scheme-1"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:general.settings.section_heading.label",
        "default": "Our customers"
      },
      {
        "type": "select",
        "label": "t:general.settings.heading_size.label",
        "id": "heading_size",
        "visible_if": "{{ section.settings.heading != blank }}",
        "options": [
          {
            "value": "h3-regular",
            "label": "t:general.settings.heading_size.options.extra_large.label"
          },
          {
            "value": "h4",
            "label": "t:general.settings.heading_size.options.large.label"
          },
          {
            "value": "h5",
            "label": "t:general.settings.heading_size.options.regular.label"
          },
          {
            "value": "h6",
            "label": "t:general.settings.heading_size.options.small.label"
          }
        ],
        "default": "h5"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "t:general.settings.section_description.label"
      },
      {
        "type": "header",
        "content": "t:sections.testimonials.settings.headers.customer_review_item.content"
      },
      {
        "type": "select",
        "label": "t:general.settings.author_name_size.label",
        "id": "heading_size_item",
        "options": [
          {
            "value": "f-body fs-body-l",
            "label": "t:general.settings.heading_size.options.regular.label"
          },
          {
            "value": "f-body fs-body-xl",
            "label": "t:general.settings.heading_size.options.large.label"
          }
        ],
        "default": "f-body fs-body-xl"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "t:general.settings.content_alignment.label",
        "options": [
          {
            "value": "ta-left top-xs",
            "label": "t:general.settings.option_left.label"
          },
          {
            "value": "ta-center middle-xs",
            "label": "t:general.settings.option_center.label"
          },
          {
            "value": "ta-right bottom-xs",
            "label": "t:general.settings.option_right.label"
          }
        ],
        "default": "ta-center middle-xs"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "t:general.settings.image_ratio.label",
        "default": "1/1",
        "options": [
          {
            "value": "1/1",
            "label": "t:general.settings.image_ratio.options.option_square.label"
          },
          {
            "value": "2/3",
            "label": "t:general.settings.image_ratio.options.option_portrait.label"
          },
          {
            "value": "3/2",
            "label": "t:general.settings.image_ratio.options.option_landscape.label"
          },
          {
            "value": "auto",
            "label": "t:general.settings.image_ratio.options.option_original.label"
          }
        ]
      },
      {
        "type": "select",
        "label": "t:general.settings.image_size.label",
        "id": "image_size",
        "options": [
          {
            "value": "small",
            "label": "t:general.settings.option_small.label"
          },
          {
            "value": "regular",
            "label": "t:general.settings.option_regular.label"
          },
          {
            "value": "large",
            "label": "t:general.settings.option_large.label"
          }
        ],
        "default": "small"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.rating.content"
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "t:general.settings.show_star_rating.label",
        "default": true
      },
      {
        "type": "color",
        "id": "color_rating",
        "label": "t:general.settings.star_rating.label",
        "default": "#FFB82D",
        "visible_if": "{{ section.settings.show_rating == true }}"
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.desktop_layout.content"
      },
      {
        "type": "select",
        "id": "carousel_desktop",
        "label": "t:general.settings.list_style.label",
        "default": "true",
        "options": [
          {
            "value": "false",
            "label": "t:general.settings.option_grid.label"
          },
          {
            "value": "true",
            "label": "t:general.settings.option_carousel.label"
          }
        ]
      },
      {
        "type": "select",
        "id": "columns_per_row",
        "label": "t:general.settings.columns_per_row.label",
        "default": "4",
        "options": [
          {
            "value": "3",
            "label": "t:general.settings.columns_per_row.options_3.label"
          },
          {
            "value": "4",
            "label": "t:general.settings.columns_per_row.options_4.label"
          },
          {
            "value": "5",
            "label": "t:general.settings.columns_per_row.options_5.label"
          },
          {
            "value": "6",
            "label": "t:general.settings.columns_per_row.options_6.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.mobile_layout.content"
      },
      {
        "type": "select",
        "id": "carousel_mobile",
        "label": "t:general.settings.list_style.label",
        "default": "true",
        "options": [
          {
            "value": "false",
            "label": "t:general.settings.option_grid.label"
          },
          {
            "value": "true",
            "label": "t:general.settings.option_carousel.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "t:general.settings.headers.button.content"
      },
      {
        "type": "text",
        "id": "label",
        "label": "t:general.settings.button_label.label",
        "info": "t:general.settings.hide_if_empty.info",
        "default": "Explore more"
      },
      {
        "type": "url",
        "id": "link",
        "label": "t:general.settings.link.label",
        "visible_if": "{{ section.settings.label != blank }}"
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "t:sections.testimonials.blocks.testimonial.name",
        "settings": [
          {
            "type": "header",
            "content": "t:general.settings.headers.avatar_logo.content"
          },
          {
            "type": "image_picker",
            "id": "icon_image",
            "label": "t:general.settings.image.label"
          },
          {
            "type": "header",
            "content": "t:general.settings.headers.quote_content.content"
          },
          {
            "type": "range",
            "id": "rating",
            "label": "t:general.settings.star_rating.label",
            "default": 5,
            "min": 1,
            "max": 5,
            "step": 1
          },
          {
            "type": "richtext",
            "id": "review_content",
            "label": "t:general.settings.review_content.label",
            "default": "<p>Showcase your happy customers' stories</p>"
          },
          {
            "type": "text",
            "id": "author_name",
            "label": "t:general.settings.author_brand_name.label",
            "default": "A happy customer"
          },
          {
            "type": "text",
            "id": "author_description",
            "label": "t:general.settings.author_brand_description.label",
            "default": "Customer's description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.testimonials.name",
        "blocks": [
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          }
        ]
      }
    ]
  }
  {% endschema %}