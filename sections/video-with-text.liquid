{%- liquid
  assign content_width = section.settings.media_width | replace: '8', '4' | prepend: '--w-xs: 12; --w-md: '
  assign media_width = section.settings.media_width | prepend: '--w-xs: 12; --w-md: '
  assign alignment_class = section.settings.desktop_content_alignment | append: ' ' | append: section.settings.mobile_content_alignment
  assign default_thumbnail_image     = 'hero-apparel-1' | placeholder_svg_tag: 'd-block placeholder js-image-lazy media of-cover'

  assign media_ratio = section.settings.media_ratio
  if media_ratio == 'auto'
    if section.settings.video_source == 'video_external'
      assign media_ratio = 1.778
    else
      assign media_ratio = section.settings.video_hosted.media_ratio
    endif
  endif
-%}
  {%- render 'section-padding-collapse' -%}
  <div data-animate="regular-section" id="section-{{ section.id }}" data-ui-component="Section Video With Text" role="region" aria-labelledby="sectionHeading-{{ section.id | md5 | truncate: 12, "" }}"
  class="js-animate section video-with-text o-hidden background color-{{- section.settings.color_scheme }}"
  >
    <div class="ctnr">
      <div class="rw media-with-text__grid center-xs fd-row-md {{ section.settings.content_ordering }} {{ section.settings.mobile_layout -}}">
      {%- if section.blocks.size > 0 -%}
        <div class="clm" style="{{ content_width }}">
            <div class="media-with-text__content">
              {%- render 'section-content-text-icon',
              alignment_class: alignment_class
              -%}
            </div>
        </div>
      {%- endif -%}
      <div class="clm" style="{{ media_width }}">
        <div class="video-with-text__media">
          <sht-video class="p-relative">
            <div class=" inset o-hidden rad-m w-100 h-100">
              {%- render 'video',
              src: section.settings.video_source,
              media_ratio: media_ratio,
              video_thumbnail: section.settings.video_thumbnail_image,
              video_hosted: section.settings.video_hosted,
              external_video_link: section.settings.video_url,
              play_icon: true,
              mute: section.settings.enable_video_mute,
              default_thumbnail_image: default_thumbnail_image,
              video_class: 'image-animate'
              -%}
            </div>
          </sht-video>
        </div>
      </div>
    </div>
    </div>
  </div>
