<sht-dialog class="sht-dialog gradient-overlay--dialog gradient-overlay o-hidden no-focus-visible bottom-xs end-xs p-fixed left-0 top-0 h-100 w-100 zi-10 hidden-xs" id="dialogAnnouncementPopup{{ popup_content_dialog_id }}" hidden tabindex="-1">
  <div class="sht-dialog-overlay js-dialog-overlay"></div>
  <div class="js-dialog-container drawer-content-container js-scroll-element dialog popup-dialog cursor-initial disable-scrollbars anmb-dialog" role="dialog" aria-labelledby="dialogTitle{{- popup_content_dialog_id -}}" aria-modal="true">
    <div class="dialog__content d-flex fd-column h-100">
      <div class="dialog__header d-flex between-xs top-xs p-sticky top-0 p-relative">
        <h3 class="dialog__title h5 m-zero" id="dialogTitle{{- popup_content_dialog_id -}}">{{ popup_content_block_heading }}</h3>
        <button type="button" aria-label="{{- "accessibility.close_modal" | t -}}" class="dialog__btn btn-icon-l btn-icon btn-tertiary js-dialog-close-btn btn drawer__btn-close">
          {%- render 'icon-x-mark' -%}
        </button>
      </div>
      <div class="dialog__body js-dialog-body o-hidden">
        <template>
          <div class="hide-empty rte">
            {{- popup_content_block_text | default: '' -}}
          </div>
        </template>
      </div>
      <button aria-label="{{- "accessibility.close_modal" | t -}}" class="js-dialog-close-btn visually-hidden">
        {%- render 'icon-x-mark' -%}
      </button>
    </div>
  </div>
</sht-dialog>