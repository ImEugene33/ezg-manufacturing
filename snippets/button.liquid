{%- if block.settings.button_primary_label != blank -%}
  <div class="btn-group" >
    <a {{ block.shopify_attributes }} href="{{- block.settings.button_primary_link | default: '#' -}}" {{ block.settings.button_primary_link | default: 'tabindex="-1"' | replace: block.settings.button_primary_link , '' }} class="btn btn-m w-100 js-button-group-link btn-{{- block.settings.button_primary_style }} hide-empty {{ block.settings.button_primary_link | default: 'disable' | replace: block.settings.button_primary_link , '' }}">{{- block.settings.button_primary_label | escape -}}</a>
  </div>
{%- endif -%}