<div class="card card--border card-animate w-100 h-100 p-s rad-m o-hidden d-flex fd-column gap-xs ">
  {% if show_image %}
    {%- liquid
      assign image_width = '320, 450, 550, 750, 950, 1024'
      assign sizes = sizes | default: '(min-width: 769px) calc(' | append: settings.container_max_width | append: 'px / 4), (min-width: 459px) calc(100vw/2), 100vw'
      assign article_placeholder = 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder media of-cover h-100 w-100 d-block'
      assign article_image = article_placeholder
      assign article_image = article.image.src | image_url: width: article.image.width | image_tag: widths: image_width, sizes: sizes, alt: article.title, class: 'js-image-lazy media of-cover w-100', loading: loading, fetchpriority: fetchpriority, decoding: decoding
    -%}
    <div class="p-relative card__media">
      <a aria-label="{{ article.title | escape }}" href="{{ article.url }}" class="ele-focus-visible p-absolute w-100 h-100 zi-3 inset"></a>
      {% render 'image', ratio: image_ratio, image_item: article_image, image_wrap_classes: 'rad-s' %}
    </div>
  {% endif %}
  <div class="card__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'tags' -%}
          <ul class="ls-none d-flex gap-3xs fw-wrap hide-empty mb-2xs" {{ block.shopify_attributes }}>
            {%- for tag in article.tags -%}
              <li class="fs-heading-xs component-heading f-extra">
                {{- tag | link_to_tag: tag | replace: '<a', '<a class="tag"' -}}
              </li>
            {%- endfor -%}
          </ul>
        {%- when 'title' -%}
          <h2 class="fs-heading-m component-heading mb-xs" {{ block.shopify_attributes }}>
            <a aria-label="{{ article.title | escape }}" class="ele-focus-visible" href="{{ article.url }}">{{ article.title }}</a>
          </h2>
        {%- when 'additional_information' -%}
          <div class="mb-2xs fs-body-s color-text-60" {{ block.shopify_attributes }}>
            <span class="d-none {% if block.settings.info_to_show == 'author_name' or block.settings.info_to_show == 'both' %}d-inline-block{% endif %}">
              {{- article.author -}}
            </span>
            {% if block.settings.info_to_show == 'both' %}
              <span class="">•</span>
            {% endif %}
            <span class="d-none {% if block.settings.info_to_show == 'published_date' or block.settings.info_to_show == 'both' %}d-inline-block{% endif %}">
              {{- article.published_at | date: format: 'abbreviated_date' -}}
            </span>
          </div>
        {%- when 'excerpt' -%}
          <p class="{{ block.settings.truncate_text | replace: true, 'card__excerpt' }} o-hidden hide-empty fs-body-m" {{ block.shopify_attributes }}>
            {{- article.excerpt_or_content | strip_html -}}
          </p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
