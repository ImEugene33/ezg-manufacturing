{% liquid
  assign section_id = section.id | md5 | truncate: 12, ""
  assign rand = 'now' | date: '%N' | append: section_id
  assign form_id = 'CountrySwitcher-' | append: rand
  if settings.using_primary_button
    assign menu_color = 'menu__item--color'
  endif
%}
<sht-switcher class="fg-1">
  {%- form 'localization', id: form_id, class: 'country-switcher__form js-switcher-form' -%}
    <div class="country-switcher__container no-js-hidden">
      <h2 class="visually-hidden" id="CountrySwitcherLabel-{{ rand }}">{{ 'localization.country_label' | t }}</h2>
      <div class="country-switcher__wrapper p-relative">
        <button type="button" class="f-extra js-switcher-btn fs-menu-item-small btn-localization w-100 c-pointer b-zero focus-state {{ menu_color }}" aria-expanded="false" aria-controls="CountrySwitcherCountryList-{{ rand }}" aria-describedby="CountrySwitcherLabel-{{ rand }}">
          <span class="country-flag flex-0-auto">
            {{ localization.country | image_url: width: 20, height: 20 | image_tag: widths: '350', sizes: '100vw', class: 'country-list--flag br-50p of-cover h-100', loading: 'lazy', fetchpriority: 'auto', decoding: 'async' }}
          </span>
          <span class="country-name">
            {{ localization.country.name }}
            <span>•</span>
          </span>
          <span class="country-currency">
            {{ localization.country.currency.iso_code }}
            {{ localization.country.currency.symbol }}
          </span>
          <span class="toggle__icon d-flex middle-xs center-xs select__icon select-icon-{{- settings.toggle_icon -}}">
            {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-m icon', class_first: 'toggle__icon--plus icon-fix-m icon p-absolute', class_second: 'toggle__icon--minus icon-fix-m icon p-absolute' %}
          </span>
        </button>
        <div class="select-items localization-wapper js-switcher-list field__dropdown zi-9 p-absolute right-0 o-hidden" hidden="true">
          <ul role="list" id="CountrySwitcherCountryList-{{ rand }}" class="country-switcher__country-list localization-list dropdown-list ls-none oy-scroll scrollbars">
            {%- for country in localization.available_countries -%}
              {% liquid
                assign active_class = ''
                assign active_attrs = ''
                if country.iso_code == localization.country.iso_code
                  assign active_class = 'link--active'
                  assign active_attrs = 'aria-current="true"'
                endif
                assign country_flag_url = country | image_url: width: 20, height: 20
              %}
              <li class="select-item fs-body-m p-zero" tabindex="-1">
                <a class="js-switcher-item-link gap-xs d-flex middle-xs field__dropdown__link p-s w-100 {{ active_class }}" href="#" {{ active_attrs }} data-value="{{ country.iso_code }}">
                  <img
                    class="country-list--flag br-50p of-cover h-100 lazy-flag"
                    width="20"
                    height="20"
                    alt="{{ country.name | escape }}"
                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                    data-src="{{ country_flag_url }}"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  >
                  {{ country.name }}
                  ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
      <input type="hidden" class="js-switcher-code-field" name="country_code" value="{{ localization.country.iso_code }}">
    </div>
  {%- endform -%}
</sht-switcher>
