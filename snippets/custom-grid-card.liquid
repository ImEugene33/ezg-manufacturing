      <svg width="26" height="19" viewBox="0 0 26 19" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 11L7.66667 17.6667L24.3333 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
  </span>

  {%- if block.settings.heading != blank -%}
    <h3 class="custom-grid__card-title">{{ block.settings.heading }}</h3>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="custom-grid__card-text">{{ block.settings.text }}</div>
  {%- endif -%}

  {%- if block.settings.link_label != blank -%}
    {%- capture link_content -%}
      {{ block.settings.link_label }}
      <svg class="custom-grid__card-link-icon" width="12" height="9" viewBox="0 0 12 9" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0.5 4.5H10.5M6.50003 8.5L10.5 4.5L6.50003 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endcapture -%}
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="custom-grid__card-link">{{ link_content }}</a>
    {%- else -%}
      <a class="custom-grid__card-link custom-grid__card-link--disabled" aria-disabled="true">{{ link_content }}</a>
    {%- endif -%}
  {%- endif -%}
</div>
