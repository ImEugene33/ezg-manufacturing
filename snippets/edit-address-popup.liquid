<sht-dialog-edit-address
  class="sht-dialog no-focus-visible bottom-xs end-xs p-fixed left-0 top-0 h-100 w-100 o-hidden zi-10 hidden-xs"
  id="dialogEditAddressPopup_{{ address_id }}"
  hidden
  tabindex="-1">
  <div class="sht-dialog-overlay js-dialog-overlay"></div>
  <div
    class="js-dialog-container js-scroll-element drawer-content-container dialog popup-dialog cursor-initial disable-scrollbars dialog-address h-100"
    role="dialog"
    aria-labelledby="dialogTitle_{{ address_id }}"
    aria-modal="true">
    <div class="dialog__content d-flex fd-column h-100">
      <div class="dialog__header d-flex between-xs top-xs p-sticky top-0">
        <h3 class="dialog__title h5 m-zero" id="dialogTitle_{{ address_id }}">{{ 'customer.addresses.edit_address' | t }}</h3>
        <button
          type="button"
          aria-label="{{- "accessibility.close_modal" | t -}}"
          class="dialog__btn btn-icon-l btn-icon btn-tertiary js-dialog-close-btn btn drawer__btn-close">
          {%- render 'icon-x-mark' -%}
        </button>
      </div>
      <div class="dialog__body disable-scrollbars js-dialog-body o-hidden">
        {{ dialog_body }}
      </div>
      <div class="dialog__footer p-sticky bottom-0 zi-2 p-scale-xl pt-scale-s w-100">
        <div class="button-address-popup w-100">
          <button class="btn btn-l btn-primary w-100" type="submit" form="{{ form_id }}">{{ 'customer.addresses.update' | t }}</button>
        </div>
      </div>
      <button
        aria-label="{{- "accessibility.close_modal" | t -}}"
        class="js-drawer-btn-close js-cart-drawer-btn-close btn btn-icon btn-icon-l btn-tertiary visually-hidden"
        onclick="window.shtCartDrawer.closeDrawer(event);"
        type="button"
        aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon-x-mark' -%}
      </button>
    </div>
  </div>
</sht-dialog-edit-address>