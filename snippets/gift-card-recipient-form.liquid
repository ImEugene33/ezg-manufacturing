{%- assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]' -%}
<sht-gift-card-recipient-form class="product-form__recipient-form d-block w-100 p-relative mb-m middle-xs" data-section-id="{{ section.id }}" data-product-variant-id="{{ product.selected_or_first_available_variant.id }}">
  <span class="field__checkbox fs-body-m d-flex middle-xs c-pointer p-xs p-relative recipient-gift-card-checkbox">
    <span class="customization-code-icon p-absolute"></span>
    <input id="Recipient-Checkbox-{{ section.id }}" class="gift-card-recipient-i-want js-gift-card-recipient-form-i-want c-pointer input__checkbox p-absolute opacity-0" type="checkbox" name="{{ gift_card_recipient_control_flag }}">
    <span class="checkbox-icon d-flex middle-xs center-xs p-absolute checkbox-gift-card">
      {% render 'icon-check', class: 'icon icon-fix-m input__checkbox__icon' %}
    </span>
    <label class="js-gift-card-recipient-label recipient-checkbox gift-card-recipient-i-want-label d-inline-flex c-pointer us-none pl-2xl zi-1" for="Recipient-Checkbox-{{ section.id }}">
      {{ 'products.product.send_a_gift' | t }}
    </label>
  </span>
  <div class="recipient-fields js-gift-card-recipient-fields mt-m p-s rad-m border-content-10 d-none">
    <div class="d-flex gap-xs middle-xs p-s">
      {%- render 'icon-notes', class: 'icon icon-fix-m' -%}
      <p class="m-zero fs-body-m">{{ 'products.product.recipient_information' | t }}</p>
    </div>
    <div class="d-flex fd-column gap-s p-s">
      <div class="recipient-fields__field">
        <div class="field">
          <label class="field__label d-block p-relative fs-body-m" for="Recipient-email-{{ section.id }}">
            {{ 'products.product.recipient_email' | t }}
            <sup class="p-absolute ml-4xs p-absolute color-danger">*</sup>
          </label>
          <input class="field__text field--focus field--hover w-100 js-gift-card-recipient-form-email" id="Recipient-email-{{ section.id }}" type="email" placeholder="{{ 'products.product.recipient_email_placeholder' | t }}" name="properties[Recipient email]" value="{{ form.email }}" pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-email-error-{{ section.id }}"
              tabindex="-1" autofocus
            {% endif %}>
        </div>
        <div id="RecipientForm-email-error-{{ section.id }}" class="js-gift-card-recipient-form-error js-gift-card-recipient-form-email-error mt-2xs fs-body-s form__message color-danger{% unless form.errors contains 'email' %} hidden{% endunless %}">
          <span class="recipient-email-error-prefix">{{ 'products.product.recipient_email' | t }}</span>
          <span class="error-message">
            {%- if form.errors contains 'email' -%}
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}.
            {%- endif -%}
          </span>
        </div>
      </div>
      <div class="recipient-fields__field">
        <div class="field">
          <label class="field__label d-block fs-body-m" for="Recipient-name-{{ section.id }}">
            {{ 'products.product.recipient_name' | t }}
          </label>
          <input class="field__text field--focus field--hover w-100 js-gift-card-recipient-form-name" autocomplete="name" type="text" id="Recipient-name-{{ section.id }}" name="properties[Recipient name]" placeholder="{{ 'products.product.recipient_name_placeholder' | t }}" value="{{ form.name }}"
            {% if form.errors contains 'name' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-name-error-{{ section.id }}"
            {% endif %}
          >
        </div>
        <div id="RecipientForm-name-error-{{ section.id }}" class="js-gift-card-recipient-form-error js-gift-card-recipient-form-name-error mt-2xs fs-body-s form__message{% unless form.errors contains 'name' %} hidden{% endunless %}">
          <span class="error-message">
            {%- if form.errors contains 'name' -%}
              {{ form.errors.translated_fields.name | capitalize }}
              {{ form.errors.messages.name }}.
            {%- endif -%}
          </span>
        </div>
      </div>
      <div class="recipient-fields__field">
        {%- assign max_chars_message = 200 -%}
        {%- assign max_chars_message_rendered = 'products.product.characters_max' | t: max_chars: max_chars_message -%}
        {%- assign message_label_rendered = 'products.product.message_label' | t -%}
        <div class="field">
          <label class="form__label field__label d-block fs-body-m" for="Recipient-message-{{ section.id }}">
            {{ 'products.product.your_message' | t }}
          </label>
          <textarea rows="5" id="Recipient-message-{{ section.id }}" class="textarea field__text field--focus field--hover w-100 js-gift-card-recipient-form-message" name="properties[Message]" maxlength="{{ max_chars_message }}" placeholder="{{ 'products.product.enter_your_message' | t }}" aria-label="{{ message_label_rendered }} {{ max_chars_message_rendered }}"
            {% if form.errors contains 'message' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-message-error-{{ section.id }}"
            {% endif %}
          >{{ form.message }}</textarea>
        </div>
        <label class="subtext recipient-form-field-label fs-body-m">
          <span class="fs-body-s color-text-60">{{ 'products.product.200_characters_max' | t }}</span>
        </label>
        <div id="RecipientForm-message-error-{{ section.id }}" class="js-gift-card-recipient-form-error js-gift-card-recipient-form-message-error mt-2xs fs-body-s form__message{% unless form.errors contains 'message' %} hidden{% endunless %}">
          <span class="error-message">
            {%- if form.errors contains 'message' -%}
              {{ form.errors.translated_fields.message | capitalize }}
              {{ form.errors.messages.message }}.
            {%- endif -%}
          </span>
        </div>
      </div>
      <div class="recipient-fields__field">
        <div class="field">
          <label class="field__label d-block fs-body-m" for="Recipient-send-on-{{ section.id }}">
            {{ 'products.product.recipient_send_on' | t }}
          </label>
          <input
            class="field__text field--focus field--hover w-100 js-gift-card-recipient-form-send_on"
            autocomplete="name"
            type="date"
            id="Recipient-send-on-{{ section.id }}"
            name="properties[Send on]"
            placeholder="{{ 'products.product.recipient_send_on_placeholder' | t }}"
            value="{{ form.send_on }}"
            pattern="\d{4}-\d{2}-\d{2}"
            {% if form.errors contains 'send_on' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-send_on-error-{{ section.id }}"
            {% endif %}
          >
        </div>
        <div id="RecipientForm-send_on-error-{{ section.id }}" class="js-gift-card-recipient-form-error js-gift-card-recipient-form-send_on-error mt-2xs fs-body-s form__message color-danger{% unless form.errors contains 'send_on' %} hidden{% endunless %}">
          <span class="error-message">
            {%- if form.errors contains 'send_on' -%}
              {{ form.errors.translated_fields.send_on | capitalize }}
              {{ form.errors.messages.name }}.
            {%- endif -%}
          </span>
        </div>
      </div>
    </div>
  </div>
  <input class="js-gift-card-recipient-form-i-want-hidden" type="hidden" name="{{ gift_card_recipient_control_flag }}" value="if_present" id="Recipient-Control-{{ section.id }}">
</sht-gift-card-recipient-form>