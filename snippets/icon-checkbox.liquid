<svg
  class="{{ class | default: '' }}"
  width="{{ size | default: 24 }}"
  height="{{ size | default: 24 }}"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true" focusable="false"
>
<rect width="16" height="16" rx="4" fill="var(--color-background)"/>
<rect x="0.5" y="0.5" width="15" height="15" rx="3.5" stroke="var(--color-normal-text)" stroke-opacity="0.3"/>
</svg>
