<sht-dialog class="sht-dialog no-focus-visible p-fixed o-hidden left-0 top-0 h-100 w-100 zi-10 hidden-xs" id="dialogImageGallery{{- rand -}}" data-close-modal-on-overlay="true" hidden tabindex="-1">
  <div class="sht-dialog-overlay js-dialog-overlay"></div>
  <div class="dialog js-dialog-container drawer-content-container o-hidden rad-l disable-scrollbars w-100 h-100 zi-1 color-{{- section.settings.color_scheme }} background" role="dialog" aria-labelledby="dialogTitle{{ rand }}" aria-modal="true">
    <div class="dialog__content d-flex fd-column h-100 p-relative">
      <div class="dialog__header dialog--no-title d-flex between-xs p-sticky top-0">
        <span class="h4 d-none m-zero" aria-hidden="true" id="dialogTitle{{- rand -}}">{{ product.title | escape }}</span>
        <button type="button" aria-label="{{- "accessibility.close_modal" | t -}}" class="js-dialog-close-btn btn btn-icon btn-icon-l btn-tertiary">
          {% render 'icon-x-mark' %}
        </button>
      </div>
      <div class="dialog__body dialog-gallery-body js-dialog-body h-100 disable-scrollbars">
        <template id="productGallery-{{ section.id }}">
          <sht-gallery class="d-flex fd-column h-100" data-gallery-dialog-id="dialogImageGallery{{- rand -}}">
            <sht-gallery-slides class="dialog-gallery-slides d-block w-100 h-100 disable-scrollbars o-hidden" id="zoomContainer-{{- section.id -}}" data-total-slides="{{- section.blocks.size -}}" style="--ratio: {{ ratio }}">
              {%- for block in section.blocks -%}
                {%- if block.settings.item_image != blank -%}
                  {%- assign item_alt = block.settings.item_image.alt | default: block.settings.item_image.image | split: '/' | last -%}
                  <sht-gallery-slide role="listitem" data-item-index="{{ forloop.index }}" tabindex="-1" class="h-100 d-none js-gallery-slide center-xs p-relative" data-media-id="{{ section.id }}-{{ block.id }}" data-gallery-dialog-id="dialogImageGallery{{ rand }}" >
                    <div class="d-block w-100 h-100 ta-center">
                      <div class="container-zoom d-block h-100">
                        <sht-zoom class="d-block w-100 h-100" data-container-id="zoomContainer-{{ section.id }}">
                          {{ block.settings.item_image | image_url: width: block.settings.item_image.width | image_tag: widths: '750, 950, 1024, 1200, 1400, 1600, 1800, 2000', sizes: '100vw', alt: item_alt, class: 'of-contain w-100 h-100 c-zoom-in js-zoom-item' }}
                        </sht-zoom>
                      </div>
                    </div>
                  </sht-gallery-slide>
                {%- endif -%}
              {%- endfor -%}
            </sht-gallery-slides>

            <sht-gallery-thumbnails class="product-gallery-thumbnails flex-0-auto d-flex flex-1 middle-xs center-xs w-100 o-hidden">
              <sht-horiz-carousel class="sht-carousel horizontal-carousel-wrapper d-flex w-100 p-relative" data-section-id="{{- section.id -}}">
                <div class="js-carousel-items horizontal-carousel d-flex fd-row p-zero ox-auto p-relative disable-scrollbars fw-nowrap scrollable scrl-bhvr-auto m-auto" role="list" aria-label="{{ 'accessibility.slider' | t }}">
                  {%- for block in section.blocks -%}
                    {%- if block.settings.item_image != blank -%}
                      {%- liquid
                        assign image_element = place_holder
                        assign image_id = "imageGalleryThumb-" | append: section.id | append: "-" | append: forloop.index
                        assign class = 'js-image-lazy media p-relative object_fit h-100 w-100' | replace: 'object_fit', object_fit
                        assign image_element = block.settings.item_image | image_url: width: 130 | image_tag: alt: item_alt, class: class, id: image_id
                      -%}
                      <sht-horiz-carousel-itm role="listitem" class="rad-m o-hidden gallery__thumb product-slideshow__thumb center-md d-flex-md middle-md p-zero-md maw-md-100 js-gallery-thumb js-carousel-item p-relative scrollable-aln-start ta-center d-flex aln-itm-ctr fg-1 fs-0" data-media-target-id="{{ section.id }}-{{ block.id }}">
                        <button aria-describedby="{{ image_id }}" aria-label="{{ 'accessibility.open_media_gallery' | t: index: forloop.index }}" aria-controls="zoomContainer-{{ section.id }}" class="js-gallery-btn-thumb d-block h-100 btn-slideshow-thumb o-hidden p-zero b-zero p-relative c-pointer media" data-target="{{ section.id }}-{{ block.id }}" style="--ratio: {{ ratio }}; background-color: {{ media_background }};">
                          <div class="d-block p-relative o-hidden w-100 h-100" style="--ratio: {{ ratio }}">
                            {{ image_element }}
                          </div>
                        </button>
                      </sht-horiz-carousel-itm>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <div class="product-gallery__pagination carousel-pagination zi-1 p-absolute d-flex center-xs no-js-hidden js-carousel-pagination middle-y w-100">
                  <button type="button" data-step="1" tabindex="-1" class="carousel__btn btn-carousel-prev btn-prev js-carousel-prev-btn btn btn-icon-m btn-secondary p-absolute rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous">
                    {% render 'icon-caret-left', class: 'icon icon-fix-m' %}
                  </button>
                  <button type="button" data-step="1" tabindex="-1" class="carousel__btn btn-carousel-next btn-next js-carousel-next-btn btn btn-icon-m btn-secondary p-absolute rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next">
                    {% render 'icon-caret-right', class: 'icon icon-fix-m' %}
                  </button>
                </div>
                <div class="thubnails-carousel-overflow"></div>
              </sht-horiz-carousel>
            </sht-gallery-thumbnails>
          </sht-gallery>
        </template>
      </div>
    </div>
  </div>
</sht-dialog>
