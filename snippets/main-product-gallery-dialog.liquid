<sht-dialog class="sht-dialog no-focus-visible p-fixed o-hidden left-0 top-0 h-100 w-100 zi-10 hidden-xs" id="dialogProductGallery{{- rand -}}" data-close-modal-on-overlay="true" hidden tabindex="-1">
  <div class="sht-dialog-overlay js-dialog-overlay"></div>
  <div class="dialog js-dialog-container drawer-content-container o-hidden rad-l disable-scrollbars w-100 h-100 zi-1 color-{{- section.settings.color_scheme }} background" role="dialog" aria-labelledby="dialogTitle{{ rand }}" aria-modal="true">
    <div class="dialog__content d-flex fd-column h-100 p-relative">
      <div class="dialog__header dialog--no-title d-flex between-xs p-sticky top-0">
        <span class="h4 d-none m-zero" aria-hidden="true" id="dialogTitle{{- rand -}}">{{ product.title | escape }}</span>
        <button type="button" aria-label="{{- "accessibility.close_modal" | t -}}" class="js-dialog-close-btn btn btn-icon btn-icon-l btn-tertiary">
          {% render 'icon-x-mark' %}
        </button>
      </div>
      <div class="dialog__body dialog-gallery-body js-dialog-body h-100 disable-scrollbars">
        <template id="productGallery-{{ section.id }}">
          <sht-gallery class="d-flex fd-column h-100" data-gallery-dialog-id="dialogProductGallery{{- rand -}}">
            <sht-gallery-slides class="dialog-gallery-slides d-block w-100 h-100 disable-scrollbars o-hidden" id="zoomContainer-{{- section.id -}}" data-total-slides="{{- product.media.size -}}" style="--ratio: {{ ratio }}">
              {%- liquid
                for media in product.media
                  render 'product-slideshow-image-gallery', xr_button: true, section: section, media: media, product: product, product_media_index: product_media_index, is_first_item: forloop.first, rand: rand, index: forloop.index
                endfor
              -%}
            </sht-gallery-slides>

            <sht-gallery-thumbnails class="product-gallery-thumbnails flex-0-auto d-flex flex-1 middle-xs center-xs w-100 o-hidden">
              <sht-horiz-carousel class="sht-carousel horizontal-carousel-wrapper d-flex w-100 p-relative" data-section-id="{{- section.id -}}">
                <div class="js-carousel-items horizontal-carousel d-flex fd-row p-zero ox-auto p-relative disable-scrollbars fw-nowrap scrollable scrl-bhvr-auto m-auto" role="list" aria-label="{{ 'accessibility.slider' | t }}">
                  {%- liquid
                    for media in product.media
                      render 'product-slideshow-thumb-gallery', section: section, media: media, product: product, is_first_media: forloop.first, rand: rand, thumb_index: forloop.index, ratio: ratio, object_fit: object_fit, media_background: media_background
                    endfor
                  -%}
                </div>
                <div class="product-gallery__pagination carousel-pagination zi-1 p-absolute d-flex center-xs no-js-hidden js-carousel-pagination middle-y w-100">
                  <button type="button" tabindex="-1" data-step="1" class="carousel__btn btn-carousel-prev btn-prev js-carousel-prev-btn btn btn-icon-m btn-secondary p-absolute rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous">
                    {% render 'icon-caret-left', class: 'icon icon-fix-m' %}
                  </button>
                  <button type="button" tabindex="-1" data-step="1" class="carousel__btn btn-carousel-next btn-next js-carousel-next-btn btn btn-icon-m btn-secondary p-absolute rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next">
                    {% render 'icon-caret-right', class: 'icon icon-fix-m' %}
                  </button>
                </div>
                <div class="thubnails-carousel-overflow"></div>
              </sht-horiz-carousel>
            </sht-gallery-thumbnails>
          </sht-gallery>
        </template>
      </div>
    </div>
  </div>
</sht-dialog>
