{%- liquid
    assign menu_apply_image = block.settings.apply_image_to
    assign menu_link_apply_image = block.settings.type_of_link_support
    assign enable_menu_product_image = false
    assign enable_menu_collection_image = false
    unless menu_apply_image == 'none'
        assign menu_level_two_image = false
        assign menu_level_three_image = false

        if menu_link_apply_image == 'product'
            assign enable_menu_product_image = true
        endif
        if menu_link_apply_image == 'collection'
            assign enable_menu_collection_image = true
        endif
        if menu_link_apply_image == 'both'
            assign enable_menu_product_image = true
            assign enable_menu_collection_image = true
        endif

        assign menu_level_two_image_size = 'megamenu-item-card__media ratio--square of-cover rad-s megamenu-item-card__media--' | append: block.settings.menu_level_two_image_size
        if menu_apply_image == 'level_2'
            assign menu_level_two_image = true
        endif

        assign menu_level_three_image_size = 'megamenu-item-card__media ratio--square of-cover rad-s megamenu-item-card__media--' | append: block.settings.menu_level_three_image_size
        if menu_apply_image == 'level_3'
            assign menu_level_three_image = true
        endif

        if menu_apply_image == 'both'
            assign menu_level_two_image = true
            assign menu_level_three_image = true
        endif
    endunless
-%}
<ul class="megamenu-column-list w-100 m-zero p-zero ls-none d-flex fd-column" id="menuHeaderMenuList-{{ forloop.index }}">
    {%- for childlink in links -%}
        {% capture menu_item_media %}
            {%- if childlink.object.featured_image and menu_level_two_image and enable_menu_product_image and childlink.type == 'product_link' -%}
                {{- childlink.object.featured_image | image_url: width: 200 | image_tag: class: menu_level_two_image_size, loading: 'lazy' -}}
            {%- elsif childlink.object.featured_image and menu_level_two_image and enable_menu_collection_image and childlink.type == 'collection_link' -%}
                {{- childlink.object.featured_image | image_url: width: 200 | image_tag: class: menu_level_two_image_size, loading: 'lazy' -}}
            {%- endif -%}
        {% endcapture %}
        <li class="megamenu-column-list-item {% if childlink.links != blank %}megamenu-column-list-item--has-children{% endif %}">
            <a href="{{- childlink.url -}}" class="megamenu-column-list-item__summary js-tab-header-button menu__link ele-focus-visible d-flex middle-xs gap-3xs" data-code="megamenu-products-{{ block.id }}-{{ forloop.index }}">
                {{ menu_item_media }}
                <span class="megamenu-link-label flex-1 wb-break-word">{{- childlink.title -}}</span>
            </a>
            {%- if childlink.links != blank -%}
                <ul class="megamenu-column-sublist m-zero p-zero ls-none d-flex fd-column gap-3xs">
                    {%- for grandchildlink in childlink.links -%}
                        <li class="megamenu-column-sublist-item {{ grandchildlink.current | default: '' | replace: 'true', 'menu__item--current' }}">
                            {%- if grandchildlink.object.featured_image and menu_level_three_image and enable_menu_product_image and grandchildlink.type == 'product_link' -%}
                                <a class="menu__link megamenu-item-card d-flex gap-2xs middle-xs {{ grandchildlink.current | default: '' | replace: 'true', 'menu__link--active' }}" href="{{- grandchildlink.url -}}">
                                    {{- grandchildlink.object.featured_image | image_url: width: 200 | image_tag: class: menu_level_three_image_size, loading: 'lazy' -}}
                                    <span class="d-flex megamenu-link-label flex-1">{{- grandchildlink.title -}}</span>
                                </a>
                            {%- elsif grandchildlink.object.featured_image and menu_level_three_image and enable_menu_collection_image and grandchildlink.type == 'collection_link' -%}
                                <a class="menu__link megamenu-item-card d-flex gap-2xs middle-xs {{ grandchildlink.current | default: '' | replace: 'true', 'menu__link--active' }}" href="{{- grandchildlink.url -}}">
                                    {{- grandchildlink.object.featured_image | image_url: width: 200 | image_tag: class: menu_level_three_image_size, loading: 'lazy' -}}
                                    <span class="d-flex megamenu-link-label flex-1">{{- grandchildlink.title -}}</span>
                                </a>
                            {%- else -%}
                                <a href="{{- grandchildlink.url -}}" class="menu__link d-flex {{ grandchildlink.current | default: '' | replace: 'true', 'menu__link--active' }}">{{- grandchildlink.title -}}</a>
                            {%- endif -%}
                        </li>
                    {%- endfor -%}
                </ul>
            {%- endif -%}
        </li>
    {%- endfor -%}
</ul>
