{% liquid
    assign promotion_ratio = block.settings.image_ratio
    assign promotion_content_alignment = block.settings.content_alignment
    assign promotion_content_position = block.settings.content_position
    assign sht_mask_promotion = promotion_content_position | replace: '-xs', ''
    if sht_mask_promotion == 'center'
      if promotion_content_alignment contains 'left'
        assign sht_mask_promotion = 'center-left '
      elsif promotion_content_alignment contains 'right'
        assign sht_mask_promotion = 'center-right'
      endif
    endif
    assign promotion_block_count = 0
%}

{%- if block.settings.promotion_display_style == 'collage' -%}
    {%- for i in (1..3) %}
        {%- liquid
        assign image_key = 'promotion_' | append: i | append: '_image' 
        assign heading_key = 'promotion_' | append: i | append: '_heading' 
        assign description_key = 'promotion_' | append: i | append: '_description' 
        assign button_label_key = 'promotion_' | append: i | append: '_button_label' 
        assign button_link_key = 'promotion_' | append: i | append: '_link'
        assign overlay_opacity_key = 'promotion_' | append: i | append: '_mask_overlay_opacity'
        assign overlay_color_key = 'promotion_' | append: i | append: '_custom_mask_overlay_color'
        assign overlay_content_color_key = 'promotion_' | append: i | append: '_custom_content_overlay_color'

        assign image = block.settings[image_key]
        assign heading = block.settings[heading_key]
        assign description = block.settings[description_key]
        assign button_label = block.settings[button_label_key]
        assign button_link = block.settings[button_link_key]
        assign overlay_opacity = block.settings[overlay_opacity_key] | divided_by: 100.0
        assign overlay_color = block.settings[overlay_color_key] | replace: 'rgba(0,0,0,0)', 'inherit' | color_modify: 'alpha', overlay_opacity
        assign overlay_content_color = block.settings[overlay_content_color_key] | replace: 'rgba(0,0,0,0)', 'inherit'
        -%}
    {%- if image != blank -%}
        {%- liquid
            assign promotion_block_count = promotion_block_count | plus: 1
            assign image_alt = image.alt | default: image.src | split: '/' | last | split: '.' | first
        -%}
        <div class="megamenu-promotion-card card--content-overlay d-flex fd-column sht-mask sht-mask--{{ sht_mask_promotion }} content--{{ sht_mask_promotion }} {{ promotion_content_alignment }} {{ promotion_content_position }} p-relative rad-m o-hidden gap-m w-100 ratio d-flex"
        style="
            --color-mask: {{ overlay_color | default: 'inherit' }};
            color: {{ overlay_content_color | default: 'inherit' }};
            --ratio: {{ promotion_ratio }};
            --overlay: {{ overlay_opacity }};"
        >
            {%- if button_link != blank and button_label == blank -%}
                <a href="{{- button_link -}}" class="p-absolute top-0 right-0 bottom-0 left-0 zi-2" aria-label="{{- button_label | escape -}}"></a>
            {%- endif -%}
            {{- image | image_url: width: 540 | image_tag: alt: image_alt, class: 'w-100 h-100 inset p-absolute of-cover', loading:'lazy', fetchpriority: 'low' -}}
            <div class="promotion-content card__content p-m p-relative zi-1 o-hidden oy-scroll_ disable-scrollbars mah-100">
                <h3 class="promotion-heading fs-heading-m component-heading hide-empty">{{- heading |  escape -}}</h3>
                <div class="promotion-description mt-xs hide-empty">{{- description -}}</div>
                {%- if button_label != blank -%}
                    <a href="{{- button_link | default: '#' -}}" {{ button_link | default: 'tabindex="-1"' | replace: button_link , '' }} class="btn btn-primary btn-m mt-s pe-no-link {{ button_link | default: 'disable' | replace: button_link , '' }}">{{- button_label |  escape -}}</a>
                {%- endif -%}
            </div>
        </div>
        {%- endif -%}
    {% endfor %}
{%- else -%}
    <sht-carousel class="sht-carousel p-relative d-block">
        <div aria-atomic="true" class="d-flex o-hidden r-gap-scale-xl js-carousel-items ox-auto p-relative scrollable scrollable-x disable-scrollbars carousel--special">
            {%- for i in (1..3) %}
            {%- liquid
                assign image_key = 'promotion_' | append: i | append: '_image' 
                assign heading_key = 'promotion_' | append: i | append: '_heading' 
                assign description_key = 'promotion_' | append: i | append: '_description' 
                assign button_label_key = 'promotion_' | append: i | append: '_button_label' 
                assign button_link_key = 'promotion_' | append: i | append: '_link'
                assign overlay_opacity_key = 'promotion_' | append: i | append: '_mask_overlay_opacity'
                assign overlay_color_key = 'promotion_' | append: i | append: '_custom_mask_overlay_color'
                assign overlay_content_color_key = 'promotion_' | append: i | append: '_custom_content_overlay_color'

                assign image = block.settings[image_key]
                assign heading = block.settings[heading_key]
                assign description = block.settings[description_key]
                assign button_label = block.settings[button_label_key]
                assign button_link = block.settings[button_link_key]
                assign overlay_opacity = block.settings[overlay_opacity_key] | divided_by: 100.0
                assign overlay_color = block.settings[overlay_color_key] | replace: 'rgba(0,0,0,0)', 'inherit' | color_modify: 'alpha', overlay_opacity
                assign overlay_content_color = block.settings[overlay_content_color_key] | replace: 'rgba(0,0,0,0)', 'inherit'
            -%}
            {%- if image != blank -%}
                <sht-carousel-itm class="w-100 flex-0-auto carousel__item d-flex js-carousel-item p-relative scrollable-aln-start" role="group" aria-roledescription="Slide" aria-label="{{ 'accessibility.slide' | t }} {{ forloop.index }} {{ 'accessibility.of' | t }} {{ forloop.length }}" data-item-index="{{ forloop.index }}">
                {%- liquid
                    assign promotion_block_count = promotion_block_count | plus: 1
                    assign image_alt = image.alt | default: image.src | split: '/' | last | split: '.' | first
                -%}
                <div class="megamenu-promotion-card card--content-overlay d-flex fd-column sht-mask sht-mask--{{ sht_mask_promotion }} content--{{ sht_mask_promotion }} {{ promotion_content_alignment }} {{ promotion_content_position }} p-relative rad-m o-hidden d-flex gap-m w-100 ratio d-flex"
                    style="
                        --color-mask: {{ overlay_color | default: 'inherit' }};
                        color: {{ overlay_content_color | default: 'inherit' }};
                        --ratio: {{ promotion_ratio }};
                        --overlay: {{ overlay_opacity }};"
                    >
                    {%- if button_link != blank and button_label == blank -%}
                        <a href="{{- button_link -}}" class="p-absolute top-0 right-0 bottom-0 left-0 zi-2" aria-label="{{- button_label | escape -}}"></a>
                    {%- endif -%}
                    {{- image | image_url: width: 540 | image_tag: alt: image_alt, class: 'w-100 h-100 inset p-absolute of-cover', loading:'lazy', fetchpriority: 'low' -}}
                        <div class="promotion-content card__content p-m p-relative zi-1 o-hidden oy-scroll_ disable-scrollbars mah-100">
                            <h3 class="promotion-heading fs-heading-m component-heading hide-empty">{{- heading |  escape -}}</h3>
                            <div class="promotion-description mt-xs hide-empty">{{- description -}}</div>
                            {%- if button_label != blank -%}
                              <a href="{{- button_link | default: '#' -}}" {{ button_link | default: 'tabindex="-1"' | replace: button_link , '' }} class="btn btn-primary btn-m mt-s pe-no-link {{ button_link | default: 'disable' | replace: button_link , '' }}" >{{- button_label |  escape -}}</a>
                            {%- endif -%}
                        </div>
                    </div>
                </sht-carousel-itm>
            {%- endif -%}
            {% endfor %}
        </div>
        <div class="carousel-pagination middle-y w-100 p-absolute no-js-hidden zi-3 {{ promotion_block_count | replace: '1', 'd-none'}}">
            <button type="button" data-step="1" data-step-mb="1" class="js-carousel-prev-btn btn-carousel-prev btn btn-icon-l btn-secondary middle-y p-absolute left-0 rtl-flip-x" aria-label="{{ 'accessibility.previous_slide' | t }}" name="previous" disabled>{% render 'icon-caret-left', class: 'icon icon-fix-xl' %}</button>
            <button type="button" data-step="1" data-step-mb="1" class="js-carousel-next-btn btn-carousel-next btn btn-icon-l btn-secondary middle-y p-absolute right-0 rtl-flip-x" aria-label="{{ 'accessibility.next_slide' | t }}" name="next" disabled>{% render 'icon-caret-right', class: 'icon icon-fix-xl' %}</button>
        </div>
    </sht-carousel>
{%- endif -%}