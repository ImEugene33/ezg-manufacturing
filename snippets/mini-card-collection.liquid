{%- comment -%}
{% render 'mini-card-collection',
  collection: collection,
  ratio: '1/1'
%}
{%- endcomment -%}
{%- liquid
  assign image_loading = image_loading | default: 'lazy'
  assign fetchpriority = fetchpriority | default: 'low'
  assign collection_image = 'collection-apparel-1' | placeholder_svg_tag: 'placeholder media of-cover w-100 h-100 rad-s'
  assign collection_image = collection.products.first.featured_image | image_url: width: collection.products.first.featured_image.width | image_tag: widths: '750, 950', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: collection.title, class: 'media of-cover w-100 h-100 rad-s', loading: image_loading, fetchpriority: fetchpriority
  assign collection_image = collection.image | image_url: width: collection.image.width | image_tag: widths: '750, 950', sizes: '(min-width: 361px) calc(100vw/2), calc(100vw/3)', alt: collection.title, class: 'media of-cover w-100 h-100', loading: image_loading, fetchpriority: fetchpriority
-%}
<sht-lazy-loader class="card mini-card card-animate card--border w-100 h-100 p-relative p-xs rad-m o-hidden d-flex gap-xs" data-loading="{{ image_loading }}">
  <a aria-label="{{ collection.title }}" href="{{ collection.url }}" class="d-block h-100 w-100 zi-3 p-absolute inset ele-focus-visible"></a>
  <div class="card__media mini-card-collection__media p-relative ratio o-hidden rad-s">
    {% render 'image', image_item: collection_image, src: collection_image.src, image_classes: 'h-100 w-100', image_wrap_classes: 'rad-s', ratio: ratio %}
  </div>
  <div class="card__content wb-break-word flex-1">
    <div class="d-grid gap-2xs flex-1 ta-left h-fit-content">
      <h3 class="fs-heading-s component-heading m-zero">{{ collection.title }}
        {% if settings.quantity_card_style == 'superscript' %}
          <sup class="fs-body-xs f-extra {{ settings.collection_card_show_product_quantity | default: ' d-none-important' | replace: 'true', '' }} {{ settings.numbers_style | replace: 'number', '' }}">
            {{ collection.products.size }}
          </sup>
        {% endif %}
      </h3>
      {% if settings.quantity_card_style == 'separate_line' %}
        <span class="fs-heading-xs component-heading color-text-60 wb-break-word f-extra {{ settings.collection_card_show_product_quantity | default: ' d-none-important' | replace: 'true', '' }}">
          {{ 'general.collection.view_collection' | t: count: collection.products.size }}
        </span>
      {% endif %}
    </div>
  </div>
</sht-lazy-loader>