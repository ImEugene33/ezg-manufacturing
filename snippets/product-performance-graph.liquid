{%- liquid
assign graph_popup_id = block.id | append: section.id | md5 | truncate: 12, ""
assign graph_list = block.settings.graphs_metafield
assign graph_namespace = graph_list | split: '.' | first
assign graph_key = graph_list | split: '.' | last
assign graph_values = product.metafields[graph_namespace][graph_key].value
assign margin_graph = ''
if block.settings.use_list_of_graphs and graph_values.count < 1
  assign margin_graph = 'mb-0'
endif
-%}
{%- unless block.settings.use_list_of_graphs == true and product.metafields[graph_namespace][graph_key] == blank or graph_values.count < 1 -%}
<div class="product__info product__block-{{- block.type }} mb-3xl {{ margin_graph }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_as_collapsible %}
    <sht-accordion class="accordion d-flex fd-column">
      <div class="accordion__item js-accordion-item rad-m border">
        <button class="region-trigger accordion__header-large accordion__button ele-focus-visible w-100 p-zero js-accordion-trigger d-flex middle-xs p-relative c-pointer {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-control-{{- block.id -}}" aria-expanded="{{ block.settings.expand_collapsible }}" aria-controls="collapsible-content-{{- block.id -}}">
          {%- liquid
            if block.settings.enable_icon
              render 'icon', theme_library_icon: block.settings.theme_library_icon, icon_color: block.settings.custom_icon_color, icon_source: block.settings.icon_source, icon_image: block.settings.icon_image, custom_code: block.settings.custom_code, size: 'icon-fix-xl'
            endif
          -%}
          <span class="fs-body-m m-zero flex-1 ta-left">
            <span class="fs-heading-s component-heading">{{- block.settings.heading | escape -}}</span>
          </span>
          <span class="toggle__icon d-flex middle-xs center-xs p-relative">
            {% render 'icon-toggle', icon_arrow: 'icon-caret-down icon-fix-xl icon', class_first: 'toggle__icon--plus p-absolute icon-fix-xl icon', class_second: 'toggle__icon--minus p-absolute icon-fix-xl icon' %}
          </span>
        </button>
        <div class="accordion__content-large o-hidden js-accordion-content accordion-content {{ block.settings.expand_collapsible | replace: true, 'open' | replace: false, '' }}" id="collapsible-content-{{- block.id -}}" role="region" aria-describedby="collapsible-control-{{- block.id -}}" tabindex="-1" style="max-height: {{ block.settings.expand_collapsible | replace: true, 'auto' | replace: false, '0' }};">
          {%- render 'performance-graph-block', block: block, graph_popup_id: graph_popup_id, graph_values: graph_values -%}
        </div>
      </div>
    </sht-accordion>
  {% else %}
    <span class="fs-heading-s component-heading mb-scale-xl d-block hide-empty">{{- block.settings.heading | escape -}}</span>
    {%- render 'performance-graph-block', block: block, graph_popup_id: graph_popup_id, graph_values: graph_values -%}
  {% endif %}
</div>
{%- endunless -%}