{%- comment -%}
    Renders linear progress bar for graph

    Accepts:
    - label: {String} Name of the graph.
    - maximum_value: {Number - min: 1 - max: 10} Maximum value of the graph.
    - product_value: {Number - min: 1 - max: 10} Product value for the graph.
    - class: {String} Custom wrap css class.

    Example usage:
    {% render 'progress-circular',
      label: Durability,
      maximum_value: 5,
      product_value: 2,
      class: 'custom-graph'
    %}
{%- endcomment -%}
{%- liquid
  if product_value > maximum_value
    assign product_value = maximum_value
  endif
  assign percentage = product_value | times: 100 | divided_by: maximum_value
  assign custom_class = ''
  unless custom_color.alpha == 0.0 or custom_color == blank
    assign custom_color_background = custom_color | color_modify: 'alpha', 0.1
    assign custom_color_fill = custom_color | color_to_rgb
    assign custom_class = 'custom-color-progress'
  endunless
-%}
<sht-progress-circular class="d-flex fd-column ta-center middle-xs w-100 gap-scale-xs {{ custom_class }} {{ class }}" style="--graph-color-background: {{ custom_color_background }}; --graph-color-fill: {{ custom_color_fill }};">
  <span class="progress-circular d-block p-relative o-hidden js-progress" data-progress="{{ percentage }}">
    <svg width="68" height="68" style="">
      <circle class="progress-circular-background" cx="34" cy="34" r="30"></circle>
      <circle class="progress-circular-value js-circular-progress" cx="34" cy="34" r="30" stroke-dasharray="188.47" stroke-dashoffset="188.47"></circle>
    </svg>
    <div class="p-absolute center-middle">{{ product_value }}/{{ maximum_value }}</div>
  </span>
  <span class="progress-content d-flex fs-body-m color-text gap-3xs">
    <p class="progress-label m-zero fw-500 flex-1">{{ label }}</p>
    {%- render 'icon-infor' | class: "progress-icon icon icon-fix-m" -%}
  </span>
</sht-progress-circular>
