
<div class="section__text {{ class | default: '' }} d-flex fw-wrap {{ alignment_class }}">
	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{%- when 'subheading' -%}
				<span class="subheading section__subheading promotional-subheading d-block hide-empty w-100" {{ block.shopify_attributes }}>{{- block.settings.subheading_text | escape -}}</span>
			{%- when 'heading' -%}
				{%- if block.settings.enable_h1_tag -%}
					<h1 class="section__heading promotional-heading {{ block.settings.heading_size }} hide-empty w-100" {{ block.shopify_attributes }}>{{- block.settings.heading_text | escape -}}</h1>
				{%- else -%}
					<h2 class="section__heading promotional-heading {{ block.settings.heading_size }} hide-empty w-100" {{ block.shopify_attributes }}>{{- block.settings.heading_text | escape -}}</h2>
				{%- endif -%}
			{%- when 'description' -%}
				<div class="section__description fs-body-xl rte hide-empty o-hidden {{ block.settings.truncate_text | replace: true, 'card__excerpt' }} w-100" {{ block.shopify_attributes }}>{{- block.settings.description_text -}}</div>
			{%- when 'button' -%}
				<div class="section__button-group d-flex gap-xs {{ alignment_class }} w-100" {{ block.shopify_attributes }}>
					{% if block.settings.button_primary_label != blank %}
						<a href="{{- block.settings.button_primary_link | default: '#' -}}" {{ block.settings.button_primary_link | default: 'tabindex="-1"' | replace: block.settings.button_primary_link , '' }} class="btn btn-m btn-{{- block.settings.button_primary_style }} hide-empty {{ block.settings.button_primary_link | default: 'disable' | replace: block.settings.button_primary_link , '' }}">{{- block.settings.button_primary_label | escape -}}</a>
					{% endif %}
					{% if block.settings.button_secondary_label != blank %}
						<a href="{{- block.settings.button_secondary_link | default: '#' -}}" {{ block.settings.button_secondary_link | default: 'tabindex="-1"' | replace: block.settings.button_secondary_link , '' }} class="btn btn-m btn-{{- block.settings.button_secondary_style }} hide-empty {{ block.settings.button_secondary_link | default: 'disable' | replace: block.settings.button_secondary_link , '' }}">{{- block.settings.button_secondary_label | escape -}}</a>
					{% endif %}
				</div> 
			{%- when 'text_block_with_icon' -%}
			{% assign alignment_class_text_icon = alignment_class | replace: ' start', ' top' | replace: ' center', ' middle' | replace: ' end', ' bottom'  %}
			{% assign text_block_with_icon = 'media-with-text-block-icon ' | append: block.settings.block_width_desktop | append: ' ' | append: block.settings.block_width_mobile | append: ' ' | append: alignment_class_text_icon%}
        {%- render 'card-icon-with-text',
          class: text_block_with_icon, 
          icon_color: block.settings.icon_color,
          theme_library_icon: block.settings.theme_library_icon,
          icon_source: block.settings.icon_source,
          icon_image: block.settings.icon_image,
          custom_code: block.settings.custom_code,
          icon_size: 'icon-scale-4xl',
          heading_size: block.settings.heading_size_text_icon,
          title: block.settings.title,
          description: block.settings.description
        -%}
			{%- when 'countdown_timer' -%}
				{% render 'countdown', block: block, alignment_class: alignment_class, class: 'section__countdown-timer w-100', countdown_type: 'regular' %}
		{%- endcase -%}
	{%- endfor -%}
</div>
