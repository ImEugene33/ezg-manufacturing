{% liquid
  assign enable_section_link = true
%}
<div class="section__text banner-content__animate {{ class | default: '' }} d-flex fd-column {{ alignment_class }}" style="{{ section_content_style }}">
	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{%- when 'subheading' -%}
				<span class="subheading section__subheading {{ subheading_type | default: 'promotional-subheading' }} d-block hide-empty" {{ block.shopify_attributes }} role="region" aria-labelledby="subheading-{{ section.id }}">{{- block.settings.subheading_text | escape -}}</span>
			{%- when 'heading' -%}
				{%- if block.settings.enable_h1_tag -%}
					<h1 class="section__heading {{ heading_type | default: 'promotional-heading' }} {{ block.settings.heading_size }} hide-empty" {{ block.shopify_attributes }} aria-labelledby="heading-{{ section.id }}">{{- block.settings.heading_text | escape -}}</h1>
				{%- else -%}
					<h2 class="section__heading {{ heading_type | default: 'promotional-heading' }} {{ block.settings.heading_size }} hide-empty" {{ block.shopify_attributes }} aria-labelledby="heading-{{ section.id }}">{{- block.settings.heading_text | escape -}}</h2>
				{%- endif -%}
			{%- when 'description' -%}
				<div class="section__description fs-body-xl rte hide-empty o-hidden {{ block.settings.truncate_text | replace: true, 'card__excerpt' }}" {{ block.shopify_attributes }} aria-label="description">{{- block.settings.description_text -}}</div>
			{%- when 'button' -%}
				{% assign enable_section_link = false %}
				<div class="section__button-group d-flex gap-xs {{ button_position_md }} {{ button_position_mb }} hide-empty" {{ block.shopify_attributes }} aria-label="button-group">
					{%- if block.settings.button_primary_label != blank -%}
						<a href="{{- block.settings.button_primary_link | default: '#' -}}" {{ block.settings.button_primary_link | default: 'tabindex="-1"' | replace: block.settings.button_primary_link , '' }} class="btn btn-m btn-{{- block.settings.button_primary_style }} hide-empty {{ block.settings.button_primary_link | default: 'disable' | replace: block.settings.button_primary_link , '' }}">{{- block.settings.button_primary_label | escape -}}</a>
					{%- endif -%}
					{% if block.settings.button_secondary_label != blank %}
						<a href="{{- block.settings.button_secondary_link | default: '#' -}}" {{ block.settings.button_secondary_link | default: 'tabindex="-1"' | replace: block.settings.button_secondary_link , '' }} class="btn btn-m btn-{{- block.settings.button_secondary_style }} hide-empty {{ block.settings.button_secondary_link | default: 'disable' | replace: block.settings.button_secondary_link , '' }}">{{- block.settings.button_secondary_label | escape -}}</a>
					{%- endif -%}
				</div>
			{%- when 'countdown_timer' -%}
				{% render 'countdown', block: block, class: 'section__countdown-timer', countdown_type: 'regular' %}
      {%- when 'custom_liquid' -%}
        <div class="section__custom-liquid hide-empty" {{ block.shopify_attributes }} role="region" aria-label="custom-liquid">
          {{- block.settings.custom_liquid_code -}}
        </div>
			{%- when 'newsletter_form' -%}
				<div class="section__newsletter-form" {{ block.shopify_attributes }} aria-label="newsletter-form">
					{%- render 'newsletter-form', 
						block: block, 
						alignment_class: alignment_class,
						button_label: block.settings.submit_button -%}
				</div>
      {%- when 'discount_code' -%}
        {%- if block.settings.code != blank -%}
          <sht-copy-clipboard class="section__discount-code d-flex fd-column {{ class }} w-100 mt-scale-xl" {{ block.shopify_attributes }} role="region" aria-label="discount-code">
						<div class="discount-code w-100 d-flex middle-xs">
							<div class="js-copy-text flex-1 fs-body-xl hide-empty" role="region" aria-label="discount-code-text">{{- block.settings.code -}}</div>
							<button type="button" class="js-copy-button btn btn-icon btn-icon-m btn-tertiary" aria-label="Copy to clipboard">
								{% render 'icon-copy', class: 'icon icon-fix-m' %}
							</button>
						</div>
						<div class="js-copy-success-message d-none middle-xs gap-3xs pt-3xs">
							<span class="fs-0 color-success">
								{% render "icon-check" | class: "icon d-block icon-fix-m" %}
							</span>
							<span class="fs-body-s color-text-80">
								{{ "general.status.copy_code_success" | t }}
							</span>
						</div>
						<div class="discount-help-text fs-body-s pt-3xs color-text-60 hide-empty" role="region" aria-label="discount-help-text">{{- block.settings.discount_help_text -}}</div>
          </sht-copy-clipboard>
					{%- endif -%}
        {%- when 'social_media' -%}
          {%- render 'socials', classes: social_media_position, class: menu_color -%}
		{%- endcase -%}
	{%- endfor -%}
</div>
{% if section.settings.image_banner_link != blank and enable_section_link %}
  <a href="{{- section.settings.image_banner_link -}}" class="p-absolute inset zi-2" aria-label="{{- block.settings.heading_text | escape -}}"></a>
{% endif %}
