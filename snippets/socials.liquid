{% liquid
  assign class = class | append: ' btn btn-icon-l btn-social '
%}
<ul class="{{ classes }} ls-none d-flex fw-wrap hide-empty" {{ block.shopify_attributes }} aria-label="social-media">
  {%- if settings.social_facebook_link != blank -%}
    <li>
      <a href="{{ settings.social_facebook_link }}" rel="noopener" title="Facebook" aria-label="Facebook" class="{{ class }}">
        {% render 'icon-facebook' %}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_twitter_link != blank -%}
    <li>
      <a href="{{ settings.social_twitter_link }}" rel="noopener" title="X-Twitter" aria-label="X-Twitter" class="{{ class }}">
