<script>
  var string = { qrImageAlt: {{ 'gift_cards.issued.qr_image_alt' | t | json }} };

  document.addEventListener('DOMContentLoaded', function() {
    new QRCode(document.querySelector('.gift-card__qr-code'), {
      text: document.querySelector('.gift-card__qr-code').dataset.identifier,
      width: 178,
      height: 178,
      imageAltText: string.qrImageAlt
    });
  });

  var template = document.getElementsByTagName("template")[0];
  var clonedTemplate = template.content.cloneNode(true);

  var isMessageDisplayed = false;

  // Add click event listener to the copy button
  document
    .querySelector('.js-gift-card-copy-btn')
    .addEventListener('click', (e) => {
      e.preventDefault();
      // Copy the gift card number to the clipboard
      navigator.clipboard.writeText(document.querySelector('.js-gift-card-number').value).then(function () {
        if (!isMessageDisplayed) {
          let success = document.querySelector('.gift-card__copy-success');
          success.classList.add('show');
          success.appendChild(clonedTemplate);
          isMessageDisplayed = true;
          // Hide the success message after 5 seconds
          setTimeout(function () {
            success.classList.remove('show');
            isMessageDisplayed = false;
          }, 5000);
        }
      });
    });
</script>
