          "settings": {
            "heading_text": "Crafted for Quality and Sustainability",
            "heading_size": "h3",
            "enable_h1_tag": false
          }
        },
        "description_khNwpk": {
          "type": "description",
          "settings": {
            "description_text": "<p>Sustainability is at the heart of everything we do. From the materials we choose to the packaging we use, every detail is designed with the planet in mind.</p><p>We prioritize responsibly sourced materials, work with ethical suppliers, and constantly seek ways to reduce waste in our processes. By creating durable, timeless pieces, we aim to minimize the need for replacements and promote a culture of mindful consumption.</p>"
          }
        }
      },
