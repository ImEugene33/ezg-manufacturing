            "icon_source": "theme_library",
            "theme_library_icon": "check",
            "custom_code": "",
            "title": "MASONRY",
            "description": "<p>In continuation with our belief that customers always come first, our equipment is designed for teams to learn best practices quickly. Every piece of masonry equipment is designed to increase efficiency, safety and profitability – something we like to refer to as LEAN Masonry®.</p>",
            "label": "Learn More",
