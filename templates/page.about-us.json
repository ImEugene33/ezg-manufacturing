          "settings": {
            "use_custom_color_scheme": true,
            "color_scheme": "",
            "icon_source": "theme_library",
            "theme_library_icon": "check",
            "custom_code": "",
            "title": "HARDSCAPE",
            "description": "<p>Providing contractors with innovative tools is at our core. From drafting to completion, our labor-saving line of hardscape equipment focuses on reducing the costs and time required to complete a job. </p>",
            "label": "Learn More",
            "link": "shopify://collections/hardscape"
          }
        },
        "icon_with_text_item_Bg4cxk": {
          "type": "icon_with_text_item",
          "settings": {
            "use_custom_color_scheme": true,
            "color_scheme": "",
            "icon_source": "theme_library",
            "theme_library_icon": "check",
            "custom_code": "",
            "title": "PRECAST",
            "description": "<p>The quality of EZG’s precast and refractory equipment is what sets us apart from competing manufacturers. We work closely with our customers and listen to their needs before streamlining our equipment to better serve you. This is why after nearly two decades of making model improvements our mixers and dispensers are second to none.</p><p></p>",
            "label": "Learn More",
            "link": "shopify://collections/precast-refractory"
          }
        },
        "icon_with_text_item_z4qV9N": {
