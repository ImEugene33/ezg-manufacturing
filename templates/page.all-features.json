        "text_tHPNXq": {
          "type": "text",
          "settings": {
            "heading": "Varied media promotion layouts",
            "enable_h1_tag": false,
            "heading_size": "h2",
            "description": "<p>We believe in investing in equipment with the highest quality. Our shop is outfitted with industry-leading machines to increase speed, accuracy, and cost efficiency. That includes Trumpf & Mazak Lasers, Mazak Milling Centers, CNC Lathes, Robotic Welding Cells, Press Brakes, Powder Coating Booths, CNC Rolls, and a Vertical Saw. From cutting to finishing, we handle 90–95% of the process in-house, giving you a quality product without unnecessary delays.</p>",
            "desktop_content_position": "center-md",
            "desktop_content_alignment": "ta-left-md top-md",
            "desktop_column": "2",
