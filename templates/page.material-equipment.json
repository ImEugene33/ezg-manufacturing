    "content_collage_FqhRtj": {
      "type": "content-collage",
      "blocks": {
        "text_LXNNQE": {
          "type": "text",
          "settings": {
            "heading": "Comprehensive Material Handling Solutions, Equipment, and Tools",
            "enable_h1_tag": false,
            "heading_size": "h3",
            "description": "<p>We understand that efficient material handling is at the core of many industries. That’s why we work with you to design and develop the best material handling solutions for your specific needs. Each system is built to exact specifications and tested to support reliable operation under constant use. Here’s how we stack up:</p><ul><li><strong>Custom Conveyor Systems: </strong>Rolling out innovative designs to handle various loads and streamline material movement across facilities.</li><li><strong>Precision Shafts and Components: </strong>Built to exact specifications to ensure smooth operation and minimal downtime.</li><li><strong>Custom Docks and Loading Solutions:</strong> Engineered to enhance logistics and simplify the transfer of goods.</li><li><strong>Ergonomic Lifting Tools:</strong> Improve workplace safety and reduce physical strain with our innovative lifting technologies.</li><li><strong>Bulk Material Transport Systems:</strong> Efficiently handle and move large volumes of materials with our durable and reliable transport systems.</li><li><strong>Custom-Designed Equipment:</strong> Leverage our expertise to develop equipment tailored to your unique operational challenges and specifications.</li><li><strong>Food-Grade Conveyor Belts</strong> that support hygiene protocols and industry standards in food processing</li></ul>",
            "desktop_content_position": "center-md",
            "desktop_content_alignment": "ta-left-md top-md",
            "desktop_column": "4",
            "desktop_row": "2",
