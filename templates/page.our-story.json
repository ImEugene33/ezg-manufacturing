        "text_pnXjQ3": {
          "type": "text",
          "settings": {
            "heading": "EZG Manufacturing",
            "enable_h1_tag": false,
            "heading_size": "h3",
            "description": "<p>EZ Grout’s reputation as an industry leader in the masonry, fencing and construction markets grew and soon products were found on construction sites across the globe. As Damian and his team learned more about each industry, they began to develop custom solutions for specific contracting problems. This led to the formation of EZG Manufacturing, which offers an extensive range of services, from laser cutting to machining, powder coat painting and more.</p>",
            "desktop_content_position": "start-md",
            "desktop_content_alignment": "ta-left-md top-md",
            "desktop_column": "2",
            "desktop_row": "2",
            "mobile_content_position": "center-xs",
            "mobile_content_alignment": "ta-left top-xs",
            "mobile_column": "1",
            "mobile_row": "2",
            "button_label": "",
