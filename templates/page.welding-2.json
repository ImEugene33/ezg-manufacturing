      "blocks": {
        "text_A8rRjy": {
          "type": "text",
          "settings": {
            "heading": "Benefits of the FANUC Robotic Welder",
            "enable_h1_tag": false,
            "heading_size": "h3",
            "description": "<p>Our robotic system leverages advanced technology to improve every step of the fabrication process. The FANUC 120iC offers a range of advantages that make it ideal for demanding production environments:</p><ul><li>Increased throughput with minimal operator intervention</li><li>Consistent, clean welds across every part in a production run</li><li>Access to difficult weld points via rotary positioning and robotic articulation</li><li>Decreased cycle time due to automation and twin-station design</li><li>Faster turnaround time for repeatable jobs, with reduced labor and part handling</li><li>Ideal for high-volume production, where the robotic welding process delivers repeatable results across thousands of identical parts</li><li>Cost savings through reduced labor, minimized waste, and shorter production schedules</li></ul>",
            "desktop_content_position": "center-md",
            "desktop_content_alignment": "ta-left-md top-md",
