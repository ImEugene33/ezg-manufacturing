    "faqs_jWzjpp": {
      "type": "faqs",
      "blocks": {
        "faq_item_XdCV7c": {
          "type": "faq_item",
          "settings": {
            "show_icon": true,
            "icon_source": "theme_library",
            "theme_library_icon": "layer-1",
            "custom_code": "",
            "icon_color": "",
            "heading_faq_item": "What is the Return & Exchange Policy?",
            "description_faq_item": "<p>Merchandise in perfect saleable condition with original receipt may be exchanged or returned for a full refund within thirty (30) days from the original purchase date except for custom or personalized items, which are final sale only. Returns or exchanges must include the original packaging and documentation. A refund of the original purchase price may only be made in the same form of payment as the original purchase. Please contact our customer service team for detailed return and exchange information.</p>"
          }
        },
        "faq_item_CQ6YmG": {
          "type": "faq_item",
          "settings": {
            "show_icon": true,
            "icon_source": "theme_library",
            "theme_library_icon": "truck",
            "custom_code": "",
            "icon_color": "",
            "heading_faq_item": "What shipping options are available?",
            "description_faq_item": "<p><strong>Standard Delivery</strong><br/>Available for most locations with delivery timing based on product availability and location.<br/><br/><strong>Express Delivery</strong><br/>Expedited delivery options available where service permits. Contact customer service for availability in your area.<br/><br/><strong>White Glove Service</strong><br/>Professional delivery and setup service available for larger furniture items. This service includes delivery to your desired room and basic assembly where applicable.<br/><br/><strong>Local Pickup</strong><br/>Available at select locations. You will receive notification when your order is ready for pickup.<br/><br/>For specific delivery options and timing in your area, please contact our customer service team.</p>"
          }
        },
        "faq_item_DUT87b": {
          "type": "faq_item",
          "settings": {
            "show_icon": true,
            "icon_source": "theme_library",
            "theme_library_icon": "apple-wallet",
            "custom_code": "",
            "icon_color": "",
            "heading_faq_item": "What are the accepted payment methods?",
            "description_faq_item": "<p>Payments are accepted via credit card, debit card, Apple Pay, or PayPal with a valid billing address and United States shipping address. Accepted credit cards are Visa, American Express, Discover, and Mastercard.<br/>When placing an order, your billing address must correspond to the address of your credit card, or we will not be able to process your order.</p>"
          }
        },
        "faq_item_LqLgn6": {
          "type": "faq_item",
          "settings": {
            "show_icon": true,
            "icon_source": "theme_library",
            "theme_library_icon": "puzzed",
            "custom_code": "",
            "icon_color": "",
            "heading_faq_item": "How do I return or exchange my online purchase?",
            "description_faq_item": "<p><strong>Returns & Exchanges</strong></p><p>Online purchases can be returned within our standard return timeframe.<br/><strong>Returns Process</strong></p><p>• Contact our customer service team to initiate a return<br/>• Prepare your item in its original packaging<br/>• Follow the return instructions provided by our team<br/><br/><strong>Exchanges</strong></p><p>• Contact customer service for exchange requests<br/>• In-store exchanges may be available at participating locations<br/><br/><strong>Return Policy</strong><br/>• Returns accepted within standard timeframe<br/>• Items must be in original condition<br/>• Original packaging and documentation required<br/>• Custom or personalized items may not be eligible for return<br/><br/>Please contact our customer service team for detailed return and exchange information.</p>"
          }
        },
        "faq_item_nAKmfj": {
          "type": "faq_item",
          "settings": {
            "show_icon": true,
            "icon_source": "theme_library",
            "theme_library_icon": "recycle",
            "custom_code": "",
            "icon_color": "",
            "heading_faq_item": "Where can I get a refill?",
            "description_faq_item": "<p>Dinnerware   Your dinnerware was crafted using the finest Limoges porcelain. To preserve its beauty for as long as possible, we recommend that you follow these guidelines:    Wash your dinnerware carefully before using it for the first time.   Porcelain products are dishwasher-safe when a low-temperature setting is selected and only the recommended amount of dishwasher detergent is used. Take care to ensure that the dishes will not knock against each other. It is also possible to clean the porcelain by hand with soapy warm water and a soft sponge. Take care to avoid using the abrasive side of the sponge, which might damage the surface of the decoration.<br/></p>"
          }
        }
      },
